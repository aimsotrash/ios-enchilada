+/*
+ * 0254: shutdown, restart and panic restart (SweetPlatformExpert's PE_halt_restart, before
+ * sweet_reboot_fastboot) and the root domain's restart/power-off notice. No lock is taken (a
+ * stuck SwapEnd may hold fMdpLock) and nothing waits for a frame (the MDP may be stopping):
+ * flips stop for good, the pool closes, ABL's registers are written again if a flip moved the
+ * pipe (the same plain stores as the panic hook, harmless when repeated), and the console is
+ * drawn again so the restart's own lines show on the panel. panic: no logging.
+ */
+extern "C" void
+sweet_fb_halt(int panic)
+{
+	bool away = sweet_mdp_away;
+	sweet_fb_paused |= 1;
+	sweet_scanout_size = 0;
+	sweet_mdp_boot_restore();
+	sweet_console_muted = 0;
+	if (!panic) {
+		IOLog("SWEET FB: halt: in-place scanout stopped, %s\n",
+		    away ? "ABL's registers written back (not waited for)" : "ABL's framebuffer was on the panel already");
+	}
+}
+
+/* Priority sleep/wake interest: restart/power-off as sweet_fb_halt; sleep pauses flips until wake. */
+static IOReturn
+sweet_fb_power_note(void *, void *, UInt32 type, IOService *, void *, vm_size_t)
+{
+	if (type == kIOMessageSystemWillRestart || type == kIOMessageSystemWillPowerOff) {
+		sweet_fb_halt(0);
+	} else if (type == kIOMessageSystemWillSleep) {
+		sweet_fb_paused |= 2;
+		sweet_mdp_boot_restore();
+		IOLog("SWEET FB: system sleep: in-place scanout paused, ABL's registers written back\n");
+	} else if (type == kIOMessageSystemHasPoweredOn) {
+		sweet_fb_paused &= ~2u;
+	}
+	return kIOReturnSuccess;        /* returnValue left 0: acknowledged, no time wanted */
+}
