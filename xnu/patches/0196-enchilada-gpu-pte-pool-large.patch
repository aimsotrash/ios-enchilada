+/* 0196: a pool table that lives in the cacheable aperture must reach memory: the SMMU walks uncached. */
+static void
+gpu_pte_clean(vm_offset_t va, unsigned len)
+{
+	if (gpu_pte_cached && va >= gpu_pte_pool && va + len <= gpu_pte_pool + 0x1000ull * gpu_pte_tables) {
+		flush_dcache64(gpu_pte_pool_pa + (va - gpu_pte_pool), len, 1);
+	}
+}
