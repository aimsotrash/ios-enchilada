+/* The aperture alias of [pa, end) in *base, or why there is none (0196: shared with the PTE pool). */
+static const char *
+gpu_aperture_check(uint64_t pa, uint64_t end, vm_offset_t *base)
+{
+	vm_size_t n = PAGE_SIZE;
+
+	*base = 0;
+	if (pa < gPhysBase || end > gPhysBase + gPhysSize) {
+		return "outside gPhysBase..+gPhysSize";     /* phystokv_range would panic */
+	}
+	vm_offset_t b = (vm_offset_t)phystokv_range(pa, &n);
+	for (uint64_t p = pa; p < end; p += PAGE_SIZE) {
+		vm_offset_t va;
+		uint64_t got;
+
+		n = PAGE_SIZE;
+		va = (vm_offset_t)phystokv_range(p, &n);
+		got = va == b + (p - pa) ? mmu_kvtop_wpreflight(va) : 0;
+		if (trunc_page(got) != trunc_page(p)) {
+			printf("SWEET GPU: aperture: pa %#llx -> va %#lx -> %#llx\n",
+			    (unsigned long long)p, (unsigned long)va, (unsigned long long)got);
+			return va == b + (p - pa) ? "page not mapped writable there" : "aperture not linear";
+		}
+	}
+	*base = b;
+	return NULL;
+}
