+ */
+void
+sweet_surface_gpu_wait(SweetSurface *s)
+{
+	if (s == NULL || !s->gpuDirty || gAdrenoLock == NULL) {
+		return;
+	}
+	IOLockLock(gAdrenoLock);
+	for (uint32_t ms = 0; sweet_gpu_ready() && !sweet_gpu_fence_done(s->gpuFence) && ms < SETTLE_PATIENCE_MS; ms++) {
+		IOLockUnlock(gAdrenoLock);
