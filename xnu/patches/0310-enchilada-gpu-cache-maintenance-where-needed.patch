+	uint32_t submits, waits;
+} gStat;
+
+/*
+ * 0310: cache maintenance only where the CPU can have written or will read. Boot 5x (2026-11-05
+ * 21:24, CoreAnimation animating at 21 swaps/s): backboardd's render thread spent ~4.5 ms of kernel
+ * time a frame, and eagl.c's "waiting" was 5.3 ms of a 6.9 ms frame of 8 draws and 16 triangles.
+ * SUBMIT cleaned every BO and in-place surface it named (the 11 MB display surface and Mesa's 12 MB
+ * render target each time), WAIT_FENCE cleaned and invalidated them again and the flip cleaned the
+ * display surface once more: ~50 MB of dc civac a frame. Now an arena BO is cleaned at SUBMIT only
+ * if the client has mapped it (its stores may be in the cache) or it was never cleaned (the
+ * allocator zeroes through a cacheable alias); after a wait only mapped BOs are invalidated, and a
+ * BO is invalidated when first mapped. An in-place surface is cleaned at SUBMIT when this import
+ * never cleaned it, its seed moved (a writer unlocked it), or SURF_AGE has passed since (writers
+ * that never lock: HakiOS's hakios.gpu.cpp keeps the same fallback); a scanout-pool surface (only
+ * the GPU draws CoreAnimation's display surfaces once imported) is cleaned once. WAIT_FENCE no longer
+ * settles surfaces: whoever reads one with the CPU settles it (IOSurface lock, panel copy,
+ * CPU_PREP, BO_SYNC). Boot-arg sweetgpuflush=1: everything at every SUBMIT and wait, as before;
+ * sweetgpuage=MS: the fallback age (default 50; 0 = every SUBMIT).
+ */
+static int gFlushAll = -1;
+static uint64_t gSurfAgeAbs;
+
+bool
+sweet_gpu_flush_all(void)
+{
+	if (gFlushAll < 0) {
+		uint32_t all = 0, age = 50;
+		(void)PE_parse_boot_argn("sweetgpuflush", &all, sizeof(all));
+		(void)PE_parse_boot_argn("sweetgpuage", &age, sizeof(age));
+		nanoseconds_to_absolutetime((uint64_t)age * NSEC_PER_MSEC, &gSurfAgeAbs);
+		gFlushAll = all != 0;
+		IOLog("SWEET GPU: cache maintenance %s (sweetgpuflush=%u, sweetgpuage=%u ms; 0310)\n",
+		    gFlushAll ? "of every BO and surface at every submit and wait" : "only of what the CPU wrote or will read",
+		    all, age);
+	}
+	return gFlushAll != 0;
+}
