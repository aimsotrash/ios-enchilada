+/* 0310 (gAdrenoLock held): whether SUBMIT must clean an in-place surface; notes the clean if so. */
+static bool
+surfNeedsClean(struct sweet_gem *g, uint64_t now)
+{
+	SweetSurface *s = g->surface;
+	uint32_t seed = sweet_surface_seed_value(s);
+	bool need = sweet_gpu_flush_all() || !g->cleaned || g->cpuMapped ||
+	    (s->scanoutPA == 0 && (seed != g->cleanSeed || now - g->cleanAt >= gSurfAgeAbs));
+
+	if (need) {
+		g->cleaned = true;
+		g->cleanSeed = seed;
+		g->cleanAt = now;
+	}
+	return need;
+}
+
+/* 0310: one line every 10 s (gAdrenoLock held). */
+static void
+statSay(void)
+{
+	uint64_t now = mach_absolute_time(), ten, ms, fus, wus, wmax;
+
+	nanoseconds_to_absolutetime(10ull * NSEC_PER_SEC, &ten);
+	if (gStat.since == 0 || now - gStat.since < ten) {
+		gStat.since = gStat.since == 0 ? now : gStat.since;
+		return;
+	}
+	absolutetime_to_nanoseconds(now - gStat.since, &ms);
+	absolutetime_to_nanoseconds(gStat.flushAbs, &fus);
+	absolutetime_to_nanoseconds(gStat.waits ? gStat.waitAbs / gStat.waits : 0, &wus);
+	absolutetime_to_nanoseconds(gStat.waitMax, &wmax);
+	IOLog("SWEET GPU: last %llu ms: %u submits; cache maintenance %llu MB in %llu us, %llu MB left alone (0310); "
+	    "%u fence waits, avg %llu us, max %llu us\n", ms / NSEC_PER_MSEC, gStat.submits, gStat.flushBytes >> 20,
+	    fus / 1000, gStat.skipBytes >> 20, gStat.waits, wus / 1000, wmax / 1000);
+	bzero(&gStat, sizeof(gStat));
+	gStat.since = now;
+}
