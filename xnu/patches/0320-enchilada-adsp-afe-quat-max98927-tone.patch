+/*
+ * 0320: the speaker amp, MAX98927 at 0x3a on QUP SE4 (i2c@890000, wrapper 0: enchilada dtbo entry 5,
+ * mainline sdm845-oneplus-enchilada.dts). SDA/SCL gpio89/90 in TLMM SOUTH, function qup4 = mux 2 on
+ * gpio89 and 3 on gpio90 (pinctrl-sdm845.c). GCC (gcc-sdm845.c): wrap0 m/s AHB bits 6/7, SE4 bit 14,
+ * CBCR 0x174f0, RCG 0x174f4; bits 8/9 are wrapper 0's core clocks as touch's 18/19 are wrapper 1's.
+ * Same FIFO engine and 100 kHz as the gauge; 16-bit register address, 8-bit data. Only sweet_adsp.c's
+ * thread calls it (adsp=5). 0 = ok, ENODEV = SE4 unusable this boot (already logged).
+ */
+#define AMP_SE_PA       0x00890000u
+#define AMP_GCC_CBCR    0x174f0u
+#define AMP_GCC_RCG     0x174f4u
+#define AMP_VOTE_MASK   ((1u << 6) | (1u << 7) | (1u << 8) | (1u << 9) | (1u << 14))
+#define AMP_ADDR        0x3au
+
+static struct touch_state amp = { .name = "AMP SE4" };
+static int amp_ready;
+
+static bool
+amp_open(void)
+{
+	vm_offset_t pins = ml_io_map(FJ_TLMM_SOUTH + TOUCH_GPIO_CFG(89), 0x2000);
+
+	amp.gcc = st.gcc ? st.gcc : bq.gcc ? bq.gcc : ml_io_map(FJ_GCC_PA, 0x60000);
+	amp.se = ml_io_map(AMP_SE_PA, 0x4000);
+	if (!pins || !amp.gcc || !amp.se) {
+		printf("SWEET AMP SE4: MMIO mapping failed\n");
+		return false;
+	}
+	vm_offset_t south = pins - TOUCH_GPIO_CFG(89);  /* touch_gpio_at() adds 0x1000 * pin */
+	for (unsigned pin = 89; pin <= 90; pin++) {
+		uint32_t cfg = touch_rd(south, TOUCH_GPIO_CFG(pin));
+		if (((cfg >> 2) & 0xfu) != pin - 87u) {
+			touch_gpio_at(south, pin, pin - 87u, 0, 0, false, false);      /* qup4, 2 mA, no bias */
+		}
+		printf("SWEET AMP SE4: gpio%u cfg %#x -> %#x\n", pin, cfg, touch_rd(south, TOUCH_GPIO_CFG(pin)));
+	}
+	return fajita_clocks(&amp, AMP_VOTE_MASK, AMP_GCC_CBCR, AMP_GCC_RCG) && touch_se_init(&amp);
+}
+
+int
+sweet_amp_reg(uint16_t reg, bool write, uint8_t *val)
+{
+	if (amp_ready == 0) {
+		amp_ready = amp_open() ? 1 : -1;
+	}
+	if (amp_ready < 0 || amp.dead) {
+		return ENODEV;
+	}
+	if (write) {
+		const uint8_t tx[3] = { (uint8_t)(reg >> 8), (uint8_t)reg, *val };
+		return geni_msg(&amp, AMP_ADDR, tx, 3u, NULL, 0, false);
+	}
+	return geni_read(&amp, AMP_ADDR, reg, true, val, 1u);
+}
