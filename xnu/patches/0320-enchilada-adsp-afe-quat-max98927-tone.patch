+/* ======================================================================================== */
+/*
+ * 0320, stages 4 and 5 (logs/audio/plan.md Steps 4-5 and §2): a tone from the speaker amp, no PCM.
+ *   4  TLMM gpio58-61 (NORTH: SCK, WS, SD0, SD1) to qua_mi2s = function 1 (pinctrl-sdm845.c), 8 mA,
+ *      no bias, 58/59 output-high (sdm845.dtsi quat_mi2s_*_active). APR to the AFE (svc 4), as q6afe.c:
+ *      QUAD_MI2S_IBIT 0x106 at 1.536 MHz (sdm845.c MI2S_BCLK_RATE; q6afe-dai: attribute COUPLE_NO,
+ *      root default) through AFE_SVC_CMD_SET_PARAM / AFE_MODULE_CLOCK_SET; AFE_PARAM_ID_I2S_CONFIG on
+ *      QUATERNARY_MI2S_RX 0x1006: 16 bit, SD1 (oneplus-common qcom,sd-lines <1>), stereo, 48 kHz, ws
+ *      internal (the CPU is bit and frame master), padded to sizeof(union afe_port_config) = 36 as
+ *      q6afe_port_start sends it; DEVICE_START. adsp=4 runs the port 2 s. Then always: DEVICE_STOP,
+ *      clock off (freq 0), the pins' old cfg back, ad_stop().
+ *   5  with the port running: MAX98927 (Linux max98927.c): reset gpio69 (EAST, active low) low 10 ms
+ *      then high (OnePlus vendor driver), REV_ID 0x1ff must read 0x40 (Linux register default), then
+ *      max98927_probe + set_fmt (I2S, slave, NB_NF) + hw_params (16 bit, 48 kHz, 32 BCLK per LRCLK) with
+ *      the gain at its lowest: digital volume 0 = -16 dB (TLV -1600 step 25), speaker gain 0x11 = +3 dB
+ *      PCM and PDM, the lowest step that is not mute (vendor: "000:mute 001:+3db"). IV feedback stays
+ *      hi-z (no TX port). adsp=5 leaves the amp disabled. adsp=5N (N 1..15): TONE_GEN_DC_CFG 0x38 = N,
+ *      SPK_SRC_SEL 0x3b = 2 ("tone", vendor speaker_source_text), AMP_EN, GLOBAL_EN, 1 s. N is a knob:
+ *      neither Linux nor the vendor driver gives the TONE_CONFIG encodings (datasheet only). Teardown
+ *      whenever the amp answered: GLOBAL_EN 0, AMP_EN 0, tone 0, source PCM, soft reset; gpio69 held low.
+ */
+#define APR_SVC_AFE             4u
+#define AFE_DEVICE_START        0x000100e5u
+#define AFE_DEVICE_STOP         0x000100e6u
+#define AFE_PORT_SET_PARAM_V2   0x000100efu
+#define AFE_SVC_SET_PARAM       0x000100f3u
+#define AFE_MODULE_DEV_IF       0x0001020cu     /* AFE_MODULE_AUDIO_DEV_INTERFACE */
+#define AFE_PARAM_I2S_CONFIG    0x0001020du
+#define AFE_MODULE_CLOCK_SET    0x0001028fu
+#define AFE_PARAM_CLOCK_SET     0x00010290u
+#define AFE_QUAT_MI2S_RX        0x1006u
+#define AFE_CLK_QUAD_MI2S_IBIT  0x106u
+#define AD_MI2S_BCLK            1536000u        /* 48000 x 16 bit x 2 */
+#define TLMM_NORTH              0x03900000ull
+#define TLMM_EAST               0x03500000ull
+#define GPIO_AMP_RESET          69u
+#define TLMM_CFG(mux, pull, drive, oe) (((mux) << 2) | (pull) | ((drive) << 6) | ((oe) ? 0x200u : 0u))
+
+/* one TLMM pin (cfg at tile + 0x1000 * pin: mux 5:2, drive 8:6, oe 9, pull 1:0; io at +4, bit 1 = out):
+ * the level first, then cfg's low 10 bits. Returns the old cfg | old io << 16, ~0 = not mapped. */
+static uint32_t
+ad_gpio(uint64_t tile, unsigned pin, uint32_t cfg, bool high)
+{
+	vm_offset_t va = io_map(tile + 0x1000ull * pin, 0x1000, AD_WIMG_IO, VM_PROT_READ | VM_PROT_WRITE, true);
+
+	if (!va) {
+		printf("SWEET ADSP: cannot map tlmm gpio%u\n", pin);
+		ad_bad = true;
+		return ~0u;
+	}
+	volatile uint32_t *r = (volatile uint32_t *)va;
+	uint32_t old_cfg = r[0], old_io = r[1];
+	r[1] = (old_io & ~2u) | (high ? 2u : 0u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	r[0] = (old_cfg & ~0x3ffu) | (cfg & 0x3ffu);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET ADSP: gpio%u cfg %#x io %#x -> cfg %#x io %#x\n", pin, old_cfg, old_io, r[0], r[1]);
+	ml_io_unmap(trunc_page(va), round_page(0x1000 + (va & PAGE_MASK)));     /* as 0317 */
+	return (old_cfg & 0xffffu) | (old_io << 16);
+}
+
+/* GLINK receive + the ADSP's health while a stage waits; false = fatal, glink error or refused access */
+static bool
+ad_pump(void)
+{
+	uint32_t sk = slave_kernel();
+
+	for (unsigned i = 0; i < 64 && gk.rx && gk_rx_one(); i++) {
+	}
+	if (sk == ~0u || (sk & SK_FATAL)) {
+		printf("SWEET ADSP: t=+%u ms slave-kernel %#x FATAL\n", ad_now(), sk);
+		crash_reason();
+		ad.running = false;     /* crashed: no stop request */
+		return false;
+	}
+	return !gk.bad && !ad_bad;
+}
+
+/* one AFE command and its APR_BASIC_RSP_RESULT (q6afe.c afe_apr_send_pkt, TIMEOUT_MS 1000) */
+static bool
+afe_cmd(const char *what, uint32_t opcode, const void *pl, uint32_t len)
+{
+	unsigned t0 = ad_now();
+	bool sent = false;
+
+	apr.rsp = false;
+	while (ad.running && ad_now() - t0 < 1000) {
+		if (!sent) {
+			sent = apr_send(APR_SVC_AFE, opcode, pl, len);
+		}
+		if (!ad_pump()) {
+			break;
+		}
+		if (apr.rsp && apr.rsp_op == opcode) {
+			printf("SWEET ADSP: afe %s (%#x): status %#x%s\n", what, opcode, apr.rsp_status,
+			    apr.rsp_status ? " FAILED" : " ok");
+			return apr.rsp_status == 0;
+		}
+		delay(1000);
+	}
+	printf("SWEET ADSP: afe %s (%#x): %s\n", what, opcode, !ad.running ? "adsp not running" :
+	    sent ? "no answer in 1 s" : "not sent");
+	return false;
+}
+
+static bool
+afe_clock(uint32_t hz)          /* struct afe_clk_set after afe_svc_cmd_set_param + param data */
+{
+	const uint32_t p[12] = { 12 + 20, 0, 0, 0, AFE_MODULE_CLOCK_SET, AFE_PARAM_CLOCK_SET, 20,
+		                 1, AFE_CLK_QUAD_MI2S_IBIT, hz, 1 /* COUPLE_NO | root 0 << 16 */, hz ? 1u : 0u };
+
+	return afe_cmd(hz ? "clock QUAD_MI2S_IBIT on" : "clock QUAD_MI2S_IBIT off", AFE_SVC_SET_PARAM, p,
+	           (uint32_t)sizeof(p));
+}
+
+static bool
+afe_port(uint32_t opcode, const char *what)
+{
+	const uint32_t p = AFE_QUAT_MI2S_RX;    /* port_id, reserved 0 */
+
+	return afe_cmd(what, opcode, &p, 4);
+}
+
+/* --- the amp, through sweet_amp_reg() --- */
+static const struct { uint16_t reg; uint8_t mask, val; } amp_init[] = {
+	{ 0x0100, 0xff, 0x01 },                         /* software reset (max98927_probe) */
+	{ 0x001c, 0xff, 0xff }, { 0x001d, 0xff, 0xff }, /* PCM TX hi-z: no IV slots */
+	{ 0x0025, 0xff, 0x80 }, { 0x0026, 0xff, 0x01 }, /* PCM to speaker monomix */
+	{ 0x0036, 0xff, 0x00 },                         /* digital volume -16 dB (Linux 0x38) */
+	{ 0x003c, 0xff, 0x11 },                         /* speaker gain +3 dB PCM and PDM (Linux 0x05) */
+	{ 0x0037, 0xff, 0x03 }, { 0x003f, 0xff, 0xf7 }, /* DC blockers */
+	{ 0x0040, 0xff, 0x1c }, { 0x0042, 0xff, 0x3e }, /* boost output voltage, current limit */
+	{ 0x0043, 0xff, 0x04 }, { 0x0044, 0xff, 0x00 }, { 0x0045, 0xff, 0x24 },        /* measurement ADC */
+	{ 0x007f, 0xff, 0x06 },                         /* brownout level */
+	{ 0x0082, 0xff, 0x08 }, { 0x0086, 0xff, 0x01 }, { 0x0087, 0xff, 0x10 },        /* envelope tracking */
+	{ 0x0021, 0x03, 0x00 },                         /* set_fmt: slave */
+	{ 0x0020, 0x3c, 0x00 },                         /* normal BCLK edge, I2S */
+	{ 0x0018, 0x03, 0x03 },                         /* PCM RX ch0 + ch1 */
+	{ 0x003b, 0x03, 0x00 }, { 0x0035, 0x01, 0x00 }, /* speaker source PCM, PDM RX off */
+	{ 0x0020, 0xc0, 0x40 },                         /* hw_params: 16-bit channels */
+	{ 0x0023, 0x0f, 0x08 }, { 0x0024, 0xff, 0x88 }, /* 48 kHz; IV ADC 48 kHz */
+	{ 0x0022, 0x0f, 0x02 },                         /* BSEL 32 BCLK per LRCLK */
+};
+
+static int
+amp_rd(uint16_t reg)
+{
+	uint8_t v = 0;
+	int e = sweet_amp_reg(reg, false, &v);
+
+	if (e) {
+		printf("SWEET AMP: read %#06x: error %d\n", reg, e);
+		return -1;
+	}
+	return v;
+}
+
+static bool
+amp_wr(uint16_t reg, uint8_t mask, uint8_t val)        /* mask 0xff: plain write */
+{
+	int old = mask == 0xff ? 0 : amp_rd(reg);
+	uint8_t v = (uint8_t)(((unsigned)old & ~(unsigned)mask) | (unsigned)val);
+	int e = old < 0 ? EIO : sweet_amp_reg(reg, true, &v);
+
+	if (e) {
+		printf("SWEET AMP: write %#06x = %#04x: error %d\n", reg, v, e);
+	}
+	return e == 0;
+}
+
+static const char *
+amp_stage(int mode)
+{
+	static const uint16_t show[] = { 0x0018, 0x0020, 0x0021, 0x0022, 0x0023, 0x0024, 0x0036, 0x003c };
+	uint32_t rst = TLMM_CFG(0u, 3u, 7u, true);     /* gpio, pull-up, 16 mA, out (speaker_default) */
+	unsigned tone = mode > 50 && mode <= 65 ? (unsigned)(mode - 50) : 0;
+	const char *why = NULL;
+	int id = -1;
+
+	printf("SWEET AMP: reset gpio69 low 10 ms, then high; REV_ID\n");
+	(void)ad_gpio(TLMM_EAST, GPIO_AMP_RESET, rst, false);
+	delay(10000);
+	(void)ad_gpio(TLMM_EAST, GPIO_AMP_RESET, rst, true);
+	delay(6000);
+	if (ad_bad) {
+		why = "tlmm gpio69";
+	} else if ((id = amp_rd(0x01ff)) < 0) {
+		why = "no answer at 0x3a on SE4";
+	} else {
+		printf("SWEET AMP: REV_ID %#04x%s\n", (unsigned)id, id == 0x40 ? "" : " (expected 0x40)");
+		why = id == 0x40 ? NULL : "unexpected REV_ID";
+	}
+	for (unsigned i = 0; !why && i < sizeof(amp_init) / sizeof(amp_init[0]); i++) {
+		why = amp_wr(amp_init[i].reg, amp_init[i].mask, amp_init[i].val) ? NULL : "init write";
+		if (i == 0) {
+			delay(10000);   /* after the software reset */
+		}
+	}
+	for (unsigned i = 0; !why && i < sizeof(show) / sizeof(show[0]); i++) {
+		printf("SWEET AMP: R%04x = %#04x\n", show[i], (unsigned)amp_rd(show[i]));
+	}
+	if (!why) {
+		printf("SWEET AMP: init ok: I2S slave, 16 bit, 48 kHz, volume -16 dB, gain +3 dB\n");
+	}
+	if (!why && !tone) {
+		printf("SWEET AMP: adsp=5: amp left disabled (adsp=5N plays the tone, N = TONE_CONFIG 1..15)\n");
+	} else if (!why) {
+		printf("SWEET AMP: tone: TONE_CONFIG %u, source tone, amp on for 1 s\n", tone);
+		if (!amp_wr(0x0038, 0x0f, (uint8_t)tone) || !amp_wr(0x003b, 0x03, 0x02) ||
+		    !amp_wr(0x003a, 0x01, 0x01) || !amp_wr(0x00ff, 0x01, 0x01)) {
+			why = "tone enable";
+		}
+		for (unsigned end = ad_now() + 1000; !why && ad_now() < end; delay(10000)) {
+			why = ad_pump() ? NULL : "adsp fatal or glink error during the tone";
+		}
+		if (!why) {
+			printf("SWEET AMP: tone done (state %#x, int raw %#x %#x %#x)\n", (unsigned)amp_rd(0x00ff),
+			    (unsigned)amp_rd(0x0001), (unsigned)amp_rd(0x0002), (unsigned)amp_rd(0x0003));
+		}
+	}
+	if (id >= 0) {                  /* max98927_dac_event POST_PMD, then a software reset */
+		(void)amp_wr(0x00ff, 0xff, 0x00);
+		(void)amp_wr(0x003a, 0xff, 0x00);
+		(void)amp_wr(0x0038, 0xff, 0x00);
+		(void)amp_wr(0x003b, 0xff, 0x00);
+		(void)amp_wr(0x0100, 0xff, 0x01);
+	}
+	(void)ad_gpio(TLMM_EAST, GPIO_AMP_RESET, rst, false);  /* held in reset (max98927_i2c_remove) */
+	printf("SWEET AMP: off: global/amp/tone 0, soft reset, reset gpio69 held low\n");
+	return why;
+}
+
+static int
+ad_stage45(int mode)
+{
+	static const unsigned quat_pin[4] = { 58, 59, 60, 61 };
+	uint32_t quat_old[4];
+	const uint32_t i2s[16] = { AFE_QUAT_MI2S_RX | (48u << 16), 0, 0, 0, AFE_MODULE_DEV_IF, AFE_PARAM_I2S_CONFIG, 36,
+		                   1, 16 | (2u << 16) /* bit width, AFE_PORT_I2S_SD1 */,
+		                   1 | (1u << 16) /* stereo, ws internal */, 48000, 0 /* linear PCM */ };
+	const char *why = NULL;
+	bool clk = false, started = false;
+	int reached = 3;
+
+	printf("SWEET ADSP: stage 4: tlmm gpio58-61 -> qua_mi2s, afe port %#x\n", AFE_QUAT_MI2S_RX);
+	for (unsigned i = 0; i < 4; i++) {
+		quat_old[i] = ad_gpio(TLMM_NORTH, quat_pin[i], TLMM_CFG(1u, 0u, 3u, i < 2), i < 2);
+	}
+	if (ad_bad) {
+		why = "tlmm gpio58-61";
+	} else if (!(clk = afe_clock(AD_MI2S_BCLK))) {
+		why = "afe clock set";
+	} else if (!afe_cmd("i2s config", AFE_PORT_SET_PARAM_V2, i2s, (uint32_t)sizeof(i2s))) {
+		why = "afe i2s config";
+	} else {
+		started = true;         /* a failed start is still followed by a stop */
+		why = afe_port(AFE_DEVICE_START, "device start") ? NULL : "afe device start";
+	}
+	if (!why) {
+		reached = 4;
+		printf("SWEET ADSP: stage 4: ok: QUATERNARY_MI2S_RX %#x started, bit clock %u Hz\n", AFE_QUAT_MI2S_RX,
+		    AD_MI2S_BCLK);
+		if (mode >= 5) {
+			why = amp_stage(mode);
+			reached = why ? 4 : 5;
+		} else {
+			for (unsigned end = ad_now() + 2000; !why && ad_now() < end; delay(10000)) {
+				why = ad_pump() ? NULL : "adsp fatal or glink error";
+			}
+		}
+	}
+	if (why) {
+		printf("SWEET ADSP: stage %d: FAILED: %s\n", reached + 1, why);
+	}
+	if (started) {
+		(void)afe_port(AFE_DEVICE_STOP, "device stop");
+	}
+	if (clk) {
+		(void)afe_clock(0);
+	}
+	for (unsigned i = 0; i < 4; i++) {
