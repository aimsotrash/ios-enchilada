+/* ======================================================================================== */
+/*
+ * 0281: stage 10 (mss=10): joining an open or WPA2-PSK (CCMP, AKM 00-0F-AC:2) network when wifid
+ * asks (sweet_wlan.c, APPLE80211 ASSOCIATE), and the en0 data path. As ath10k + mac80211 do it on
+ * WCN3990 TLV firmware (mac.c, wmi-tlv.c, htt_tx.c, htt_rx.c), ported from topaz 0129/0130:
+ *   SCAN_CHAN_LIST again with the AP's channel active (mac80211's beacon hint), STA_POWERSAVE off,
+ *   VDEV_START on the AP's channel -> VDEV_START_RESP, PEER_CREATE, open-system AUTH and
+ *   ASSOC_REQ as host MLME frames through WMI MGMT_TX_SEND (WMI_TLV_SERVICE_MGMT_TX_WMI),
+ *   PEER_ASSOC (legacy rates) + VDEV_UP; then the WPA2 4-way handshake in this kernel (EAPOL-Key
+ *   descriptor version 2: HMAC-SHA1-128 MIC, AES key wrap; PTK from PRF-SHA1; checks of the MIC,
+ *   the ANonce and the replay counter), message 4 sent in the clear and completed before
+ *   VDEV_INSTALL_KEY (pairwise CCMP, then the GTK) and PEER_SET_PARAM AUTHORIZE; group-key
+ *   rekeys (1/2 -> 2/2) while joined. Refused (fail closed): WPA1/TKIP-only, SAE/802.1X-only
+ *   and management-frame-protection-required networks.
+ *   Data: en0's Ethernet frames go out as native-wifi to-DS frames through HTT TX_FRM (64-bit
+ *   descriptors, the fragment bank 0267 configured, 50-byte prefetch, HTC bypassed as
+ *   ath10k_htt_tx_64 does); received MSDUs (RX_IN_ORD_PADDR_IND, rx_attention checked) become
+ *   Ethernet frames for ifnet_input. Frames sent with our own source address are dropped.
+ * Crypto: libkern's SHA-1 (BearSSL in this kernel, 0020/0023) and AES-128 decryption, with HMAC,
+ * PBKDF2, the 802.11 PRF and the RFC 3394 unwrap built on them; checked against the 802.11i and
+ * RFC 3394 test vectors before the first join. Neither passphrases nor keys are ever logged.
+ */
+#define WS_TX_SLOTS             64u
+#define WS_SLOT                 2048u
+#define WS_QLEN                 32u
+enum { WS_IDLE, WS_START, WS_AUTH, WS_ASSOC, WS_4WAY, WS_KEYS, WS_UP };
+static const char *const ws_names[] = { "idle", "vdev start", "auth", "assoc", "4-way", "keys", "joined" };
+
+static struct {
+	volatile int state;
+	bool open, start_resp, keyed;
+	int32_t start_status;
+	uint8_t ssid[32], ssid_len, bssid[6], pmk[32];
+	uint32_t freq, aid, tries, deadline, desc, msg1s, msg4_slot, join_ms;
+	uint8_t rsn_ie[22], group_cipher;
+	uint8_t assoc_req[512];
+	uint32_t assoc_req_len;
+	uint8_t ptk[48], anonce[32], snonce[32];
+	uint64_t replay;
+	uint8_t gtk[32], gtk_len, gtk_idx;
+	struct sweet_wlan_bss ap;               /* the network joined (wifid's queries) */
+	uint8_t *mgmt, *txp;
+	uint64_t mgmt_pa, txp_pa, busy;
+	unsigned sent, done, fail, drop, rx_up, dhcp_said;
+	int crypto;                             /* 0 untested, 1 ok, -1 failed */
+} ws;
+
+/* what sweet_wlan.c hands over (any thread) */
