+		case 2: {                       /* open system; WPA2-PSK when the network is private */
+			struct {
+				uint32_t version, lower, upper, extended;
+			} a = { .version = 1, .lower = 1, .upper = (b->capab & 0x10) ? 8 : 0 };
+			error = wl_give(r, &a, sizeof(a));
+			break;
+		}
+		}
+	}
+	kfree_data(b, sizeof(*b));
+	return error;
+}
+
+/* 0281: ASSOCIATE; answered at once, the outcome comes as APPLE80211_M_ASSOC_DONE */
+static int
+wl_join(const struct apple80211req *r)
+{
+	struct apple80211_assoc *a;
+	uint8_t pmk[32];
+	int error;
+
+	if (r->req_len < offsetof(struct apple80211_assoc, rest) || r->req_data == USER_ADDR_NULL) {
+		return EINVAL;
+	}
+	if ((a = kalloc_data(sizeof(*a), Z_WAITOK | Z_ZERO)) == NULL) {
+		return ENOMEM;
+	}
+	if ((error = copyin(r->req_data, a, offsetof(struct apple80211_assoc, rest))) == 0) {
+		/* lengths and kinds only: the name, the access point and the key stay out of the log */
+		printf("SWEET A80211: join asked: a name of %u bytes, %s access point, auth %#x/%#x, a key of %u bytes "
+		    "of kind %u\n", a->ssid_length, (a->bssid[0] | a->bssid[1] | a->bssid[2] | a->bssid[3] | a->bssid[4] |
+		    a->bssid[5]) ? "a given" : "any", a->auth_lower, a->auth_upper, a->key_length, a->key_cipher);
+		lck_mtx_lock(&wl_lock);
+		wl_join_result = 0;
+		lck_mtx_unlock(&wl_lock);
+		wl_leaving = false;
+		if (a->ssid_length == 0 || a->ssid_length > sizeof(a->ssid)) {
+			error = EINVAL;
+		} else if (a->key_length == 0) {
+			error = sweet_wlan_join(a->ssid, a->ssid_length, a->bssid, NULL);
+		} else if (!sweet_wlan_crypto_ok()) {
+			error = EIO;
+		} else if (a->key_cipher == 10 && a->key_length >= 8 && a->key_length <= 63) {
+			sweet_wlan_pmk(a->key, a->key_length, a->ssid, a->ssid_length, pmk);
+			error = sweet_wlan_join(a->ssid, a->ssid_length, a->bssid, pmk);
+		} else if (a->key_cipher == 6 && a->key_length == 32) {
+			error = sweet_wlan_join(a->ssid, a->ssid_length, a->bssid, a->key);
+		} else {
+			error = EINVAL;
+		}
+	}
+	bzero(pmk, sizeof(pmk));
+	bzero(a, sizeof(*a));
+	kfree_data(a, sizeof(*a));
+	return error;
+}
