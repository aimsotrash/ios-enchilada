+/* 0281: KEV_DL_LINK_ON/OFF, which configd waits for before DHCP (HakiOS net_link_event) */
+static void
+wl_link_event(uint32_t code)
+{
+	_Alignas(struct kern_event_msg) char message[sizeof(struct kern_event_msg) + sizeof(struct net_event_data)] = { 0 };
+	struct kern_event_msg *header = (struct kern_event_msg *)message;
+	struct net_event_data *about = (struct net_event_data *)(header + 1);
+
+	header->total_size = sizeof(message);
+	header->vendor_code = KEV_VENDOR_APPLE;
+	header->kev_class = KEV_NETWORK_CLASS;
+	header->kev_subclass = KEV_DL_SUBCLASS;
+	header->event_code = code;
+	about->if_family = ifnet_family(wl_ifp);
+	about->if_unit = ifnet_unit(wl_ifp);
+	strlcpy(about->if_name, ifnet_name(wl_ifp), IFNAMSIZ);
+	ifnet_event(wl_ifp, header);
+}
+
+void
+sweet_wlan_join_done(int status)
+{
+	uint32_t result = status == 0 ? 1 : status == EAUTH ? 21 : status == ETIMEDOUT ? 9 : 2;
+
+	lck_mtx_lock(&wl_lock);
+	wl_join_result = result;
+	lck_mtx_unlock(&wl_lock);
+	printf("SWEET A80211: join over (%d): ASSOCIATE_RESULT %u, ASSOC_DONE posted\n", status, result);
+	wl_post(EVENT_ASSOC_DONE, NULL, 0);
+}
+
+void
+sweet_wlan_link(bool up)
+{
+	struct apple80211_link_changed link = { .down = !up, .involuntary = !up && !wl_leaving,
+		                                .reason = !up && !wl_leaving ? 4 : 0 };
+	struct sweet_wlan_bss *b = kalloc_data(sizeof(*b), Z_WAITOK | Z_ZERO);
+
+	if (wl_ifp == NULL) {
+		if (b != NULL) {
+			kfree_data(b, sizeof(*b));
+		}
+		return;
+	}
+	if (b != NULL) {
+		link.rssi = up && sweet_wlan_station(b) == 4 ? b->rssi : 0;
+		kfree_data(b, sizeof(*b));
+	}
+	wl_link = up;
+	wl_link_event(up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF);
+	wl_post(EVENT_SSID_CHANGED, NULL, 0);
+	wl_post(EVENT_BSSID_CHANGED, NULL, 0);
+	wl_post(EVENT_LINK_CHANGED, &link, sizeof(link));
+	printf("SWEET WLAN: en0 link %s%s (in %llu dropped, out %llu dropped so far)\n", up ? "up" : "down",
+	    !up && !wl_leaving ? " (not asked)" : "", wl_in_dropped, wl_dropped);
+}
