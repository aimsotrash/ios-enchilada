+/* 0281: an Ethernet frame from the station (the modem thread), as an Ethernet driver hands it up */
+void
+sweet_wlan_input(const uint8_t *frame, size_t length)
+{
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = (uint32_t)length };
+	unsigned int chunks = 1;
+	mbuf_t pkt = NULL;
+	char *hdr;
+
+	if (wl_ifp == NULL || !wl_link || length < ETHER_HDR_LEN || length > ETHER_MAX_LEN - ETHER_CRC_LEN ||
+	    mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &pkt) != 0) {
+		wl_in_dropped++;
+		return;
+	}
+	if (mbuf_copyback(pkt, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(pkt);
+		wl_in_dropped++;
+		return;
+	}
+	hdr = mbuf_data(pkt);
+	mbuf_pkthdr_setrcvif(pkt, wl_ifp);
+	mbuf_pkthdr_setheader(pkt, hdr);
+	mbuf_pkthdr_adjustlen(pkt, -ETHER_HDR_LEN);
+	mbuf_setdata(pkt, hdr + ETHER_HDR_LEN, length - ETHER_HDR_LEN);
+	ifnet_input(wl_ifp, pkt, &stats);
+}
