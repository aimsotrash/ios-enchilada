+	/*
+	 * OnePlus 6: the USB master reaches DDR through apps SMMU SID 0x740 (DT
+	 * qcom,smmu-s1-bypass), set up by ABL for its own buffer at 0x997a6000.
+	 * Our buffer above 4 GiB sent the SoC into crash-dump mode as soon as the
+	 * core started writing events to it (0190 boot). sweetusblowdma=1 (default)
+	 * runs the DMA area from 0x997a6000 (ABL's event buffer), DDR that XNU does
+	 * not use; write-combined, so ordinary loads/stores and memcpy are fine.
+	 */
+	int lowdma = 1;
+	PE_parse_boot_argn("sweetusblowdma", &lowdma, sizeof(lowdma));
+	if (lowdma) {
+		ud.dma_pa = 0x997a6000ULL;	/* the event buffer lands exactly on ABL's */
+		ud.dma = ml_io_map_wcomb((vm_offset_t)ud.dma_pa, UD_SIZE);
+		if (ud.dma == 0) {
+			printf("SWEET USB: cannot map the low DMA area\n");
+			return;
+		}
+		bzero((void *)ud.dma, UD_SIZE);
+		ud_lowdma = 1;
+	} else {
+		if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET USB: no DMA memory\n");
+			return;
+		}
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)ud.dma);
+		if (!pn) {
+			return;
+		}
+		ud.dma_pa = ptoa_64(pn);
 	}
