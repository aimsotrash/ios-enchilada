enchilada: USB device mode feeds the UTMI clock to the pipe domain

On SDM845 the DT limits the DWC3 to high speed and the USB3 PHY is not running
after ABL, so endpoint commands timed out ("ep0 cmd 0x1 timeout") and the
CDC-ECM link never came up. Select the UTMI clock as the pipe clock first, the
sequence of Linux dwc3_qcom_select_utmi_clk().

--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -172,6 +172,10 @@
 #define   UTMI_OTG_VBUS_VALID   (1u << 20)
 #define   SW_SESSVLD_SEL        (1u << 28)
 #define QSCRATCH_SS_PHY_CTRL    0x30
+#define QSCRATCH_GENERAL_CFG    0x08
+#define   PIPE_UTMI_CLK_SEL     (1u << 0)
+#define   PIPE3_PHYSTATUS_SW    (1u << 3)
+#define   PIPE_UTMI_CLK_DIS     (1u << 8)
 #define   LANE0_PWR_PRESENT     (1u << 24)
 
 #define DCTL_RUN_STOP   (1u << 31)
@@ -878,6 +882,27 @@
 		return;
 	}
 
+	/*
+	 * SDM845 (OnePlus 6/6T): the DT caps the core at high speed and the USB3
+	 * PHY is not running after ABL, so the core's pipe-clock domain has no
+	 * clock and endpoint commands time out ("ep0 cmd 0x1 timeout"). Feed it
+	 * the UTMI clock, as Linux dwc3-qcom does (dwc3_qcom_select_utmi_clk).
+	 */
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+	if (qs != 0) {
+		volatile uint32_t *gcfg = (volatile uint32_t *)(qs + QSCRATCH_GENERAL_CFG);
+		uint32_t before = *gcfg;
+		*gcfg = before | PIPE_UTMI_CLK_DIS;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		delay(1000);
+		*gcfg = *gcfg | PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		delay(1000);
+		*gcfg = *gcfg & ~PIPE_UTMI_CLK_DIS;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("SWEET USB: GENERAL_CFG 0x%08x -> 0x%08x (UTMI clock as pipe clock)\n", before, *gcfg);
+	}
+
 	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
 	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
 	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
@@ -902,7 +927,6 @@
 	dwc_wr(DALEPENA, 0x3);
 	ud_start_setup();
 
-	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
 	if (qs != 0) {
 		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
 		printf("SWEET USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x GENERAL_CFG 0x%08x\n",
