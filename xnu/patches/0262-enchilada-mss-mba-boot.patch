+ * partition, size, crc32. A file that does not match is refused; nothing is ever written there. */
+static const struct mss_fw { const char *name; uint32_t off, size, crc; } mss_fw[] = {
+	{ "mba.mbn", 0x5df9000, 0x3b2e0, 0x299b7d42 },
