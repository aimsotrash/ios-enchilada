+/* ======================================================================================== */
+/*
+ * 0262: the boot stages (mss=2..5). Sources, all Linux v6.12 unless noted:
+ *   drivers/remoteproc/qcom_q6v5_mss.c  sdm845_mss (has_alt_reset, no spare/qaccept/ext regs),
+ *       q6v5_load, q6v5_mba_load, q6v5proc_reset (MSS_SDM845), q6v5_mpss_init_image,
+ *       q6v5_mpss_load, q6v5_start, q6v5_stop, q6v5_mba_reclaim, q6v5proc_halt_axi_port,
+ *       q6v5_reset_assert/deassert, q6v5_xfer_mem_ownership
+ *   drivers/remoteproc/qcom_q6v5.c      load_state "modem" via QMP, ready/fatal/handover/stop-ack
+ *       = bits 1/0/2/3 of the modem's SMP2P "slave-kernel", stop = bit 0 of "master-kernel"
+ *   drivers/firmware/qcom/qcom_scm*.c   assign_mem (SVC_MP 0xc, cmd 0x16, 7 args, x5 = ext args),
+ *       the A6 resume quirk, IS_CALL_AVAIL
+ *   drivers/soc/qcom/qcom_aoss.c        qmp_open, qmp_send;  smem.c qcom_smem_alloc_private;
+ *       smp2p.c qcom_smp2p_alloc_outbound_item;  hwspinlock/qcom_hwspinlock.c (tcsr-mutex 0x1000)
+ *   drivers/reset/reset-qcom-aoss.c (MSS_RESTART 0x10000, 200-300 us), reset-qcom-pdc.c (0x100 bit 9)
+ *   drivers/clk/qcom/gcc-sdm845.c       the seven mss_pil clocks
+ *   arch/arm64/boot/dts/qcom/sdm845.dtsi mss_pil, smp2p-mpss, aoss_qmp, tcsr_regs_1 halt 0x3000/
+ *       0x5000/0x4000, smem hwlock 3; the phone's enchilada2.dtb for the MBA region (0x96600000;
+ *       mainline says 0x96500000), halt_q6/modem/nc, restart_reg, pdc_sync, alt_reset.
+ * Deliberate differences: no XO proxy vote (the apps CPU runs from XO for every stage); the CX and
+ * MX votes are not dropped by the stop path (the apps DRV's earlier vote is unknown: ABL may hold
+ * one for UFS/display); proxy votes are kept after handover; MPSS memory is returned to HLOS only
+ * if the Q6 never ran (as Linux, which reclaims it only while the MBA runs).
+ */
+extern int sweet_ufs_read_part(unsigned lun, const char *name, uint64_t off, void *dst, uint32_t len);
+extern int sweet_rpmh_arc_vote(const char *res, int corner, unsigned *sent);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern kern_return_t thread_terminate(thread_t);
+
+#define MSS_LUN         4u              /* /dev/block/sde4 = modem_a (sha256 887f8deb... = the table) */
+#define MSS_PART        "modem_a"
+#define MBA_PA          0x96600000ull   /* enchilada2.dtb pil_mba_mem */
+#define MBA_SIZE        0x200000u
+#define MPSS_PA         0x8e000000ull
+#define MPSS_SIZE       0x7800000u
+#define SCR_PA          0xa1000000ull   /* plain RAM in sdm845.dtsi's mdata alloc-ranges */
+#define SCR_SIZE        0x80000u        /* = one big window; only the first 16 KiB are used */
+#define META_PA         (SCR_PA + 0x1000)
+#define META_MAX        0x3000u
+#define MSS_BIGWIN      0x80000u        /* 512 KiB WC windows (kernel_map placed 1 MiB, not more) */
+
+#define QDSP6SS_PA      0x04080000ull
+#define RMB_PA          0x04180000ull
+#define TCSR_MUTEX3     0x01f43000ull   /* tcsr_mutex 0x1f40000, lock 3, stride 0x1000 */
+#define HALT_Q6         0x01f63000ull
+#define HALT_NC         0x01f64000ull
+#define HALT_MODEM      0x01f65000ull
+#define AOSS_MSS_RST    0x0c2b0000ull
+#define PDC_SYNC_RST    0x0b2e0100ull
+#define QMP_PA          0x0c300000ull
+#define APCS_IPC        0x1799000cull   /* apss_shared + 0xc: bit 0 AOP/QMP, bit 14 modem SMP2P */
+
+#define RMB_MBA_IMAGE   0x00
+#define RMB_PBL_STATUS  0x04
+#define RMB_MBA_COMMAND 0x08
+#define RMB_MBA_STATUS  0x0c
+#define RMB_PMI_META    0x10
+#define RMB_PMI_START   0x14
+#define RMB_PMI_LENGTH  0x18
+#define RMB_MSS_STATUS  0x40
+#define RMB_ALT_RESET   0x44
+
+#define VMID_HLOS       3u
+#define VMID_MSS_MSA    15u
+#define PERM_HLOS       (1u << VMID_HLOS)
+#define PERM_MSS        (1u << VMID_MSS_MSA)
+
+#define SMP2P_OUT_ITEM  428
+#define SMP2P_IN_ITEM   435
+#define SMP2P_BYTES     340u            /* sizeof(struct smp2p_smem_item), 16 entries */
+#define SK_FATAL        (1u << 0)
+#define SK_READY        (1u << 1)
+#define SK_HANDOVER     (1u << 2)
+#define SK_STOP_ACK     (1u << 3)
+#define MSS_WATCH_S     60u
