+/* One aligned 32-bit load through the window; false = not allowed/unmapped. */
+static bool
+mss_rd(uint64_t pa, uint32_t *v)
+{
+	vm_offset_t va;
+
+	*v = 0;
+	if ((pa & 3) || !mss_allowed(pa)) {
+		printf("SWEET MSS: refused read of %#llx\n", pa);
+		return false;
+	}
+	if ((va = mss_window(pa, false)) == 0) {
