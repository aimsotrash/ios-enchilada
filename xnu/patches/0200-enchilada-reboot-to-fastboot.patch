+
+/*
+ * Reboot into fastboot instead of Android (patch 0200). The stock SDM845 ABL takes the
+ * reboot reason from the PMIC: PON SOFT_RB_SPARE (PM8998 SID 0, 0x800 + 0x8f), reason in
+ * bits 7:1, 0x02 = bootloader (Linux qcom-pon "qcom,pm8998-pon" + pm8998.dtsi
+ * mode-bootloader = <0x2>; downstream qpnp_pon_set_restart_reason(PON_RESTART_REASON_
+ * BOOTLOADER)). Downstream msm-poweroff also stores 0x77665500 in IMEM restart_reason
+ * (0x146bf65c, enchilada DT); written too, but alone it does not work: the shim's
+ * IMEM + PSCI reset landed in Android. The reset is PSCI SYSTEM_RESET, as in the shim and
+ * mainline. Reset only when the spare register reads back as bootloader: an unmarked reset
+ * boots Android from boot_a, which would reformat userdata.
+ *
+ * The write follows spmi-pmic-arb.c v5: RW channel chnls + 0x10000 * APID, WDATA0 then
+ * EXT_WRITEL (opcode 0, BC 0), allowed only when the APID's owner is EE 0 (the apps EE,
+ * DT qcom,ee = <0>), as Linux checks. Reads use the observer channel like the rest of the
+ * file; the keys thread polls PON on that same channel, so it is held first.
+ *
+ *   rbfb=0   kernel reboots do what they did before (nothing)
+ *   pfb=N    after a panic, keep the screen N s (default 60), then reset; pfb=0 = forever
+ */
+#include <pexpert/pexpert.h>
+
+#define SP_CHNLS_PA     0x0c600000u
+#define RB_PON_PPID     0x008u
+#define RB_PON_SUBTYPE  0x05u           /* 0x04 = GEN2_PRIMARY (pm8941-pwrkey.c): reason shift 1 */
+#define RB_SPARE        0x8fu           /* PON_SOFT_RB_SPARE */
+#define RB_BOOTLOADER   (0x02u << 1)
+#define RB_IMEM_PA      0x146bf000u
+#define RB_IMEM_REASON  0x65cu
+#define RB_IMEM_FB      0x77665500u
+
+extern volatile int sweet_keys_hold;
+
+static vm_offset_t rb_chan, rb_obs, rb_imem;
+static uint32_t rb_on = 1, rb_panic_s = 60;
+static int rb_panicking;
+
+/* One command on one channel, spinning (also used in panic context: no lock, no block). */
+static int
+rb_xfer(vm_offset_t chan, uint32_t cmd, uint8_t *data)
+{
+	if ((cmd >> 27) == 0) {
+		*(volatile uint32_t *)(chan + 0x10u) = *data;  /* WDATA0 */
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)chan = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(chan, 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				return -1;
+			}
+			if (cmd >> 27) {
+				*data = (uint8_t)sp_rd(chan, 0x18u);
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+static int
+rb_read(unsigned reg, uint8_t *out)
+{
+	return rb_xfer(rb_obs, (1u << 27) | (reg << 4), out);          /* EXT_READL */
+}
+
+/* Thread context, after sweet_spmi_init(). */
+void
+sweet_reboot_init(void)
+{
+	uint8_t subtype = 0, spare = 0;
+	uint32_t imem = 0;
+	unsigned apid = SP_NO_APID, owner = 7;
+
+	(void)PE_parse_boot_argn("rbfb", &rb_on, sizeof(rb_on));
+	(void)PE_parse_boot_argn("pfb", &rb_panic_s, sizeof(rb_panic_s));
+	rb_imem = ml_io_map(RB_IMEM_PA, 0x1000);
+	if (rb_imem) {
+		imem = *(volatile uint32_t *)(rb_imem + RB_IMEM_REASON);
+	}
+	if (sp_ready) {
+		apid = sp_find_apid(RB_PON_PPID);
+	}
+	if (apid != SP_NO_APID) {
+		owner = sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u;
+		rb_obs = sp_obs + 0x80u * apid;
+		sweet_keys_hold = 1;
+		delay(50 * 1000);
+		if (rb_read(RB_PON_SUBTYPE, &subtype) != 0 || rb_read(RB_SPARE, &spare) != 0) {
+			subtype = 0;
+		}
+		sweet_keys_hold = 0;
+		if (owner == 0 && subtype == 0x04) {
+			rb_chan = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
+		}
+	}
+	printf("SWEET RB: boot with pon spare %#x (reason %u, 2 = fastboot), imem %#x; pon apid %u owner %u "
+	    "subtype %#x; reboot -> %s, panic -> %s after %u s\n", spare, (unsigned)(spare >> 1), imem, apid, owner, subtype,
+	    rb_chan && rb_on ? "fastboot" : "nothing", rb_chan && rb_panic_s ? "fastboot" : "nothing", rb_panic_s);
+}
+
+/* Returns only when no reset was made (the caller keeps its old behaviour). */
+int
+sweet_reboot_fastboot(int panic)
+{
+	uint8_t spare = 0, back = 0;
+	uint32_t imem = 0;
+
+	if (panic) {
+		if (__atomic_exchange_n(&rb_panicking, 1, __ATOMIC_SEQ_CST) || rb_chan == 0 || rb_panic_s == 0) {
+			return -1;
+		}
+		(void)ml_set_interrupts_enabled(FALSE);        /* delay() then spins, never blocks */
+		printf("SWEET RB: panic -> fastboot in %u s (boot-arg pfb=0 keeps this screen)\n", rb_panic_s);
+		for (uint32_t s = 0; s < rb_panic_s; s++) {
+			delay(1000 * 1000);
+		}
+	} else if (rb_panicking || rb_chan == 0 || rb_on == 0) {
+		return -1;
+	}
+	sweet_keys_hold = 1;
+	delay(50 * 1000);
+	if (rb_read(RB_SPARE, &spare) != 0) {
+		printf("SWEET RB: cannot read pon spare, no reset\n");
+		sweet_keys_hold = 0;
+		return -1;
+	}
+	uint8_t want = (uint8_t)((spare & 1u) | RB_BOOTLOADER);
+	if (rb_xfer(rb_chan, RB_SPARE << 4, &want) != 0 || rb_read(RB_SPARE, &back) != 0 ||
+	    (back & 0xfeu) != RB_BOOTLOADER) {
+		printf("SWEET RB: pon spare %#x -> %#x failed (reads %#x), no reset\n", spare, want, back);
+		sweet_keys_hold = 0;
+		return -1;
+	}
+	if (rb_imem) {
+		*(volatile uint32_t *)(rb_imem + RB_IMEM_REASON) = RB_IMEM_FB;
+		__asm__ volatile("dsb sy" ::: "memory");
+		imem = *(volatile uint32_t *)(rb_imem + RB_IMEM_REASON);
+	}
+	printf("SWEET RB: restart -> fastboot (pon spare %#x, imem %#x)\n", back, imem);
+	delay(100 * 1000);
+
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL;       /* PSCI SYSTEM_RESET */
+	__asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9",
+	    "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	printf("SWEET RB: PSCI SYSTEM_RESET returned %d\n", (int)x0);
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
