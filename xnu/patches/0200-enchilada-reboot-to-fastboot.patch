+extern "C" void sweet_reboot_init(void);
+extern "C" int sweet_reboot_fastboot(int panic);
+
+/*
+ * Kernel restarts (reboot, launchctl reboot, PEHaltRestart) and panic restarts go to fastboot
+ * (bsd/dev/sweet_spmi.c). Other types return -1, as with no PE_halt_restart at all.
+ */
+static int
+sweet_halt_restart(unsigned int type)
+{
+	if (type == kPERestartCPU || type == kPEPanicRestartCPU) {
+		return sweet_reboot_fastboot(type == kPEPanicRestartCPU);
+	}
+	return -1;
+}
 
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
