enchilada: read-only dump of the apps SMMU entries for the USB stream

Every USB DMA so far (0191 too, at ABL's own buffer address) sent the SoC into
crash-dump mode right after the first endpoint command, so the USB stream
(SID 0x740, apps SMMU at 0x15000000, qcom,skip-init) is the suspect.
sweetusbsmmu=1 prints sCR0/IDR0/IDR1 and every SMR that matches 0x740 with its
S2CR type and CBAR. Global register pages only, read only.

--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -74,6 +74,50 @@
 	return v;
 }
 
+/*
+ * boot-arg sweetusbsmmu=1: read-only dump of the apps SMMU (qcom,qsmmu-v500 at
+ * 0x15000000, DT qcom,skip-init) entries that match the USB stream ID 0x740.
+ * Any USB DMA so far sent the SoC into crash-dump mode, even at ABL's own
+ * buffer address; this shows what the SMMU does with that stream (translate,
+ * bypass or fault) now that ABL is gone. Only the global register pages are
+ * read (the registers Linux arm-smmu reads at probe), nothing is written.
+ */
+#define APPS_SMMU_PA            0x15000000
+#define USB_SID                 0x740
+static void
+sweet_usb_smmu_dump(void)
+{
+	vm_offset_t g = ml_io_map(APPS_SMMU_PA, 0x2000);
+	if (g == 0) {
+		return;
+	}
+	uint32_t scr0 = usb_rd(g, 0x000), idr0 = usb_rd(g, 0x020), idr1 = usb_rd(g, 0x024);
+	unsigned nsmr = idr0 & 0xff, ncb = idr1 & 0xff;
+	bool page64k = (idr1 >> 31) & 1;
+	printf("SWEET SMMU: apps sCR0 0x%08x (CLIENTPD %u USFCFG %u) IDR0 0x%08x IDR1 0x%08x: %u SMRs, %u CBs, %s pages\n",
+	    scr0, scr0 & 1, (scr0 >> 10) & 1, idr0, idr1, nsmr, ncb, page64k ? "64K" : "4K");
+	unsigned valid = 0, hits = 0;
+	for (unsigned n = 0; n < nsmr && n < 256; n++) {
+		uint32_t smr = usb_rd(g, 0x800 + 4 * n);
+		if (!(smr & (1u << 31))) {
+			continue;
+		}
+		valid++;
+		uint32_t id = smr & 0x7fff, mask = (smr >> 16) & 0x7fff;
+		if (((USB_SID ^ id) & ~mask & 0x7fff) != 0) {
+			continue;
+		}
+		hits++;
+		uint32_t s2cr = usb_rd(g, 0xc00 + 4 * n);
+		unsigned type = (s2cr >> 16) & 3, cb = s2cr & 0xff;
+		uint32_t cbar = (!page64k && cb < ncb) ? usb_rd(g, 0x1000 + 4 * cb) : 0;
+		printf("SWEET SMMU: SMR%u 0x%08x (id 0x%x mask 0x%x) S2CR 0x%08x type %s cb %u CBAR 0x%08x\n",
+		    n, smr, id, mask, s2cr, type == 0 ? "translate" : type == 1 ? "bypass" : type == 2 ? "FAULT" : "?", cb, cbar);
+	}
+	printf("SWEET SMMU: %u valid SMRs, %u match USB SID 0x%x%s\n", valid, hits, USB_SID,
+	    hits ? "" : " - unmatched streams follow sCR0.USFCFG");
+}
+
 void
 sweet_usb_probe(void)
 {
@@ -83,6 +127,10 @@
 
 	/* sweetusb=0 off, 1 (default) report state only, 2 also start the USB device */
 	PE_parse_boot_argn("sweetusb", &enabled, sizeof(enabled));
+	int smmudump = 0;
+	if (PE_parse_boot_argn("sweetusbsmmu", &smmudump, sizeof(smmudump)) && smmudump) {
+		sweet_usb_smmu_dump();
+	}
 	if (!enabled) {
 		return;
 	}
