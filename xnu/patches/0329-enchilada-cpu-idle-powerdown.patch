+#if defined(SWEET)
+#include <kern/clock.h>
+#include <kern/misc_protos.h>
+#include <pexpert/pexpert.h>
+
+/*
+ * 0329: boot-arg sweetidle=1 (=2: rail power-down). Idle CPUs 1-7 power their core down with PSCI
+ * CPU_SUSPEND instead of WFI when their next timer is at least sweetidle_us (default 2000) away.
+ * sdm845.dtsi (v5.4) idle-states: little/big "power-down" 0x40000003, "rail-power-down"
+ * 0x40000004, all local-timer-stop: the core's CNTV comparator and GIC CPU interface are lost.
+ * The core comes back through sweet_secondary_entry -> reset_vector -> resume_idle_cpu (the
+ * cpu_reset_handler cpu_machine_idle_init set) -> arm_init_idle_cpu -> sweet_idle_resume().
+ * Timer deadlines of powered-down CPUs go to the memory-mapped timer (timer@17c90000 frame 0,
+ * CNTP, GIC SPI 7: Linux's broadcast "arch_mem_timer") routed to cpu0, which never powers down
+ * and IPIs each sleeper 1 ms before its deadline; the sleeper waits out the rest in WFI.
+ * Without the boot-arg nothing changes.
+ */
+#define SWEET_IDLE_CTL_PA       0x17c90000ULL   /* CNTCTLBase */
+#define SWEET_IDLE_FRAME_PA     0x17ca0000ULL   /* frame 0 CNTBase */
+#define SWEET_IDLE_EARLY_US     1000            /* > the 621 us worst exit latency (big) */
+
+extern void sweet_secondary_entry(void);        /* start.s */
+
+static uint32_t sweet_idle_state;               /* PSCI power_state; 0: WFI only */
+static uint64_t sweet_idle_min_abs, sweet_idle_early_abs, sweet_idle_entry_pa;
+static volatile uint32_t *sweet_bc;             /* frame 0 */
+static uint64_t sweet_bc_off;                   /* frame CNTPCT - mach_absolute_time() */
+static uint64_t sweet_bc_deadline[MAX_CPUS];    /* mach time to kick that CPU; 0: none */
+static uint32_t sweet_bc_lock;                  /* taken only with interrupts masked */
+static uint64_t sweet_bc_irqs, sweet_bc_kicks;
+static int32_t sweet_idle_rc;                   /* last PSCI error */
+static struct {
+	uint64_t down, back, err, t0, abs;
+} sweet_idle_cnt[MAX_CPUS];
+
+/* SMCCC 1.0 (as sweet_psci_cpu_on in SweetCPU.cpp): x0 is the signed result */
+static int32_t
+sweet_psci(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+/* Kick the CPUs whose deadline has come, program the frame for the next one. Interrupts masked. */
+static void
+sweet_bc_update(void)
+{
+	uint64_t now, next = UINT64_MAX;
+
+	while (__atomic_exchange_n(&sweet_bc_lock, 1, __ATOMIC_ACQUIRE) != 0) {
+		while (__atomic_load_n(&sweet_bc_lock, __ATOMIC_RELAXED) != 0) {
+		}
+	}
+	now = mach_absolute_time();
+	for (unsigned int i = 0; i < MAX_CPUS; i++) {
+		uint64_t d = __atomic_load_n(&sweet_bc_deadline[i], __ATOMIC_RELAXED);
+
+		if (d != 0 && d <= now) {
+			__atomic_store_n(&sweet_bc_deadline[i], 0, __ATOMIC_RELAXED);
+			sweet_bc_kicks++;
+			(void)cpu_signal(cpu_datap((int)i), SIGPnop, NULL, NULL);
+		} else if (d != 0 && d < next) {
+			next = d;
+		}
+	}
+	sweet_bc[0x2c / 4] = 0;                 /* CNTP_CTL off while CNTP_CVAL changes */
+	if (next != UINT64_MAX) {
+		next += sweet_bc_off;
+		sweet_bc[0x20 / 4] = (uint32_t)next;
+		sweet_bc[0x24 / 4] = (uint32_t)(next >> 32);
+		sweet_bc[0x2c / 4] = 1;         /* enabled, not masked */
+	}
+	__builtin_arm_dsb(DSB_SY);
+	__atomic_store_n(&sweet_bc_lock, 0, __ATOMIC_RELEASE);
+}
+
+/* sleh_irq, SWEET_IDLE_BC_INTID (cpu0) */
+void sweet_idle_bc_intr(void);
+void
+sweet_idle_bc_intr(void)
+{
+	sweet_bc_irqs++;
+	sweet_bc_update();
+}
+
+/* cpu_idle(): false = not now, WFI as before; true = CPU_SUSPEND returned (no power-down) */
+static bool
+sweet_idle_powerdown(cpu_data_t *cdp)
+{
+	unsigned int cpu = cdp->cpu_number;
+	uint32_t state = __atomic_load_n(&sweet_idle_state, __ATOMIC_ACQUIRE);
+	uint64_t now = mach_absolute_time(), pop = cdp->rtcPop;
+	int32_t rc;
+
+	if (state == 0 || cpu == 0 || cpu >= MAX_CPUS || pop <= now || pop - now < sweet_idle_min_abs) {
+		return false;
+	}
+	if (pop != EndOfAllTime) {
+		__atomic_store_n(&sweet_bc_deadline[cpu], pop - sweet_idle_early_abs, __ATOMIC_RELAXED);
+		sweet_bc_update();
+	}
+	/* reset_vector/start_cpu read this CPU's cpu_data (reset handler, stacks) with caches off */
+	CleanPoC_DcacheRegion_Force((vm_offset_t)cdp, sizeof(*cdp));
+	sweet_idle_cnt[cpu].t0 = now;
+	__builtin_arm_dsb(DSB_SY);
+	rc = sweet_psci(0xC4000001ULL, state, sweet_idle_entry_pa, 0);  /* PSCI CPU_SUSPEND */
+
+	/* Still here: a wake-up was already pending (0), or the TZ refused */
+	__atomic_store_n(&sweet_bc_deadline[cpu], 0, __ATOMIC_RELAXED);
+	if (rc == 0) {
+		sweet_idle_cnt[cpu].back++;
+	} else {
+		sweet_idle_cnt[cpu].err++;
+		sweet_idle_rc = rc;
+		if (rc == -1 || rc == -2) {     /* NOT_SUPPORTED, INVALID_PARAMETERS: WFI from now on */
+			__atomic_store_n(&sweet_idle_state, 0, __ATOMIC_RELEASE);
+		}
+	}
+	return true;
+}
+
+/* arm_init_idle_cpu(), interrupts masked: the core was powered down */
+void sweet_idle_resume(cpu_data_t *cdp);
+void
+sweet_idle_resume(cpu_data_t *cdp)
+{
+	unsigned int cpu = cdp->cpu_number;
+
+	if (__atomic_load_n(&sweet_idle_state, __ATOMIC_ACQUIRE) == 0) {
+		return;         /* not armed: this core did not power down through 0329 */
+	}
+	PE_init_cpu();          /* GIC CPU interface (ICC_*): pe_init_fiq() as at CPU start */
+	ClearIdlePop(FALSE);    /* the CNTV comparator: re-arm this CPU's next deadline */
+	if (cpu < MAX_CPUS) {
+		__atomic_store_n(&sweet_bc_deadline[cpu], 0, __ATOMIC_RELAXED);
+		sweet_idle_cnt[cpu].down++;
+		sweet_idle_cnt[cpu].abs += mach_absolute_time() - sweet_idle_cnt[cpu].t0;
+	}
+}
+
+/* SweetCPU::startAll once every CPU runs: true if armed (then it calls sweet_idle_log every 10 s) */
+boolean_t sweet_idle_start(void);
+boolean_t
+sweet_idle_start(void)
+{
+	uint32_t mode = 0, us = 2000, acr, frq, hi, lo;
+	uint64_t t;
+	vm_offset_t ctl, frame;
+	int32_t ver, feat;
+	boolean_t istate;
+
+	(void)PE_parse_boot_argn("sweetidle", &mode, sizeof(mode));
+	(void)PE_parse_boot_argn("sweetidle_us", &us, sizeof(us));
+	if (mode == 0) {
+		return FALSE;
+	}
+	ver = sweet_psci(0x84000000ULL, 0, 0, 0);                       /* PSCI_VERSION */
+	feat = sweet_psci(0x8400000AULL, 0xC4000001ULL, 0, 0);          /* PSCI_FEATURES(CPU_SUSPEND) */
+	ctl = ml_io_map(SWEET_IDLE_CTL_PA, 0x1000);
+	frame = ml_io_map(SWEET_IDLE_FRAME_PA, 0x1000);
+	if (ctl == 0 || frame == 0) {
+		printf("SWEET IDLE: cannot map the memory-mapped timer, WFI kept\n");
+		return FALSE;
+	}
+	/* as Linux's arch_timer_mem_find_best_frame: ask for every access, keep what sticks */
+	((volatile uint32_t *)ctl)[0x40 / 4] = 0x3f;
+	acr = ((volatile uint32_t *)ctl)[0x40 / 4];
+	sweet_bc = (volatile uint32_t *)frame;
+	frq = sweet_bc[0x10 / 4];
+	printf("SWEET IDLE: PSCI %#x, CPU_SUSPEND features %d, CNTACR0 %#x, frame0 CNTFRQ %u (CNTFRQ_EL0 %llu)\n",
+	    ver, feat, acr, frq, (unsigned long long)__builtin_arm_rsr64("CNTFRQ_EL0"));
+	if (mode > 2 || us < 1000 || feat < 0 || (acr & 0x21) != 0x21 ||     /* RPCT, RWPT */
+	    frq != (uint32_t)__builtin_arm_rsr64("CNTFRQ_EL0")) {
+		printf("SWEET IDLE: sweetidle=%u sweetidle_us=%u not usable here, WFI kept\n", mode, us);
+		return FALSE;
+	}
+	istate = ml_set_interrupts_enabled(FALSE);
+	do {
+		hi = sweet_bc[0x04 / 4];
+		lo = sweet_bc[0x00 / 4];
+	} while (hi != sweet_bc[0x04 / 4]);
+	sweet_bc_off = (((uint64_t)hi << 32) | lo) - mach_absolute_time();
+	sweet_gic_route_spi(SWEET_IDLE_BC_INTID, 0);    /* to cpu0 (MPIDR 0) */
+	/* Self-test of the whole path (frame, SPI, handler, IPI) on cpu0's slot */
+	nanoseconds_to_absolutetime(NSEC_PER_MSEC, &t);
+	__atomic_store_n(&sweet_bc_deadline[0], mach_absolute_time() + t, __ATOMIC_RELAXED);
+	sweet_bc_update();
+	ml_set_interrupts_enabled(istate);
+	for (int i = 0; i < 100 && __atomic_load_n(&sweet_bc_irqs, __ATOMIC_RELAXED) == 0; i++) {
+		delay(1000);
+	}
+	if (__atomic_load_n(&sweet_bc_irqs, __ATOMIC_RELAXED) == 0 || sweet_bc_kicks == 0) {
+		istate = ml_set_interrupts_enabled(FALSE);
+		__atomic_store_n(&sweet_bc_deadline[0], 0, __ATOMIC_RELAXED);
+		sweet_bc_update();
+		ml_set_interrupts_enabled(istate);
+		printf("SWEET IDLE: broadcast timer IRQ %u never came (irqs %llu kicks %llu), WFI kept\n",
+		    SWEET_IDLE_BC_INTID, sweet_bc_irqs, sweet_bc_kicks);
+		return FALSE;
+	}
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &sweet_idle_min_abs);
+	nanoseconds_to_absolutetime((uint64_t)SWEET_IDLE_EARLY_US * NSEC_PER_USEC, &sweet_idle_early_abs);
+	sweet_idle_entry_pa = ml_static_vtop((vm_offset_t)&sweet_secondary_entry);
+	__atomic_store_n(&sweet_idle_state, mode == 2 ? 0x40000004U : 0x40000003U, __ATOMIC_RELEASE);
+	printf("SWEET IDLE: on: cpu1-%u power down (PSCI %#x) when the next timer is >= %u us away; "
+	    "broadcast offset %llu, entry %#llx\n", real_ncpus - 1, sweet_idle_state, us,
+	    sweet_bc_off, sweet_idle_entry_pa);
+	return TRUE;
+}
+
+/* One line per call (every 10 s): per CPU power-downs and share of the time powered down */
+void sweet_idle_log(void);
+void
+sweet_idle_log(void)
+{
+	static uint64_t last, prev_down[MAX_CPUS], prev_abs[MAX_CPUS];
+	uint64_t now = mach_absolute_time(), back = 0, err = 0;
+	char line[256];
+	size_t used = 0;
+
+	for (unsigned int i = 1; i < MAX_CPUS && i < real_ncpus; i++) {
+		uint64_t d = sweet_idle_cnt[i].down, a = sweet_idle_cnt[i].abs;
+
+		if (used < sizeof(line) - 32) {
+			used += (size_t)snprintf(line + used, sizeof(line) - used, " cpu%u %llux %llu%%", i,
+			    d - prev_down[i], last != 0 ? (a - prev_abs[i]) * 100 / (now - last) : 0);
+		}
+		prev_down[i] = d;
+		prev_abs[i] = a;
+		back += sweet_idle_cnt[i].back;
+		err += sweet_idle_cnt[i].err;
+	}
+	last = now;
+	printf("SWEET IDLE:%s; returned %llu, errors %llu (last rc %d), broadcast irqs %llu kicks %llu\n",
+	    line, back, err, sweet_idle_rc, sweet_bc_irqs, sweet_bc_kicks);
+}
+#endif /* SWEET */
+
