diff -ruN a/iokit/Kernel/arm/SweetOLYHAL.cpp b/iokit/Kernel/arm/SweetOLYHAL.cpp
--- a/iokit/Kernel/arm/SweetOLYHAL.cpp	1969-12-31 16:00:00.000000000 -0800
+++ b/iokit/Kernel/arm/SweetOLYHAL.cpp	2026-11-05 11:35:24.935377641 -0800
@@ -0,0 +1,53 @@
+/*
+ * AppleOLYHAL stand-in for SWEET (boot-arg btfake != 0 only).
+ *
+ * MobileGestalt answers WifiVendor from the "vendor-id" property of the
+ * AppleOLYHAL service (IORegistryEntrySearchCFProperty, IOService plane;
+ * otherwise "failed to fetch wifi vendor (no AppleOLYHAL node)"). BlueTool
+ * -R maps that string to a module vendor (getManufacturer: "Murata" -> MUR)
+ * and only then finds its firmwareList entry for ProductHash fd079b29...
+ * (D22 /product product-id) + MUR, whose boot script starts with
+ * "device -D". Without a vendor it loops "No WiFi" and returns 0xd without
+ * ever opening the port. There is no Wi-Fi HAL here: this nub only carries
+ * the property.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+
+class AppleOLYHAL : public IOService {
+	OSDeclareDefaultStructors(AppleOLYHAL);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleOLYHAL, IOService);
+
+IOService *
+AppleOLYHAL::probe(IOService *provider, SInt32 *score)
+{
+	uint32_t bt_mode = 0;
+
+	if (!PE_parse_boot_argn("btfake", &bt_mode, sizeof(bt_mode)) || bt_mode == 0) {
+		return NULL;
+	}
+	return IOService::probe(provider, score);
+}
+
+bool
+AppleOLYHAL::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty("vendor-id", "Murata");
+	registerService();
+	IOLog("SWEET OLYHAL: AppleOLYHAL vendor-id \"Murata\" (MobileGestalt WifiVendor)\n");
+	return true;
+}
+#endif /* SWEET */
