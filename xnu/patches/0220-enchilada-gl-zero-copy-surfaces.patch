+/*
+ * 0220: cacheable IOSurfaces of wired kernel pages (CoreAnimation's display surfaces) are mapped
+ * for the GPU in place and kept coherent as 0197 keeps arena BOs, by the surface's kernel address
+ * instead of a pa (dc civac by VA reaches every alias of the page: the data cache is physically
+ * tagged). Cleaned at SUBMIT; dropped once the GPU is done with them at CPU_PREP, WAIT_FENCE, an
+ * IOSurface lock and the panel copy (sweet_surface_gpu_settle). glzc0=1: refused as with 0198.
+ */
+#define SETTLE_PATIENCE_MS      100u
+static int gSurfZc = -1;
+
+static bool
+surfZc(void)
+{
+	if (gSurfZc < 0) {
+		uint32_t off = 0;
+		(void)PE_parse_boot_argn("glzc0", &off, sizeof(off));
+		gSurfZc = off == 0;
+		IOLog("SWEET GPU: cacheable IOSurfaces %s (glzc0=%u)\n",
+		    gSurfZc ? "used by the GPU in place, kernel-maintained" : "not mapped for the GPU, the client copies", off);
+	}
+	return gSurfZc != 0;
+}
+
+/* Clean+invalidate the pixels of a zero-copy surface (one plane: offset + rows) by kernel address. */
+static void
+surfFlush(SweetSurface *s)
+{
+	flush_dcache64((addr64_t)s->kernelAddress(), (unsigned)((uint64_t)s->offset + (uint64_t)s->bytesPerRow * s->height), FALSE);
+}
+
+/* Lock held: once the submissions that used it are done, drop the CPU's lines of it. */
+static bool
+surfSettle(SweetSurface *s)
+{
+	if (s->gpuDirty && (!sweet_gpu_ready() || sweet_gpu_fence_done(s->gpuFence))) {
+		surfFlush(s);
+		s->gpuDirty = false;
+	}
+	return !s->gpuDirty;
+}
+
+void
+sweet_surface_gpu_settle(SweetSurface *s)
+{
+	/* A look without the lock first: only SUBMIT sets the flag. */
+	if (s == NULL || !s->gpuDirty || gAdrenoLock == NULL) {
+		return;
+	}
+	IOLockLock(gAdrenoLock);
+	for (uint32_t ms = 0; !surfSettle(s) && ms < SETTLE_PATIENCE_MS; ms++) {
+		IOLockUnlock(gAdrenoLock);
+		IOSleep(1);
+		IOLockLock(gAdrenoLock);
+	}
+	if (s->gpuDirty) {
+		static uint32_t told;
+		surfFlush(s);   /* what is in memory now rather than older lines; still dirty for the next look */
+		if (told++ < 4) {
+			IOLog("SWEET GPU: surface %u still in use by the GPU after %u ms (fence %u, last done %s): read as it is\n",
+			    s->id, SETTLE_PATIENCE_MS, s->gpuFence, sweet_gpu_fence_done(s->gpuFence) ? "yes" : "no");
+		}
+	}
+	IOLockUnlock(gAdrenoLock);
+}
