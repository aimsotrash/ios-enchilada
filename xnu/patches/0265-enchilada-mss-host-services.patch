enchilada: MSS stage 7 (mss=7): pd-mapper, TFTP and read-only rmtfs for the modem

mss=7 = mss=6 plus the three linux-msm host services, announced to the modem's name service once
stage 6 is up (and again after each HELLO, as ns.c announce_servers): servreg-locator 0x40 v0x101
(pd-mapper.c GET_DOMAIN_LIST from modem_a's modemr.jsn and modemuw.jsn: tms/servreg, kernel/
elf_loader and wlan/fw -> msm/modem/root_pd or wlan_pd, instance 180; PFR only logged); TFTP
0x1000 v1 (tqftpserv.c: per-session ports, OACK, blksize/timeoutms/tsize/rsize/wsize/seek, the
rsize windows of handle_reader; /readonly/... read from modem_a through mss_tftp[], 141 files made
by tools/mss-fw-table.py --tftp from the same image as mss_fw[]; /readwrite/... kept in RAM for
the boot); rmtfs 0x0e v1 (rmtfs.c open/close/iovec/alloc/dev_error) serving modemst1, modemst2,
fsc and fsg (UFS LUN 5) from a RAM copy made in stage 2, before the modem gets anything; writes
are logged and dropped, no partition is ever written. The shared buffer is mainline
sdm845-oneplus-common.dtsi rmtfs_mem (0xf5b01000, 2 MiB, guard pages either side): assigned to
{HLOS, MSS_MSA} with the 0262 SCM assign when stage 7 starts, as qcom_rmtfs_mem does, written only
through short-lived Device mappings, reclaimed by the stop path once the Q6 is in reset. Any
failure ends in the stop path; mss<=6 behave as before.

--- a/bsd/dev/sweet_mss.c
+++ b/bsd/dev/sweet_mss.c
@@ -38,6 +38,8 @@
  * 0264:
  *   6  GLINK over SMEM (items 478/479/480, doorbell bit 12), IPCRTR channel, QRTR hello; every
  *      NEW_SERVER of the modem logged; the modem's IPA clock query answered; 120 s watch
+ * 0265:
+ *   7  + pd-mapper, TFTP (modem_a, read-only) and rmtfs (EFS from a RAM copy, writes dropped)
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -434,6 +436,8 @@
 #define MBA_SIZE        0x200000u
 #define MPSS_PA         0x8e000000ull
 #define MPSS_SIZE       0x7800000u
+#define RMTFS_PA        0xf5b01000ull   /* 0265: sdm845-oneplus-common.dtsi rmtfs_mem, guards around */
+#define RMTFS_SIZE      0x200000u
 #define SCR_PA          0xa1000000ull   /* plain RAM in sdm845.dtsi's mdata alloc-ranges */
 #define SCR_SIZE        0x80000u        /* = one big window; only the first 16 KiB are used */
 #define META_PA         (SCR_PA + 0x10000)  /* 0263: own 16 KiB page, not under mss_arg_va's mapping */
@@ -518,10 +522,10 @@
 	bool q6_started;        /* BOOT_CMD written: MPSS stays with the modem (Linux) */
 	bool running;           /* SMP2P ready seen: ask for a stop first */
 	uint32_t clk_set;       /* mss_clks[] we enabled */
-	uint32_t mba_perm, mpss_perm, meta_perm;
+	uint32_t mba_perm, mpss_perm, meta_perm, rmtfs_perm;
 	uint32_t qmp_off;
 	uint32_t out_off;       /* SMEM offset of our item 428 payload */
-} ms = { .mba_perm = PERM_HLOS, .mpss_perm = PERM_HLOS, .meta_perm = PERM_HLOS };
+} ms = { .mba_perm = PERM_HLOS, .mpss_perm = PERM_HLOS, .meta_perm = PERM_HLOS, .rmtfs_perm = PERM_HLOS };
 
 static uint8_t mss_buf[MSS_BIGWIN];     /* UFS bounce for one chunk, cacheable */
 static uint8_t mss_mdt[0x4000];
@@ -1186,6 +1190,9 @@
 	if (ms.meta_perm != PERM_HLOS && !mss_assign("metadata (reclaim)", META_PA, META_MAX, &ms.meta_perm, PERM_HLOS)) {
 		printf("SWEET MSS: metadata NOT reclaimed; it stays unmapped\n");
 	}
+	if (ms.rmtfs_perm != PERM_HLOS && !mss_assign("rmtfs (reclaim)", RMTFS_PA, RMTFS_SIZE, &ms.rmtfs_perm, PERM_HLOS)) {
+		printf("SWEET MSS: rmtfs NOT reclaimed; it stays unmapped\n");      /* 0265 */
+	}
