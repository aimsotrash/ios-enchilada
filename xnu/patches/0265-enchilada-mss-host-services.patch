+	{ "modem_pr/mcfg/configs/mcfg_sw/generic/sea/fareasto/commerci/mcfg_sw.sig", 0x6c61000, 0x19b60 },
+	{ "modem_pr/mcfg/configs/mcfg_sw/generic/sea/tm/commerci/mcfg_sw.mbn", 0x6ca1000, 0x18388 },
+	{ "modem_pr/mcfg/configs/mcfg_sw/generic/sea/tm/commerci/mcfg_sw.sig", 0x6ca1000, 0x18388 },
+	{ "modem_pr/mcfg/configs/mcfg_sw/generic/sea/ytl/commerci/mcfg_sw.mbn", 0x6ce1000, 0xc104 },
+	{ "modem_pr/mcfg/configs/mcfg_sw/generic/sea/ytl/commerci/mcfg_sw.sig", 0x6ce1000, 0xc104 },
+	{ "modem_pr/mcfg/configs/mcfg_sw/mbn_sw.dig", 0x6d25000, 0x20 },
+	{ "modem_pr/mcfg/configs/mcfg_sw/mbn_sw.txt", 0x6d29000, 0xa3a },
+	{ "modemr.jsn", 0x6359000, 0x195 },
+	{ "modemuw.jsn", 0x7121000, 0x2c9 },
+	{ "qdsp6m.qdb", 0x5e35000, 0x522abc },
+	{ "slpir.jsn", 0x6d2d000, 0x193 },
+	{ "slpius.jsn", 0x6d31000, 0x195 },
+	{ "wlanmdsp.mbn", 0x6e39000, 0x2e52e4 },
