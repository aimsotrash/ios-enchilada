@@ -83,6 +83,38 @@
 static int gAdrenoLogAll = -1;
 static uint32_t gLogSelector, gLogIb, gLogSubmit, gLogWait, gLogWaitDump, gLogFault;
 
+/*
+ * 0197: arena BOs are mapped into the client cacheable (copyback) instead of the write-combined
+ * mapping the libdrm stand-in asks for (IOConnectMapMemory64 options 0x401), with the maintenance
+ * that needs: SUBMIT cleans every BO before the CP reads (as before), CPU_PREP / WAIT_FENCE /
+ * BO_SYNC invalidate what the GPU may have written before the CPU reads, CPU_FINI cleans, and
+ * GEM_CLOSE cleans+invalidates before the pages go back to the arena. sweetbocache=0: the client's
+ * own cache mode again (write-combined: reads at ~50 MB/s), as before 0197.
+ */
+static int gBoCache = -1;
+
+static bool
+boCached(void)
+{
+	if (gBoCache < 0) {
+		uint32_t on = 1;
+		(void)PE_parse_boot_argn("sweetbocache", &on, sizeof(on));
+		gBoCache = on != 0;
+		IOLog("SWEET GPU: BO CPU mappings %s (sweetbocache=%u)\n",
+		    gBoCache ? "cacheable, kernel-maintained" : "as the client asks (write-combined)", on);
+	}
+	return gBoCache != 0;
+}
+
+/* Clean+invalidate an arena BO's lines by physical address (dc civac through the linear map). */
+static void
+boFlush(uint64_t pa, uint64_t len)
+{
+	if (pa != 0 && len != 0) {
+		flush_dcache64((addr64_t)pa, (unsigned)len, TRUE);
+	}
+}
+
