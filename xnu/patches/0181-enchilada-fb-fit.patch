+/*
+ * sweetfb_fit: draw the layer's part of the presented plane, scaled to
+ * fFitW x fFitH at (fFitX, fFitY) on the panel. Plane rect (dx,dy,w,h)
+ * comes from surface rect (sx,sy,w,h). Nearest neighbour; each panel row is
+ * built in sweet_fit_row and written to the write-combined panel at once.
+ */
+void
+AppleCLCD::presentFit(uintptr_t base, uint32_t bpr, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (!fFitCleared) {
+		for (uint32_t y = 0; y < fHeight; y++) {
+			memset((void *)(fPixels + (uint64_t)y * fRowBytes), 0, (size_t)fWidth * 4);
+		}
+		fFitCleared = true;
+	}
+	int32_t x0 = 0, x1 = fFitW;
+	while (x0 < fFitW && sweet_fit_col[x0] < dx) {
+		x0++;
+	}
+	while (x1 > x0 && sweet_fit_col[x1 - 1] >= dx + w) {
+		x1--;
+	}
+	if (x0 >= x1) {
+		return;
+	}
+	for (int32_t y = 0; y < fFitH; y++) {
+		int32_t ly = (int32_t)((int64_t)y * fLogicalH / fFitH);
+		if (ly < dy || ly >= dy + h) {
+			continue;
+		}
+		const uint32_t *row = (const uint32_t *)(base + (uint64_t)(sy + ly - dy) * bpr) + sx - dx;
+		for (int32_t x = x0; x < x1; x++) {
+			sweet_fit_row[x] = row[sweet_fit_col[x]];
+		}
+		memcpy((void *)(fPixels + (uint64_t)(fFitY + y) * fRowBytes + (uint64_t)(fFitX + x0) * 4),
+		    &sweet_fit_row[x0], (size_t)(x1 - x0) * 4);
+	}
+}
