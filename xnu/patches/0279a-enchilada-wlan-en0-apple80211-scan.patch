+/*
+ * 0268: the registry entries by which iOS finds en0 as its Wi-Fi interface (mss>=9 only;
+ * bsd/dev/sweet_wlan.c calls this once it has attached en0).
+ *
+ * Ported from HakiOS drivers/wifi/hakios.wlan.cpp (APSL 2.0, Copyright (c) 2025-2026 the HakiOS
+ * authors, who carried it on from ios-sapphire 0157/0158). This kernel has no IONetworkingFamily
+ * or IO80211Family; iOS looks for what they would have made:
+ *   - IO80211.framework (wifid) binds to the service whose IO80211InterfaceRole is
+ *     "Infrastructure" and whose IOInterfaceName is the interface's name (both strings are in
+ *     16.7.16's dyld cache). It has no user client, so the framework falls back to ioctls on a
+ *     socket, which sweet_wlan.c answers.
+ *   - SystemConfiguration lists IONetworkInterface objects and calls one Wi-Fi when its parent is
+ *     an IO80211Controller (type, unit, name, built-in from the interface; IOMACAddress from the
+ *     controller). configd makes a network service (DHCP) only for an interface it has listed.
+ *   - MobileGestalt reads the Wi-Fi address as local-mac-address of the "wlan" node, and launchd
+ *     starts wifid only if a "wlan" (or "marconi-wifi") node exists (_LimitLoadToDeviceTree in
+ *     com.apple.wifid.plist). That node comes from the ADT (tools/mkadt.py with ADT_WLAN=1), and
+ *     SweetPlatformExpert makes its nub; the controller is attached under it, or under the
+ *     platform when there is none (then wifid is not started).
+ * The classes are named as those families name theirs and have nothing but properties.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+
+class IONetworkController : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkController);
+};
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+class IOEthernetController : public IONetworkController
+{
+	OSDeclareDefaultStructors(IOEthernetController);
+};
+OSDefineMetaClassAndStructors(IOEthernetController, IONetworkController);
+
+class IO80211Controller : public IOEthernetController
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+OSDefineMetaClassAndStructors(IO80211Controller, IOEthernetController);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class SweetWLAN : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(SweetWLAN);
+};
+OSDefineMetaClassAndStructors(SweetWLAN, IONetworkInterface);
+
+/* the "wlan" nub of the ADT node, retained, or NULL */
+static IOService *
+sweet_wlan_node(void)
+{
+	OSDictionary *match = IOService::nameMatching("wlan");
+	IOService *node = match != NULL ? IOService::copyMatchingService(match) : NULL;
+
+	OSSafeReleaseNULL(match);
+	return node;
+}
+
+/* the node's local-mac-address into mac, if it has one of 6 bytes */
+extern "C" bool
+SweetWLANAdtMac(uint8_t mac[6])
+{
+	IOService *node = sweet_wlan_node();
+	OSData *d = node != NULL ? OSDynamicCast(OSData, node->getProperty("local-mac-address")) : NULL;
+	bool ok = d != NULL && d->getLength() == 6;
+
+	if (ok) {
+		memcpy(mac, d->getBytesNoCopy(), 6);
+	}
+	OSSafeReleaseNULL(node);
+	return ok;
+}
+
+/* attach, start, register: the service, or NULL (released) */
+static IOService *
+sweet_wlan_publish(IOService *service, IOService *provider, const char *name)
+{
+	if (!service->attach(provider)) {
+		service->release();
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+static void
+sweet_wlan_number(IOService *s, const char *key, unsigned long long value)
+{
+	OSNumber *n = OSNumber::withNumber(value, 32);
+
+	if (n != NULL) {
+		s->setProperty(key, n);
+		n->release();
+	}
+}
+
+extern "C" void
+SweetWLANStart(const char *ifname, const uint8_t mac[6])
+{
+	IOService *node = sweet_wlan_node();
+	IOService *parent = node != NULL ? node : IOService::getPlatform();
+	IO80211Controller *controller = OSTypeAlloc(IO80211Controller);
+	SweetWLAN *wlan = OSTypeAlloc(SweetWLAN);
+	OSData *address = OSData::withBytes(mac, 6);
+
+	if (parent == NULL || controller == NULL || wlan == NULL || address == NULL || !controller->init() || !wlan->init()) {
+		IOLog("SWEET WLAN: cannot create the IOKit services\n");
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		OSSafeReleaseNULL(address);
+		OSSafeReleaseNULL(node);
+		return;
+	}
+	controller->setProperty("IOMACAddress", address);
+	controller->setProperty("IOBuiltin", true);
+	address->release();
+	controller = (IO80211Controller *)sweet_wlan_publish(controller, parent, "SweetWLANController");
+	OSSafeReleaseNULL(node);
+	if (controller == NULL) {
+		wlan->release();
+		IOLog("SWEET WLAN: the controller did not start\n");
+		return;
+	}
+	wlan->setProperty("IOInterfaceName", ifname);
+	wlan->setProperty("BSD Name", ifname);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	sweet_wlan_number(wlan, "IOInterfaceType", 6);          /* IFT_ETHER */
+	sweet_wlan_number(wlan, "IOInterfaceUnit", (unsigned long long)(ifname[2] - '0'));
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (sweet_wlan_publish(wlan, controller, "SweetWLAN") == NULL) {
+		IOLog("SWEET WLAN: the interface service did not start\n");
+	} else {
+		wlan->release();
+	}
+	controller->release();
+	IOLog("SWEET WLAN: IO80211Controller + IONetworkInterface (%s, Infrastructure) under %s\n", ifname,
+	    parent == IOService::getPlatform() ? "the platform (no wlan node)" : "the wlan node");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
