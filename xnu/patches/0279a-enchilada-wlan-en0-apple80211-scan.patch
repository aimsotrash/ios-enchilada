+/*
+ * 0268: what sweet_mss.c (the WCN3990 data path, mss=9) and sweet_wlan.c (en0 and the
+ * Apple80211 requests wifid makes of it) know of each other.
+ */
+#ifndef _SWEET_WLAN_H_
+#define _SWEET_WLAN_H_
+#include <stdbool.h>
+#include <stdint.h>
+
+#define SWEET_WLAN_IES          512u    /* information elements kept per network (whole elements only) */
+#define SWEET_WLAN_FRESH_MS     60000u  /* a network not heard for this long is not reported */
+
+struct sweet_wlan_bss {
+	uint8_t bssid[6];
+	uint8_t chan;                   /* channel number (2.4 GHz: 1-14, 5 GHz: 36-177) */
+	uint8_t ssid_len;               /* 0: hidden */
+	int8_t rssi;                    /* dBm, the last frame heard */
+	uint16_t bintval, capab, ies_len;
+	unsigned seen_ms;               /* mss_now() of the last frame heard */
+	uint8_t ssid[32];
+	uint8_t ies[SWEET_WLAN_IES];
+};
+
+/* sweet_mss.c */
+bool sweet_wlan_ready(void);                            /* data path up, scans running */
+bool sweet_wlan_heard(unsigned i, struct sweet_wlan_bss *out, unsigned *age_ms);  /* the i-th fresh network */
+void sweet_wlan_scan_ask(void);                         /* answered by sweet_wlan_scan_done() */
+const uint16_t *sweet_wlan_freqs(unsigned *n);          /* the channels scanned (MHz), all passive */
+
+/* sweet_wlan.c */
+extern uint8_t sweet_wlan_mac[6];                       /* en0's address, also the station vdev's */
+void sweet_wlan_attach(void);                           /* en0 and its IOKit entries, once (mss>=9) */
+void sweet_wlan_scan_done(void);                        /* posts APPLE80211_M_SCAN_DONE */
+
+#endif /* _SWEET_WLAN_H_ */
