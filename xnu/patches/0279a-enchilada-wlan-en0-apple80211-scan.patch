+/*
+ * 0268: en0 for the WCN3990 and the Apple80211 requests wifid makes of it (mss>=9 only).
+ *
+ * Ported from HakiOS (APSL 2.0, Copyright (c) 2025-2026 the HakiOS authors):
+ * drivers/net/hakios.net.c (an Ethernet interface made with the interface KPI, as if_fake.c
+ * makes feth), drivers/wifi/hakios.apple80211.c (SIOCGA80211/SIOCSA80211, the request layouts
+ * HakiOS read out of IO80211.framework of iOS 16.5, the IEEE 802.11 kernel events) and
+ * drivers/wifi/hakios.wlan.cpp (iokit/Kernel/arm/SweetWLAN.cpp here). Cut down to what our
+ * passive scan (sweet_mss.c, 0267) can answer: power, card capabilities, channels, SCAN_REQ and
+ * SCAN_RESULT, state. What is asked about a joined network answers ENXIO; ASSOCIATE is refused.
+ *
+ * How the requests get here: IO80211.framework finds no user client on the interface's IOKit
+ * service, logs "Falling back to IOCTL path" (the same string is in 16.7.16's dyld cache) and
+ * sends every request as an ioctl on a socket, a struct apple80211req that begins with the
+ * interface name. ifioctl() hands a command it does not know to the named interface's ioctl
+ * (after the protocol's pru_control said EOPNOTSUPP), so they arrive in wl_ioctl() below. The
+ * framework picks the interface out of getifaddrs by SIOCGIFMEDIA saying IEEE 802.11.
+ *
+ * Events go out the way a driver posts them: kernel events of class KEV_IEEE80211_CLASS,
+ * subclass 1, code = Apple80211's event number, data = the interface name in 16 bytes first.
+ *
+ * en0 itself: IFT_ETHER, family Ethernet, subfamily Wi-Fi, no Skywalk nexus, the link never up.
+ * Nothing is transmitted yet: frames the stack hands to en0 are dropped and counted.
+ * Requests are logged (who, get/set, type, value, length, result; per type the first 4 and every
+ * 100th), never what they carry. 16.7.16's layouts were not re-read from the binary: a layout
+ * that changed since 16.5 shows up here as a length that does not match.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <stddef.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/sockio.h>
+#include <sys/kern_event.h>
+#include <sys/kpi_mbuf.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/if_media.h>
+#include <net/ethernet.h>
+#include <net/if_ether.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include "sweet_wlan.h"
+
+/* iokit/Kernel/arm/SweetWLAN.cpp */
+extern bool SweetWLANAdtMac(uint8_t mac[6]);
+extern void SweetWLANStart(const char *ifname, const uint8_t mac[6]);
+
+#define SIOCSA80211             0x802869c8u     /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211             0xc02869c9u     /* _IOWR('i', 201, struct apple80211req) */
+#define WL_SAY                  2000u           /* log lines in all */
+
+struct apple80211req {
+	char req_if_name[16];
+	int32_t req_type;
+	int32_t req_val;
+	uint32_t req_len;
+	user_addr_t req_data __attribute__((aligned(8)));
+};
+_Static_assert(sizeof(struct apple80211req) == 40, "IOCPARM_LEN of SIOCGA80211");
+
+/* ---- the layouts (HakiOS, from IO80211.framework of 16.5) ---- */
+#define CHANNEL_20MHZ           0x2u
+#define CHANNEL_2GHZ            0x8u
+#define CHANNEL_5GHZ            0x10u
+#define CHANNEL_ACTIVE          0x80u           /* the radio may send there: never, so far */
+#define CHANNEL_DFS             0x100u
+
+struct apple80211_channel {
+	uint32_t version, channel, flags;
+};
+
+/* SUPPORTED_CHANNELS (27), HW_SUPPORTED_CHANNELS (254) */
+struct apple80211_channels {
+	uint32_t version, count;
+	struct apple80211_channel channels[401];
+	uint32_t unused;
+};
+
+/* CHANNELS_INFO (207): a byte per channel in several rows, and a word of flags */
+struct apple80211_channels_info {
+	uint8_t unknown_0[12];
+	uint16_t count;
+	uint8_t unknown_1[800];
+	uint8_t number[400], indoor[400], dfs[400], passive[400], wide_40[400], wide_80[400];
+	uint8_t unknown_2[1602];
+	uint32_t flags[400];
+	uint8_t unknown_3[3600];
+} __attribute__((packed));
+
+/* SCAN_REQ (10); only its size is checked: every scan here is the 0267 passive one */
+#define SCAN_REQUEST_SIZE       5456u
+
+/* SCAN_RESULT (11) */
+struct apple80211_scan_result {
+	uint32_t version;
+	struct apple80211_channel channel;
+	uint16_t noise_known;
+	int16_t noise, snr, rssi;
+	uint16_t beacon_interval, capability;
+	uint8_t bssid[6];
+	uint8_t rate_count, unused_0;
+	uint32_t rates[15];                     /* Mbit/s */
+	uint8_t ssid_length, ssid[32], unused_1[3];
+	uint32_t age_ms;
+	uint8_t flags, unused_2;
+	uint16_t elements_length;               /* comes in as the room there is */
+	uint8_t elements[1024];
+};
+
+_Static_assert(sizeof(struct apple80211_channels) == 4824, "the channel list as 16.5 has it");
+_Static_assert(sizeof(struct apple80211_channels_info) == 10016 &&
+    offsetof(struct apple80211_channels_info, number) == 0x32e &&
+    offsetof(struct apple80211_channels_info, flags) == 0x12d0, "the channels' description as 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_result) == 1164 &&
+    offsetof(struct apple80211_scan_result, ssid_length) == 0x60 &&
+    offsetof(struct apple80211_scan_result, age_ms) == 0x84 &&
+    offsetof(struct apple80211_scan_result, elements) == 0x8c, "a scan's result as 16.5 has it");
+
+/* APPLE80211_M_* */
+enum { EVENT_POWER_CHANGED = 1, EVENT_SCAN_DONE = 10 };
+
+uint8_t sweet_wlan_mac[6] = { 0x02, 0x00, 0x00, 0x53, 0x57, 0x54 };     /* unless /arm-io/wlan has one */
+
+static LCK_GRP_DECLARE(wl_grp, "sweet_wlan");
+static LCK_MTX_DECLARE(wl_lock, &wl_grp);
+static ifnet_t wl_ifp;
+static bool wl_powered = true;                  /* as wifid last set it */
+static unsigned wl_next;                        /* the SCAN_RESULT the next request gets */
+static unsigned wl_said;
+static uint16_t wl_seen[2][256];                /* requests per (set, type), for the log */
+static uint64_t wl_dropped;
+
+static const char *
+wl_type_name(int32_t type)
+{
+	static const struct {
+		int32_t type;
+		const char *name;
+	} names[] = {
+		{ 1, "SSID" }, { 2, "AUTH_TYPE" }, { 4, "CHANNEL" }, { 9, "BSSID" }, { 10, "SCAN_REQ" },
+		{ 11, "SCAN_RESULT" }, { 12, "CARD_CAPABILITIES" }, { 13, "STATE" }, { 14, "PHY_MODE" },
+		{ 15, "OP_MODE" }, { 16, "RSSI" }, { 17, "NOISE" }, { 19, "POWER" }, { 20, "ASSOCIATE" },
+		{ 21, "ASSOCIATE_RESULT" }, { 22, "DISASSOCIATE" }, { 27, "SUPPORTED_CHANNELS" }, { 28, "LOCALE" },
+		{ 43, "DRIVER_VERSION" }, { 44, "HARDWARE_VERSION" }, { 51, "COUNTRY_CODE" }, { 86, "SCAN_REQ_MULTIPLE" },
+		{ 90, "SCANCACHE_CLEAR" }, { 103, "CURRENT_NETWORK" }, { 207, "CHANNELS_INFO" },
+		{ 254, "HW_SUPPORTED_CHANNELS" },
+	};
+
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (names[i].type == type) {
+			return names[i].name;
+		}
+	}
+	return "?";
+}
+
+static unsigned
+wl_freq(unsigned chan)
+{
+	return chan == 14 ? 2484 : chan <= 14 ? 2407 + 5 * chan : 5000 + 5 * chan;
+}
+
+static void
+wl_channel(struct apple80211_channel *c, unsigned freq)
+{
+	c->version = 1;
+	c->channel = freq == 2484 ? 14 : freq < 4000 ? (freq - 2407) / 5 : (freq - 5000) / 5;
+	c->flags = CHANNEL_20MHZ | (freq < 4000 ? CHANNEL_2GHZ : CHANNEL_5GHZ) |
+	    (freq >= 5260 && freq <= 5720 ? CHANNEL_DFS : 0);
+}
+
+/* at most as many bytes as the caller has room for */
+static int
+wl_give(const struct apple80211req *r, const void *d, size_t n)
+{
+	return r->req_data == USER_ADDR_NULL ? 0 : copyout(d, r->req_data, MIN(n, (size_t)r->req_len));
+}
+
+static void
+wl_post(uint32_t code, const void *data, uint32_t length)
+{
+	struct kev_msg m = { .vendor_code = KEV_VENDOR_APPLE, .kev_class = KEV_IEEE80211_CLASS, .kev_subclass = 1,
+		             .event_code = code };
+	char name[16] = "en0";
+
+	m.dv[0].data_length = sizeof(name);
+	m.dv[0].data_ptr = name;
+	if (length != 0) {
+		m.dv[1].data_length = length;
+		m.dv[1].data_ptr = __DECONST(void *, data);
+	}
+	kev_post_msg(&m);
+}
+
+/* sweet_mss.c, when a scan asked for has results (cached or new) */
+void
+sweet_wlan_scan_done(void)
+{
+	lck_mtx_lock(&wl_lock);
+	wl_next = 0;
+	lck_mtx_unlock(&wl_lock);
+	wl_post(EVENT_SCAN_DONE, NULL, 0);
+}
+
+/* one network heard, as a scan's result; the caller says how much room for elements it has */
+static int
+wl_give_bss(const struct apple80211req *r, const struct sweet_wlan_bss *b, unsigned age_ms)
+{
+	struct apple80211_scan_result *s = kalloc_data(sizeof(*s), Z_WAITOK | Z_ZERO);
+	unsigned room = sizeof(s->elements);
+	int error;
+
+	if (s == NULL) {
+		return ENOMEM;
+	}
+	if (r->req_data != USER_ADDR_NULL && r->req_len >= sizeof(*s) &&
+	    copyin(r->req_data, s, offsetof(struct apple80211_scan_result, elements)) == 0 && s->elements_length < room) {
+		room = s->elements_length;
+	}
+	bzero(s, sizeof(*s));
+	s->version = 1;
+	wl_channel(&s->channel, wl_freq(b->chan));
+	s->rssi = b->rssi;
+	s->beacon_interval = b->bintval;
+	s->capability = b->capab;
+	memcpy(s->bssid, b->bssid, sizeof(s->bssid));
+	s->ssid_length = (uint8_t)MIN(b->ssid_len, sizeof(s->ssid));
+	memcpy(s->ssid, b->ssid, s->ssid_length);
+	s->age_ms = age_ms;
+	s->elements_length = (uint16_t)(b->ies_len <= room ? b->ies_len : 0);
+	memcpy(s->elements, b->ies, s->elements_length);
+	/* the rates it offers (elements 1 and 50, units of 500 kbit/s, top bit = basic) */
+	for (unsigned at = 0; at + 2 <= b->ies_len && at + 2 + b->ies[at + 1] <= b->ies_len; at += 2u + b->ies[at + 1]) {
+		for (unsigned i = 0; (b->ies[at] == 1 || b->ies[at] == 50) && i < b->ies[at + 1]; i++) {
+			unsigned rate = (b->ies[at + 2 + i] & 0x7fu) / 2;
+
+			if (rate != 0 && rate <= 54 && s->rate_count < 15) {
+				s->rates[s->rate_count++] = rate;
+			}
+		}
+	}
+	error = wl_give(r, s, sizeof(*s));
+	kfree_data(s, sizeof(*s));
+	return error;
+}
+
+static int
+wl_get_channels(const struct apple80211req *r)
+{
+	unsigned n;
+	const uint16_t *f = sweet_wlan_freqs(&n);
+	int error;
+
+	if (r->req_type == 207) {
+		struct apple80211_channels_info *a = kalloc_data(sizeof(*a), Z_WAITOK | Z_ZERO);
+
+		if (a == NULL) {
+			return ENOMEM;
+		}
+		a->count = (uint16_t)n;
+		for (unsigned i = 0; i < n && i < 400; i++) {
+			struct apple80211_channel c;
+
+			wl_channel(&c, f[i]);
+			a->number[i] = (uint8_t)c.channel;
+			a->dfs[i] = (c.flags & CHANNEL_DFS) != 0;
+			a->passive[i] = 1;
+			a->flags[i] = c.flags;
+		}
+		error = wl_give(r, a, sizeof(*a));
+		kfree_data(a, sizeof(*a));
+		return error;
+	}
+
+	struct apple80211_channels *l = kalloc_data(sizeof(*l), Z_WAITOK | Z_ZERO);
+
+	if (l == NULL) {
+		return ENOMEM;
+	}
+	l->version = 1;
+	l->count = n;
+	for (unsigned i = 0; i < n && i < 401; i++) {
+		wl_channel(&l->channels[i], f[i]);
+	}
+	error = wl_give(r, l, sizeof(*l));
+	kfree_data(l, sizeof(*l));
+	return error;
+}
+
+static int
+wl_get(struct apple80211req *r)
+{
+	switch (r->req_type) {
+	case 43:
+	case 44: {                              /* driver / hardware name: the text in 256 bytes */
+		static const char name[256] = "sweet: WCN3990 (in-kernel, mss=9)";
+
+		return wl_give(r, name, sizeof(name));
+	}
+	case 12: {
+		/*
+		 * APPLE80211_CAP_* bits from the first (HakiOS: AES, AES-CCM, power management, short
+		 * slot and preamble, WPA2, WME, short GI at 20 MHz). Without WPA2 here the framework
+		 * builds no join for a WPA2 network; said now so the list shows them as joinable later.
+		 */
+		uint8_t bits[13] = { 0 };
+		static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };
+
+		for (unsigned i = 0; i < sizeof(has); i++) {
+			bits[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+		}
+		return wl_give(r, bits, sizeof(bits));
+	}
+	case 19: {                              /* power: one radio */
+		struct {
+			uint32_t version, radios, state[4];
+		} a = { .version = 1, .radios = 1, .state = { wl_powered } };
+
+		return wl_give(r, &a, sizeof(a));
+	}
+	case 15:                                /* op mode: station (APPLE80211_M_STA) */
+		r->req_val = 1;
+		return 0;
+	case 13:                                /* state: APPLE80211_S_INIT (not associated) */
+		r->req_val = 0;
+		return 0;
+	case 27:
+	case 254:
+	case 207:
+		return wl_get_channels(r);
+	case 11: {                              /* the next network heard; EIO: that was all */
+		struct sweet_wlan_bss *b = kalloc_data(sizeof(*b), Z_WAITOK);
+		unsigned i, age;
+		int error;
+
+		if (b == NULL) {
+			return ENOMEM;
+		}
+		lck_mtx_lock(&wl_lock);
+		i = wl_next++;
+		lck_mtx_unlock(&wl_lock);
+		error = sweet_wlan_heard(i, b, &age) ? wl_give_bss(r, b, age) : EIO;
+		kfree_data(b, sizeof(*b));
+		return error;
+	}
+	case 1:
+	case 2:
+	case 4:
+	case 9:
+	case 16:
+	case 103:
+		return ENXIO;                   /* about a joined network: there is none */
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static int
+wl_set(const struct apple80211req *r)
+{
+	switch (r->req_type) {
+	case 10:                                /* scan: answered from 0267's table, SCAN_DONE once it has one */
+		if (r->req_len != SCAN_REQUEST_SIZE) {
+			return EINVAL;
+		}
+		if (!sweet_wlan_ready()) {
+			return EBUSY;           /* (the radio is still coming up: the framework asks again) */
+		}
+		lck_mtx_lock(&wl_lock);
+		wl_next = 0;
+		lck_mtx_unlock(&wl_lock);
+		sweet_wlan_scan_ask();
+		return 0;
+	case 19: {                              /* power: remembered and told; the radio stays as it is */
+		struct {
+			uint32_t version, radios, state[4];
+		} a;
+		int error;
+
+		if (r->req_len < sizeof(a)) {
+			return EINVAL;
+		}
+		if ((error = copyin(r->req_data, &a, sizeof(a))) != 0) {
+			return error;
+		}
+		wl_powered = a.state[0] != 0;
+		wl_post(EVENT_POWER_CHANGED, NULL, 0);
+		return 0;
+	}
+	case 22:                                /* leave the network: there is none */
+		return 0;
+	default:
+		return EOPNOTSUPP;              /* ASSOCIATE (20) among them: no join yet */
+	}
+}
+
+static int
+wl_a80211(u_long cmd, void *data)
+{
+	struct apple80211req *r = data;
+	bool set = cmd == SIOCSA80211;
+	char who[32] = "?";
+	int error = set ? wl_set(r) : wl_get(r);
+	unsigned n = r->req_type >= 0 && r->req_type < 256 ? ++wl_seen[set][r->req_type] : 1;
+
+	if (wl_said < WL_SAY && (n <= 4 || n % 100 == 0)) {
+		wl_said++;
+		proc_selfname(who, sizeof(who));
+		printf("SWEET A80211: %s %s %d (%s) value %d, %u bytes -> %d%s (#%u)\n", who, set ? "sets" : "gets",
+		    r->req_type, wl_type_name(r->req_type), r->req_val, r->req_len, error,
+		    error == EOPNOTSUPP ? " (not built)" : "", n);
+	}
+	return error;
+}
+
+/* ---- en0 ---- */
+
+static errno_t
+wl_output(ifnet_t ifp, mbuf_t m)
+{
+	wl_dropped++;                           /* no transmit path yet */
+	ifnet_stat_increment_out(ifp, 0, 0, 1);
+	mbuf_freem(m);
+	return 0;
+}
+
+static errno_t
+wl_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+		ifnet_set_flags(ifp, (ifnet_flags(ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+		return 0;
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {                  /* IEEE 802.11: how IO80211.framework tells a radio */
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = cmd == SIOCGIFMEDIA64 ? ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		int media = IFM_IEEE80211 | IFM_AUTO;
+		int error = 0;
+
+		ifmr->ifm_current = ifmr->ifm_active = media;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID;  /* not associated: no IFM_ACTIVE */
+		if (list != USER_ADDR_NULL && ifmr->ifm_count > 0) {
+			error = copyout(&media, list, sizeof(media));
+		}
+		ifmr->ifm_count = 1;
+		return error;
+	}
+	case SIOCSA80211:
+	case SIOCGA80211:
+		return wl_a80211(cmd, data);
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+/* sweet_mss_probe(), mss>=9: before launchd, so wifid and configd find both on their first look */
+void
+sweet_wlan_attach(void)
+{
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = "sweet-wlan",
+		.uniqueid_len = sizeof("sweet-wlan") - 1,
+		.name = "en",
+		.unit = 0,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = IFNET_SUBFAMILY_WIFI,
+		.type = IFT_ETHER,
+		.output = wl_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = wl_ioctl,
+		.broadcast_addr = etherbroadcastaddr,
+		.broadcast_len = ETHER_ADDR_LEN,
+	};
+	bool adt;
+
+	if (wl_ifp != NULL) {
+		return;
+	}
+	adt = SweetWLANAdtMac(sweet_wlan_mac);
+	if (ifnet_allocate_extended(&init, &wl_ifp) != 0) {
+		printf("SWEET WLAN: en0: ifnet_allocate failed\n");
+		wl_ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(wl_ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(wl_ifp, ETHER_HDR_LEN);
+	ifnet_set_mtu(wl_ifp, ETHERMTU);
+	ifnet_set_baudrate(wl_ifp, 54000000);
+	ifnet_set_flags(wl_ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(wl_ifp, NULL) != 0) {
+		printf("SWEET WLAN: en0: ifnet_attach failed\n");
+		ifnet_release(wl_ifp);
+		wl_ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(wl_ifp, sweet_wlan_mac, ETHER_ADDR_LEN);
+	SweetWLANStart("en0", sweet_wlan_mac);
+	printf("SWEET WLAN: en0 attached (802.11 media, link down, no transmit), %s address%s\n",
+	    adt ? "/arm-io/wlan" : "fixed", adt ? "" : "; no /arm-io/wlan: launchd will not start wifid (ADT_WLAN=1)");
+}
