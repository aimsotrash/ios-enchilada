+	return wn_freq;
+}
+
+bool
+sweet_wlan_heard(unsigned want, struct sweet_wlan_bss *out, unsigned *age_ms)
+{
+	unsigned now = mss_now(), seen = 0;
+	bool found = false;
+
+	lck_mtx_lock(&wn_bss_lock);
+	for (unsigned i = 0; i < wn.nbss && !found; i++) {
+		if (now - wn.bss[i].seen_ms <= SWEET_WLAN_FRESH_MS && seen++ == want) {
+			*out = wn.bss[i];
+			*age_ms = now - wn.bss[i].seen_ms;
+			found = true;
+		}
+	}
+	lck_mtx_unlock(&wn_bss_lock);
+	return found;
+}
