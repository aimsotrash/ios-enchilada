+/*
+ * 0255: IOSurfaceLock for writing on a pool surface (SweetSurface.cpp trapLock, after the GPU
+ * wait). Notes the draw for zcAsyncOk, and while the surface is still on the panel with a flip
+ * away from it pending, waits (at most 50 ms) for the frame that takes that flip: CoreAnimation
+ * never draws into a surface the pipe still scans, without SwapEnd having to wait for it.
+ */
+void
+sweet_scanout_lock(SweetSurface *s)
+{
+	AppleCLCD *fb = sweet_fb_zc;
+	if (fb == NULL || s->scanoutPA == 0) {
+		return;
+	}
+	IOLockLock(fb->fMdpLock);
+	s->zcLocked = true;
+	if (fb->fZcOn && fb->fZcPend != NULL && s == fb->fZcHeld) {
+		uint64_t waits = sweet_fb_stat_wait;
+		const char *fail = fb->zcSettle(true);
+		sweet_fb_stat_lockwait += sweet_fb_stat_wait - waits;
+		if (fail != NULL) {
+			fb->zcFail(fail, true);         /* wait for the restore too: it is still on the panel */
+		}
+	}
+	IOLockUnlock(fb->fMdpLock);
+}
