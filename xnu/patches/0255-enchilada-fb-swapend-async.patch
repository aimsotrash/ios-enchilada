+/*
+ * 0255: finish an async flip. Once a frame has taken the flush to fZcPend, fZcHeld (the surface
+ * it replaced) is off the panel and let go of. wait: up to 50 ms for that frame (a flip, a write
+ * lock); without (the vsync tick) one look. NULL: done, or nothing pending, or (no wait) still
+ * within 50 ms of the flush; else why the flip failed, as 0251's checks after its wait.
+ * fMdpLock held.
+ */
+const char *
+AppleCLCD::zcSettle(bool wait)
+{
+	if (fZcPend == NULL) {
+		return NULL;
+	}
+	if (!(wait ? zcLatch() : zcTaken())) {
+		uint64_t limit;
+		nanoseconds_to_absolutetime((uint64_t)SWEET_ZC_LATCH_MS * NSEC_PER_MSEC, &limit);
+		if (!wait && mach_absolute_time() - fZcPendT <= limit) {
+			return NULL;
+		}
+		return sweet_fb_paused ? "shutdown or sleep began during the flip" : "the flush was not taken by a frame within 50 ms";
+	}
+	if (zcFaulted()) {
+		return "an SMMU fault register changed after the flip";
+	}
+	SweetSurface *old = fZcHeld;
+	fZcHeld = fZcPend;
+	fZcPend = NULL;
