+/* Is va mapped Normal write-back (MAIR 0xff) for the kernel? AT S1E1R reports, it cannot fault. */
+static bool
+sweet_va_writeback(uintptr_t va)
+{
+	boolean_t on = ml_set_interrupts_enabled(FALSE);
+	uint64_t par;
+	__asm__ volatile ("at s1e1r, %1\n\tisb\n\tmrs %0, par_el1" : "=r"(par) : "r"(va) : "memory");
+	ml_set_interrupts_enabled(on);
+	return (par & 1) == 0 && (par >> 56) == 0xff;
+}
+
+/*
+ * 0251: back a canvas-sized surface with a slot of the scanout pool (physical memory in the
+ * splash carve-out, below 4 GiB, which the display's source pipe can scan where CoreAnimation
+ * draws it). Mapped copyback like the IOBufferMemoryDescriptor surfaces it replaces (the
+ * kernel cleans it before each scan); the kernel alias is checked to really be write-back,
+ * since a device mapping would fault CoreAnimation's unaligned stores. Any failure leaves
+ * s->memory NULL and the surface gets ordinary memory.
+ */
+static void
+sweet_surface_use_scanout_pool(SweetSurface *s)
+{
+	uint64_t pa = sweet_scanout_take(s);
+	if (pa == 0) {
+		return;
+	}
+	s->memory = IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress)pa, s->allocSize, kIODirectionInOut);
+	s->scanoutPA = pa;
+	s->mapCache = kIOMapCopybackCache;
+	uintptr_t kva = s->memory != NULL ? s->kernelAddress() : 0;
+	static uint32_t told;
+	if (kva == 0 || !sweet_va_writeback(kva)) {
+		IOLog("SWEET SURF: scanout slot 0x%llx: kernel mapping %s; ordinary memory instead\n", pa,
+		    kva == 0 ? "failed" : "is not write-back");
+		OSSafeReleaseNULL(s->kernelMap);
+		OSSafeReleaseNULL(s->memory);
+		s->scanoutPA = 0;
+		sweet_scanout_give(pa);
+		return;
+	}
+	bzero((void *)kva, s->allocSize);       /* write-back: dc zva is fine here */
+	if (told++ < 8) {
+		IOLog("SWEET SURF: %ux%u surface in the scanout pool at 0x%llx (%u bytes, copyback)\n",
+		    s->width, s->height, pa, s->allocSize);
+	}
+}
