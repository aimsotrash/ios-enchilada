sweet: BT fake: zero-padded vendor command returns for bluetoothd, per-session tail log

boot35 (0272): BlueTool's boot script runs to the end (Write_RAM x ~840, Launch_RAM, device -s 115200,
bcm -B/-A/-N/-Q/-x/-s all answered), bluetoothd then opens its own POSIX H4 session (the "48 packets"
one) and aborts on packet 48: every bluetoothd crash report (SIGABRT, H4 reader thread 0x100067ae0 ->
0x100068bc0 -> 0x100069100 -> 0x100118af0 -> 0x100119954 -> 0x10012652c -> AssertFail 0x1000c0d90) is
_BCM_CreateMultiAdvInstParser (0x100126424): on status 0 it reads a 1-byte instance from the Command
Complete of VSC 0xfd48 (create multi-adv instance, sent at 0x10012dc04), which our status-only reply
does not have: "ByteStream_NumReadBytesAvail(*pBs) >= 1". launchd restarts bluetoothd every 10 s.

- vendor commands (OGF 0x3f) from any process but BlueTool: status 0 + 128 zero bytes, so BCM VSC
  parsers that read fixed fields find them and every count/length is 0; BlueTool keeps the
  status-only replies its firmware download already accepts (btfake=2 is unchanged)
- LE_Read_Maximum_Advertising_Data_Length (1650) and LE_Read_Number_of_Supported_Advertising_Sets (16)
- logging: Write_RAM and its replies are counted, not printed; connect/disconnect always printed with
  the process name and the Write_RAM/unlogged counts; a session that ran out of log budget prints
  its last 32 packets at disconnect (first 16 such sessions per boot)

--- a/bsd/dev/sweet_bt.c	2026-11-05 11:58:18.445768377 -0800
+++ b/bsd/dev/sweet_bt.c	2026-11-05 11:59:42.090644963 -0800
@@ -25,6 +25,9 @@
  *
  * Log lines "SWEET BT: uN rx <hex>" (a complete H4 packet the host wrote to unit N) and
  * "uN tx <hex>" (one it reads back), first 64 bytes, BT_LOG_LINES lines per boot, then counts.
+ * Firmware Write_RAM (0xfc4c) and its replies are only counted. Connect and disconnect lines
+ * (with the process name) are always printed; a session that lost lines to the budget also
+ * prints its last BT_RING packets ("uN tail <seq> rx|tx <hex>", 24 bytes) at disconnect.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -49,9 +52,24 @@
 #define BT_LOG_BYTES    64
 #define BT_LOG_LINES    400
 #define BT_PKT_MAX      (4 + 255)       /* an H4 command: type, opcode, length, parameters */
+#define BT_RING         32              /* last packets of a session, printed at disconnect */
+#define BT_RING_BYTES   24
+#define BT_TAIL_DUMPS   16              /* sessions whose tail is printed, per boot */
+/*
+ * Zero return parameters after status 0 for vendor commands from anyone but BlueTool:
+ * bluetoothd's BCM VSC parsers read their fields without looking at the event length
+ * (_BCM_CreateMultiAdvInstParser, 0xfd48, asserted "ByteStream_NumReadBytesAvail(*pBs) >= 1"
+ * and aborted bluetoothd). Zero counts and lengths keep every list empty.
+ */
+#define BT_VSC_PAD      128
 
 _Static_assert(sizeof(struct user_termios) == 72, "TIOCGETA from a 64-bit process");
 
+struct bt_rec {
+	uint8_t         tx, len;        /* direction, bytes kept */
+	uint8_t         b[BT_RING_BYTES];
+};
+
 struct bt_unit {
 	u_int32_t       unit;
 	struct user_termios tio;
@@ -59,6 +77,13 @@
 	uint32_t        have;           /* bytes in pkt[] */
 	uint32_t        skip;           /* data packet payload still to drop */
 	uint32_t        rx, tx;         /* packets */
+	char            who[MAXCOMLEN + 1];
+	bool            pad;            /* not BlueTool: pad vendor command returns */
+	bool            hush;           /* current packet is a Write_RAM (or its reply): not printed */
+	uint32_t        wram;           /* Write_RAM (0xfc4c) commands */
+	uint32_t        quiet;          /* packets not printed for lack of log budget */
+	uint32_t        nrec;           /* packets recorded in ring[] (total, ring index = nrec % BT_RING) */
+	struct bt_rec   ring[BT_RING];
 };
 
 /* One lock for the parser, the log budget and every unit (one host at a time in practice). */
@@ -84,20 +109,35 @@
