+/* bcm-voter.c bcm_div: round a non-zero vote below one unit up to 1. */
+static uint64_t
+rh_bcm_div(uint64_t num, uint64_t base)
+{
+	return (num && num < base) ? 1 : num / base;
+}
+
+/*
+ * 0241: the apps DRV's DDR bandwidth vote, as Linux's sdm845 interconnect
+ * driver sends it for a 7216000 kBps peak (opp-peak-kBps of the 675/710 MHz GPU
+ * OPPs and the top CPU OPPs, the largest sdm845.dtsi asks for). CPU path
+ * acm_l3 -> qns_gnoc_memnoc -> qnm_apps (SH5) -> qns_llcc (SH0) -> llcc_mc ->
+ * ebi (MC0, ACV); the GPU path qxm_gpu -> qns_llcc -> ebi adds no BCM. Per BCM
+ * (bcm_aggregate, peak only, avg 0 as the OPP votes): vote_y = peak * width /
+ * node buswidth * 1000 / unit, width and unit from cmd-db, clamped to 0x3fff;
+ * ACV sends its enable mask BIT(3). Commands go in VCD order with commit, wait
+ * and a response on the last BCM of each VCD (tcs_list_gen), in one ACTIVE TCS.
+ * SDM845 only (rpmhrsc=0x179e0000); ddrbw=0 skips it. Only raises: the BCM
+ * takes the highest vote of all DRVs.
+ */
+int
+sweet_rpmh_ddr_vote(void)
+{
+	static const struct { const char *name; uint32_t buswidth; } bcm[RH_MAX_CMDS] = {
+		{ "SH5", 32 }, { "SH0", 16 }, { "MC0", 4 }, { "ACV", 0 },   /* 0: enable mask */
+	};
+	const uint64_t peak_kbps = 7216000;
+	uint32_t a[RH_MAX_CMDS], v[RH_MAX_CMDS], vcd[RH_MAX_CMDS];
+	uint32_t addr[RH_MAX_CMDS], data[RH_MAX_CMDS], msgid[RH_MAX_CMDS], wait = 0;
+	unsigned order[RH_MAX_CMDS];
+	int on = 1, error = EIO;
+
+	(void)PE_parse_boot_argn("ddrbw", &on, sizeof(on));
+	if (!on) {
+		printf("SWEET RPMH: DDR vote off (ddrbw=0)\n");
+		return 0;
+	}
+	rh_bases();
+	if (rh_rsc_pa != 0x179e0000u || rh_tcs_pa != 0x179e0d00u) {
+		printf("SWEET RPMH: DDR vote is SDM845-only (rsc %#x tcs %#x); not sent\n", rh_rsc_pa, rh_tcs_pa);
+		return ENODEV;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	for (unsigned i = 0; !error && i < RH_MAX_CMDS; ++i) {
+		uint32_t off = 0, len = 0;
+		uint8_t b[8];
+		error = rh_lookup(bcm[i].name, RH_BCM, &a[i], &off, &len);
+		if (error) {
+			break;
+		}
+		if (len < 8) {
+			printf("SWEET RPMH: %s aux data %u bytes; refusing\n", bcm[i].name, len);
+			error = EINVAL;
+			break;
+		}
+		for (unsigned k = 0; k < 8; ++k) {
+			b[k] = (uint8_t)(rh_read(rh_db, (off + k) & ~3u) >> (8u * ((off + k) & 3u)));
+		}
+		uint32_t unit = b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+		uint32_t width = b[4] | (uint32_t)b[5] << 8;
+		uint64_t y = 8;   /* ACV: BIT(3) */
+		vcd[i] = b[6];
+		if (bcm[i].buswidth) {
+			if (!unit || !width) {
+				printf("SWEET RPMH: %s unit %u width %u; refusing\n", bcm[i].name, unit, width);
+				error = EINVAL;
+				break;
+			}
+			y = rh_bcm_div(rh_bcm_div(peak_kbps * width, bcm[i].buswidth) * 1000, unit);
+		}
+		v[i] = y > 0x3fff ? 0x3fff : (uint32_t)y;
+		printf("SWEET RPMH: DDR BCM %s addr %#x unit %u width %u vcd %u: vote_y %llu%s\n",
+		    bcm[i].name, a[i], unit, width, vcd[i], (unsigned long long)y,
+		    y > 0x3fff ? " (clamped to 0x3fff)" : "");
+	}
+	if (error) {
+		printf("SWEET RPMH: DDR vote not sent\n");
+		goto out;
+	}
+	/* list_sort(cmp_vcd): stable by VCD. */
+	for (unsigned i = 0; i < RH_MAX_CMDS; ++i) {
+		unsigned j = i;
+		for (; j > 0 && vcd[order[j - 1]] > vcd[i]; --j) {
+			order[j] = order[j - 1];
+		}
+		order[j] = i;
+	}
+	for (unsigned c = 0; c < RH_MAX_CMDS; ++c) {
+		unsigned i = order[c];
+		bool commit = c + 1 == RH_MAX_CMDS || vcd[order[c + 1]] != vcd[i];
+		addr[c] = a[i];
+		data[c] = (commit ? 1u << 30 : 0) | (1u << 29) | v[i];   /* BCM_TCS_CMD(commit, valid, 0, y) */
+		msgid[c] = commit ? RH_WRITE_ACK : RH_WRITE;
+		wait |= commit ? 1u << c : 0;
+		printf("SWEET RPMH: DDR vote cmd%u %s addr %#x data %#x%s\n", c, bcm[i].name, addr[c],
+		    data[c], commit ? " (commit)" : "");
+	}
+	error = rh_send(RH_MAX_CMDS, addr, data, msgid, wait, "DDR BCMs, 7216000 kBps peak");
+	printf("SWEET RPMH: DDR bandwidth vote %s (errno %d)\n",
+	    error ? "FAILED" : "complete, commits acknowledged", error);
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
