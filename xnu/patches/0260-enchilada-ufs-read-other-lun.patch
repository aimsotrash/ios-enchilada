 {
 	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
 	int error = ufs_read_blocks(1, 1);
@@ -348,14 +348,73 @@
 		if (last < first) {
 			return ENXIO;
 		}
-		su.first_block = first;
-		su.nblocks = last - first + 1;
