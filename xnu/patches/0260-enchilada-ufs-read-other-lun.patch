 }
 
+/*
+ * 0260: read-only access to one partition on another LUN, for the modem firmware (sweet_mss.c
+ * reads modem_a on LUN 4, as topaz 0115 does). su.lun is switched only while sweet_ufs_lock is
+ * held and restored before it is dropped; every write (strategy, sweetlog) takes the same lock,
+ * so no write can reach another LUN, and this path issues READ(10) only. That partition's bounds
+ * live here; the root partition's (su.first_block/nblocks, the write fence) are not touched.
+ */
+int sweet_ufs_read_part(unsigned lun, const char *name, uint64_t off, void *dst, uint32_t len);
+
+int
+sweet_ufs_read_part(unsigned lun, const char *name, uint64_t off, void *dst, uint32_t len)
+{
+	static char part[37];
+	static unsigned part_lun;
+	static uint64_t part_first, part_blocks;
+	int error = 0;
+
+	if (!su.ready) {
+		return EAGAIN;
+	}
+	if (lun > 7 || strlen(name) >= sizeof(part)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	uint8_t saved = su.lun;
+	su.lun = (uint8_t)lun;
+	if (part_lun != lun || strcmp(part, name) != 0) {
+		static const uint8_t tur[6] = { 0x00 };
+		/* as at init: the first command to a LUN may report a unit attention */
+		for (int i = 0; i < 3 && ufs_scsi(tur, sizeof(tur), 0, false); i++) {
+		}
+		part[0] = '\0';
+		error = ufs_find_partition(name, &part_first, &part_blocks);
+		if (!error) {
+			strlcpy(part, name, sizeof(part));
+			part_lun = lun;
+			printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu blocks, read-only\n",
+			    name, lun, part_first, part_blocks);
+		}
+	}
+	uint64_t bytes = part_blocks * UFS_BLOCK;
+	if (!error && (off > bytes || len > bytes - off)) {
+		error = EINVAL;
+	}
+	for (uint32_t done = 0; !error && done < len;) {
+		uint64_t pos = off + done;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t n = MIN(len - done, BOUNCE_SIZE - skip);
+		error = ufs_read_blocks(part_first + pos / UFS_BLOCK, (skip + n + UFS_BLOCK - 1) / UFS_BLOCK);
+		if (!error) {
+			memcpy((uint8_t *)dst + done, (const uint8_t *)(su.dma + DMA_BOUNCE) + skip, n);
+			done += n;
+		}
+	}
+	su.lun = saved;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
+
 static int
 ufs_take_over_host(void)
 {
