+/* ---- DCVS (0240): the v1 perf and bandwidth tables, then a GPU level --- */
+
+/*
+ * a6xx_gmu_rpmh_arc_votes_init: the first primary index at or above the VLVL;
+ * the first mx index at or above it, else the highest non-zero one (then
+ * *sec_ok is false). Unused table entries read as 0.
+ */
+static bool
+gpu_arc_vote(const uint16_t *pri, const uint16_t *sec, uint32_t vlvl, uint32_t *vote, bool *sec_ok)
+{
+	unsigned p = 0, s = 0, j;
+
+	while (p < 16 && pri[p] < vlvl) {
+		p++;
+	}
+	if (p == 16) {
+		return false;
+	}
+	for (j = 0; j < 16; j++) {
+		if (sec[j] >= vlvl) {
+			s = j;
+			break;
+		}
+		if (sec[j]) {
+			s = j;
+		}
+	}
+	*sec_ok = j < 16;
+	*vote = ((uint32_t)pri[p] << 16) | (s << 8) | p;
+	return true;
+}
+
+/*
+ * a6xx_hfi_start_v1 sends PERF_TABLE and BW_TABLE between FW_VERSION and TEST
+ * (after TEST the GMU takes no more HFI messages). gpulvl=N picks the perf
+ * index raised to later: 2..7, 0 = tables only, 1 = neither tables nor DCVS
+ * (the boot level, as before 0240). Default: the highest level whose VLVL both
+ * gfx.lvl and mx.lvl hold exactly.
+ */
+static void
+gpu_dcvs_tables(void)
+{
+	uint16_t gfx[16], mx[16], cx[16];
+	uint32_t a = 0, gx_votes[8], cx_votes[3], m[160];
+	int want = -1, top = -1;
+	bool sec_ok = false;
+
+	(void)PE_parse_boot_argn("gpulvl", &want, sizeof(want));
+	if (want == 1 || want < -1 || want > 7) {
+		printf("SWEET GPU: DCVS off (gpulvl=%d): no perf/bw table, boot level only\n", want);
+		return;
+	}
+	if (gpu_cmddb_lookup("gfx.lvl", &a, gfx, 16) != (int)GPU_CMDDB_SLAVE_ARC ||
+	    gpu_cmddb_lookup("mx.lvl", &a, mx, 16) != (int)GPU_CMDDB_SLAVE_ARC ||
+	    gpu_cmddb_lookup("cx.lvl", &a, cx, 16) != (int)GPU_CMDDB_SLAVE_ARC) {
+		printf("SWEET GPU: DCVS off: gfx/mx/cx.lvl not all in the command DB\n");
+		return;
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		if (!gpu_arc_vote(gfx, mx, gpu_levels[i].vlvl, &gx_votes[i], &sec_ok)) {
+			printf("SWEET GPU: DCVS off: VLVL %u (%u MHz) above gfx.lvl\n",
+			    gpu_levels[i].vlvl, gpu_levels[i].mhz);
+			return;
+		}
+		if (i >= 2 && sec_ok && (gx_votes[i] >> 16) == gpu_levels[i].vlvl) {
+			top = (int)i;
+		}
+		printf("SWEET GPU: DCVS table %u: %u MHz VLVL %u vote %#x (gfx %u, mx %u%s)\n", i,
+		    gpu_levels[i].mhz, gpu_levels[i].vlvl, gx_votes[i], gx_votes[i] & 0xffu,
+		    (gx_votes[i] >> 8) & 0xffu, sec_ok ? "" : ", highest mx");
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		if (!gpu_arc_vote(cx, mx, gpu_gmu_levels[i].vlvl, &cx_votes[i], &sec_ok)) {
+			printf("SWEET GPU: DCVS off: GMU VLVL %u above cx.lvl\n", gpu_gmu_levels[i].vlvl);
+			return;
+		}
+	}
+	if (want < 0 && top < 0) {
+		printf("SWEET GPU: DCVS off: no level above 257 MHz has exact gfx and mx corners\n");
+		return;
+	}
+
+	bzero(m, sizeof(m));
+	m[0] = HFI_QMARK_HDR(HFI_H2F_PERF_TBL, 43, 0);   /* a6xx_hfi_msg_perf_table_v1 */
+	m[1] = 8;
+	m[2] = 3;
+	for (unsigned i = 0; i < 8; i++) {
+		m[3 + 2 * i] = gx_votes[i];
+		m[4 + 2 * i] = gpu_levels[i].mhz * 1000u;    /* kHz */
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		m[35 + 2 * i] = cx_votes[i];                 /* cx_votes[] after 16 gx levels */
+		m[36 + 2 * i] = gpu_gmu_levels[i].mhz * 1000u;
+	}
+	if (gpu_hfi_send(m, 43, "perf table") != (int)HFI_H2F_PERF_TBL) {
+		printf("SWEET GPU: DCVS off: perf table not acknowledged\n");
+		return;
+	}
+	/* a6xx_build_bw_table (a630): one "off" DDR level, the fixed CNOC votes; the
+	 * a630 GMU does no bus scaling. */
+	bzero(m, sizeof(m));
+	m[0] = HFI_QMARK_HDR(HFI_H2F_BW_TBL, 160, 0);
+	m[1] = 1;                       /* bw_level_num */
+	m[2] = 3;                       /* cnoc_cmds_num */
+	m[3] = 3;                       /* ddr_cmds_num */
+	m[4] = 0x05;                    /* cnoc_wait_bitmask */
+	m[5] = 0x07;                    /* ddr_wait_bitmask */
+	m[6] = 0x50034;                 /* cnoc_cmds_addrs[6] at 6 */
+	m[7] = 0x5007c;
+	m[8] = 0x5004c;
+	m[12] = 0x40000000;             /* cnoc_cmds_data[0][6] at 12 */
+	m[14] = 0x40000000;
+	m[18] = 0x60000001;             /* cnoc_cmds_data[1][6] at 18 */
+	m[19] = 0x20000001;
+	m[20] = 0x60000001;
+	m[24] = 0x50000;                /* ddr_cmds_addrs[8] at 24 */
+	m[25] = 0x5005c;
+	m[26] = 0x5000c;
+	m[32] = 0x40000000;             /* ddr_cmds_data[0][8] at 32 */
+	m[33] = 0x40000000;
+	m[34] = 0x40000000;
+	if (gpu_hfi_send(m, 160, "bw table") != (int)HFI_H2F_BW_TBL) {
+		printf("SWEET GPU: DCVS off: bw table not acknowledged\n");
+		return;
+	}
+	gpu_dcvs_level = want < 0 ? top : want;
+	printf("SWEET GPU: DCVS tables acknowledged; level %d to follow (%s)\n", gpu_dcvs_level,
+	    want < 0 ? "default" : "gpulvl");
+}
+
+/* a6xx_gmu_set_freq, legacy path: perf index, BW index 0xff (firmware's pick), OOB DCVS_SET. */
+static void
+gpu_dcvs_set(vm_offset_t gmu)
+{
+	unsigned n = (unsigned)gpu_dcvs_level;
+	uint32_t ack = 1u << (GPU_OOB_DCVS_SET + 24), info = 0;
+	bool ok = false;
+
+	if (gpu_dcvs_level < 2) {
+		if (gpu_dcvs_level == 0) {
+			printf("SWEET GPU: DCVS tables only (gpulvl=0): level left at the boot level\n");
+		}
+		return;
+	}
+	gpu_wr_quiet(gmu, GPU_GMU_DCVS_ACK_OPTION, 0);
+	gpu_wr_quiet(gmu, GPU_GMU_DCVS_PERF, (3u << 28) | n);
+	gpu_wr_quiet(gmu, GPU_GMU_DCVS_BW, 0xffu);
+	gpu_wr_quiet(gmu, GPU_GMU_HOST2GMU_SET, 1u << (GPU_OOB_DCVS_SET + 16));
+	for (int i = 0; i < 100; i++) {
+		info = gpu_rd_quiet(gmu, GPU_GMU_GMU2HOST_INFO);
+		if (info & ack) {
+			ok = true;
+			break;
+		}
+		gpu_wait_ms(1);
+	}
+	gpu_wr_quiet(gmu, GPU_GMU_GMU2HOST_CLR, ack);
+	gpu_wr_quiet(gmu, GPU_GMU_HOST2GMU_SET, ack);     /* a6xx_gmu_clear_oob, legacy bit */
+	uint32_t ret = gpu_rd_quiet(gmu, GPU_GMU_DCVS_RETURN);
+	printf("SWEET GPU: DCVS level %u (%u MHz, bw idx %u): %s (oob %s, DCVS_RETURN %#x, INTR_INFO %#x)\n",
+	    n, gpu_levels[n].mhz, 0xffu, ok && ret == 0 ? "acked" : "failed",
+	    ok ? "acked" : "TIMED OUT", ret, info);
+}
+
