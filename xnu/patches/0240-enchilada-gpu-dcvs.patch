 			printf("SWEET GPU: hfi firmware version exchange %s (firmware %u.%u)\n",
 			    id == 1 ? "ok" : "failed", 0x10070000u >> 24, (0x10070000u >> 16) & 0xffu);
+			if (id == 1) {
+				gpu_dcvs_tables();
+			}
