+/*
+ * 0258: a BO's pages are entered with one SMMU TLB invalidate after the last PTE instead of one
+ * per 4 KiB page. Each invalidate is two context-bank TLBIALLs and the global one, each polled
+ * over MMIO: 3392 of them for every 1125x2436 display surface, and CoreAnimation's OpenGL ES
+ * renderer makes a new one of those every frame (boots 24/27: ~95 ms "before it for the
+ * IOSurfaces" a frame with SURFACE_BO, ~20 ms in boot 22 where the import was refused).
+ * boot-arg sweetgputlbi=1: one invalidate per page, as before.
+ */
+static int gTlbiEach = -1;
+
+static bool
+tlbiEach(void)
+{
+	if (gTlbiEach < 0) {
+		uint32_t each = 0;
+		(void)PE_parse_boot_argn("sweetgputlbi", &each, sizeof(each));
+		gTlbiEach = each != 0;
+		IOLog("SWEET GPU: BO mapping: %s (sweetgputlbi=%u)\n",
+		    gTlbiEach ? "a TLB invalidate after every 4 KiB page" : "one TLB invalidate per BO", each);
+	}
+	return gTlbiEach != 0;
+}
+
+static bool
+vmMapPage(uint64_t iova, uint64_t pa, bool ro)
+{
+	return tlbiEach() ? sweet_gpu_vm_map(iova, pa, ro) : sweet_gpu_vm_map_nosync(iova, pa, ro);
+}
