+/*
+ * 0258: the PTE only, no TLB invalidate. A caller that enters many pages (SweetAdreno's mapGem:
+ * 3392 for a 1125x2436 display surface) calls sweet_gpu_vm_sync() once after the last one;
+ * nothing can use the new range before that call returns (the GPU only sees an iova once a
+ * later SUBMIT names it, and that takes the same lock).
+ */
 bool
-sweet_gpu_vm_map(uint64_t iova, uint64_t pa, bool readonly)
+sweet_gpu_vm_map_nosync(uint64_t iova, uint64_t pa, bool readonly)
 {
 	if (!gpu_live || !gpu_va_to_local(iova, 0x1000, NULL)) {
 		return false;
@@ -1956,8 +1962,27 @@
 	l3[(iova >> 12) & 0x1ff] = (pa & ~0xfffull) | GPU_PTE_PAGE |
 	    (readonly ? (1ull << 7) : 0ull);
 	gpu_pte_clean((vm_offset_t)&l3[(iova >> 12) & 0x1ff], 8);
+	return true;
+}
+
+/* 0258: make the PTEs written so far visible to the GPU: barrier, then the full invalidate. */
+void
+sweet_gpu_vm_sync(void)
+{
+	if (!gpu_live) {
+		return;
+	}
 	__asm__ volatile("dsb sy" ::: "memory");
 	gpu_tlb_invalidate();
+}
+
+bool
+sweet_gpu_vm_map(uint64_t iova, uint64_t pa, bool readonly)
+{
+	if (!sweet_gpu_vm_map_nosync(iova, pa, readonly)) {
+		return false;
+	}
+	sweet_gpu_vm_sync();
 	return true;
 }
 
