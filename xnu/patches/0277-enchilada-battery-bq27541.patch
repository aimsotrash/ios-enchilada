+/*
+ * 0277: OnePlus 6 fuel gauge, TI bq27541 at 0x55 on SE10 (downstream dtbo
+ * "ti,bq27541-battery"; mainline sdm845-oneplus-common.dtsi says "ti,bq27411").
+ * Linux bq27xxx_battery.c register maps (bq27541_regs, and bq27421_regs which
+ * "ti,bq27411" uses): mV, mA (s16, + = charging), mAh, 0.1 K; bq27411 has no
+ * CycleCount; DesignCapacity 0x3c in both. The variant is chosen by which map
+ * reads plausibly; Control() DEVICE_TYPE would need a subcommand WRITE.
+ */
+struct BqMap {
+	const char *name;
+	uint8_t temp, volt, flags, avgCurrent, soc, fcc, rm, cycles;
+};
+static const BqMap kBqMaps[] = {
+	{"bq27541", 0x06, 0x08, 0x0a, 0x14, 0x2c, 0x12, 0x10, 0x2a},
+	{"bq27411", 0x02, 0x04, 0x06, 0x10, 0x1c, 0x0e, 0x0c, 0x00},
+};
+
+static bool
+bqPlausible(uint16_t t, uint16_t mv, uint16_t soc)
+{
+	return mv >= 3000 && mv <= 4500 && soc <= 100 && t >= 2330 && t <= 3730; /* -40..100 C */
+}
+
+int
+SweetBattery::detectGauge(const char **why)
+{
+	uint16_t t[2] = {0, 0}, v[2] = {0, 0}, soc[2] = {0, 0}, dcap = 0;
+	int map = -1, err = 0;
+	for (int i = 0; i < 2; ++i) {
+		const BqMap &m = kBqMaps[i];
+		int e;
+		if ((e = sweet_bq_read(m.temp, &t[i])) || (e = sweet_bq_read(m.volt, &v[i])) ||
+		    (e = sweet_bq_read(m.soc, &soc[i]))) {
+			err = e;
+			if (e == ENODEV) {
+				return e;
+			}
+		} else if (bqPlausible(t[i], v[i], soc[i])) {
+			map = map == -1 ? i : -3;
+		}
+	}
+	(void)sweet_bq_read(0x3c, &dcap);
+	static bool logged; /* the raw words are the variant evidence; once */
+	if (!logged && (map >= 0 || !err)) {
+		logged = true;
+		IOLog("SWEET BATT: SE10 0x55 T/V/SOC 06/08/2c = %u/%u/%u, 02/04/1c = %u/%u/%u, "
+		    "3c = %u -> %s\n", t[0], v[0], soc[0], t[1], v[1], soc[1], dcap,
+		    map >= 0 ? kBqMaps[map].name : map == -3 ? "ambiguous" : "no plausible map");
+	}
+	if (map < 0) {
+		*why = map == -3 ? "variant detection (both maps plausible)" :
+		    err ? "probe read" : "variant detection (no plausible map)";
+		return err ? err : EINVAL;
+	}
+	fBqMap = map;
+	if (dcap >= 1000 && dcap <= 10000) {
+		fDesign = dcap; /* DesignCapacity -> DesignCapacity / battery health */
+	}
+	return 0;
+}
+
+int
+SweetBattery::readGauge(const char **why)
+{
+	const BqMap &m = kBqMaps[fBqMap];
+	uint16_t t, v, flags, ai, soc, fcc, rm, cyc = 0;
+	int err;
+	if ((err = sweet_bq_read(m.temp, &t)) || (err = sweet_bq_read(m.volt, &v)) ||
+	    (err = sweet_bq_read(m.flags, &flags)) || (err = sweet_bq_read(m.avgCurrent, &ai)) ||
+	    (err = sweet_bq_read(m.soc, &soc)) || (err = sweet_bq_read(m.fcc, &fcc)) ||
+	    (err = sweet_bq_read(m.rm, &rm)) || (m.cycles && (err = sweet_bq_read(m.cycles, &cyc)))) {
+		*why = "I2C read";
+		return err;
+	}
+	if (!bqPlausible(t, v, soc) || fcc < 500 || fcc > 10000) {
+		*why = "sample range check";
+		return EINVAL;
+	}
+	fBqMv = v;
+	fBqMa = (int16_t)ai;
+	fBqDeciC = (int)t - 2731;
+	fBqSoc = soc < 1 ? 1 : soc; /* 0 % could make powerd shut down on a glitch */
+	fFcc = fcc;
+	fRm = rm > fcc ? fcc : rm;
+	fCycles = cyc;
+	fBqFlags = flags;
+	return 0;
+}
+
+/* Each full poll (30 s or a cable change). Errors back off 1, 2, 4 .. 32 polls;
+ * the last good sample is kept for 5 minutes, then the 0275 estimate is used. */
+bool
+SweetBattery::pollGauge(void)
+{
+	bool held = fBqHave && fTicks - fBqTick < 150;
+	if (fBqMap == -2) {
+		return false;
+	}
+	if (fBqSkip) {
+		--fBqSkip;
+		return held;
+	}
+	const char *why = "read";
+	int err = fBqMap < 0 ? detectGauge(&why) : 0;
+	if (!err) {
+		err = readGauge(&why);
+	}
+	if (!err) {
+		if (!fBqHave) {
+			IOLog("SWEET BATT: %s at SE10 0x55: SOC %u%% FCC %u mAh RM %u mAh cycles %u "
+			    "V %d mV I %d mA T %d dC (flags %#x, design %u mAh)\n", kBqMaps[fBqMap].name,
+			    fBqSoc, fFcc, fRm, fCycles, fBqMv, fBqMa, fBqDeciC, fBqFlags, fDesign);
+		} else if (fBqFails) {
+			IOLog("SWEET BATT: gauge back after %u failed polls, SOC %u%%\n", fBqFails, fBqSoc);
+		}
+		putNumber("SweetBatteryGaugeFlags", fBqFlags);
+		fBqHave = true;
+		fBqTick = fTicks;
+		fBqFails = fBqBackoff = 0;
+		return true;
+	}
+	if (err == ENODEV) {
+		fBqMap = -2;
+		IOLog("SWEET BATT: bq27541 unavailable for this boot (SWEET BATT SE10 lines say why); "
+		    "voltage estimate\n");
+		return false;
+	}
+	if (fBqFails++ == 0 && fTicks - fBqLogTick >= 300) {
+		IOLog("SWEET BATT: bq27541 %s failed (err %d); %s, backing off\n", why, err,
+		    held ? "holding the last sample" : "voltage estimate");
+		fBqLogTick = fTicks;
+	}
+	fBqBackoff = fBqBackoff ? (fBqBackoff < 32 ? 2 * fBqBackoff : 32) : 1;
+	fBqSkip = fBqBackoff;
+	return held;
+}
