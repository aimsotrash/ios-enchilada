+/* ------------------------------------------------- 0277: enchilada fuel gauge */
+
+/*
+ * OnePlus 6 TI bq27541 at 0x55 on QUPv3 SE10 (downstream qupv3_se10_i2c,
+ * i2c@a88000 = wrapper 1 SE2; mainline sdm845.dtsi i2c10). Clock
+ * gcc_qupv3_wrap1_s2_clk: vote 0x5200c bit 24, CBCR 0x18274, RCG 0x18278
+ * (gcc-sdm845.c), plus wrap1 m/s AHB bits 20/21 as for SE12. Pins gpio55/56,
+ * TLMM NORTH, function qup10 (pinctrl-sdm845.c; DT qupv3_se10_i2c_active:
+ * 2 mA, bias-disable). 100 kHz (DT qcom,clk-freq-out). Every transfer is a
+ * one-byte register-pointer write and a repeated-START two-byte read: no
+ * Control() subcommand, no data flash, no other address on this bus (0x26 is
+ * the Dash MCU, 0x08/0x0c smb1355). Called only from SweetBattery's work loop.
+ */
+#define BQ_SE_PA        0x00a88000u
+#define BQ_GCC_CBCR     0x18274u
+#define BQ_GCC_RCG      0x18278u
+#define BQ_VOTE_MASK    ((1u << 20) | (1u << 21) | (1u << 24))
+#define BQ_ADDR         0x55u
+#define BQ_GPIO_SDA     55u
+#define BQ_GPIO_SCL     56u
+
+static struct touch_state bq = { .name = "BATT SE10" };
+static int bq_ready;    /* 0 untried, 1 ready, -1 unavailable for this boot */
+
+static bool
+bq_open(void)
+{
+	bq.gcc = ml_io_map(FJ_GCC_PA, 0x60000);
+	bq.gpio = ml_io_map(FJ_TLMM_NORTH, 0x80000);
+	bq.se = ml_io_map(BQ_SE_PA, 0x4000);
+	if (!bq.gcc || !bq.gpio || !bq.se) {
+		printf("SWEET BATT SE10: MMIO mapping failed\n");
+		return false;
+	}
+	uint32_t sda = touch_rd(bq.gpio, TOUCH_GPIO_CFG(BQ_GPIO_SDA));
+	uint32_t scl = touch_rd(bq.gpio, TOUCH_GPIO_CFG(BQ_GPIO_SCL));
+	printf("SWEET BATT SE10: gpio55 cfg=%#x gpio56 cfg=%#x vote=%#x cbcr=%#x "
+	    "rcg=%#x cfg=%#x dfs=%#x\n", sda, scl, touch_rd(bq.gcc, FJ_GCC_VOTE),
+	    touch_rd(bq.gcc, BQ_GCC_CBCR), touch_rd(bq.gcc, BQ_GCC_RCG),
+	    touch_rd(bq.gcc, BQ_GCC_RCG + 4u), touch_rd(bq.gcc, BQ_GCC_RCG + 0x14u));
+	if (((sda >> 2) & 0xfu) != 1u || ((scl >> 2) & 0xfu) != 1u) {
+		/* Linux applies qupv3_se10_i2c_active at probe: qup10, 2 mA, no bias. */
+		touch_gpio_at(bq.gpio, BQ_GPIO_SDA, 1, 0, 0, false, false);
+		touch_gpio_at(bq.gpio, BQ_GPIO_SCL, 1, 0, 0, false, false);
+		printf("SWEET BATT SE10: gpio55/56 -> qup10 (cfg=%#x/%#x)\n",
+		    touch_rd(bq.gpio, TOUCH_GPIO_CFG(BQ_GPIO_SDA)),
+		    touch_rd(bq.gpio, TOUCH_GPIO_CFG(BQ_GPIO_SCL)));
+	}
+	return fajita_clocks(&bq, BQ_VOTE_MASK, BQ_GCC_CBCR, BQ_GCC_RCG) &&
+	       touch_se_init(&bq);
+}
+
+/* One 16-bit little-endian standard command. 0 = ok, ENODEV = SE10 unusable
+ * for this boot (already logged), anything else is a transient bus error. */
+int
+sweet_bq_read(uint8_t reg, uint16_t *out)
+{
+	uint8_t v[2];
+	if (bq_ready == 0) {
+		bq_ready = bq_open() ? 1 : -1;
+	}
+	if (bq_ready < 0 || bq.dead) {
+		return ENODEV;
+	}
+	delay(100); /* bus-free gap between gauge transactions (TI: >= 66 us) */
+	int err = geni_read(&bq, BQ_ADDR, reg, false, v, sizeof(v));
+	if (!err) {
+		*out = (uint16_t)(v[0] | (v[1] << 8));
+	}
+	return err;
+}
