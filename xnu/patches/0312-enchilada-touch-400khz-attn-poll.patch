 #define TOUCH_MAX        10u
+#define TS_BLIND_POLLS   4u     /* 0312: every 4th look reads the status without ATTN */
+static unsigned ts_poll_ms = 2; /* 0312: boot-arg sweetts_poll */
 #define TOUCH_GOODIX     1
 #define TOUCH_FTS        2
 /* GT9896 is Yellowstone in Xiaomi sweet-r-oss, not the Berlin protocol. */
@@ -102,6 +105,7 @@
