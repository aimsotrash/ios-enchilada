 	int x[TOUCH_MAX], y[TOUCH_MAX];
@@ -600,8 +604,14 @@
 	touch_wr(b->se, 0x24, 0x7f);
 	touch_wr(b->se, 0x20, 1);
 	touch_wr(b->se, SE_CLK_SEL, 0);
-	touch_wr(b->se, SE_MCLK, (7u << 4) | 1u);
-	touch_wr(b->se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	if (b->fast) {
+		/* 0312: 400 kHz (Linux i2c-qcom-geni, 19.2 MHz source: div 2, high 5, low 12, cycle 24) */
+		touch_wr(b->se, SE_MCLK, (2u << 4) | 1u);
+		touch_wr(b->se, SE_SCL, (5u << 20) | (12u << 10) | 24u);
+	} else {
+		touch_wr(b->se, SE_MCLK, (7u << 4) | 1u);
+		touch_wr(b->se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	}
 	/* Linux 8-bit I2C packing: MSB on the wire, LSB byte first in FIFO. */
 	touch_wr(b->se, 0x254, 0);
 	touch_wr(b->se, 0x260, SE_PACK0);
@@ -809,6 +819,19 @@
 
