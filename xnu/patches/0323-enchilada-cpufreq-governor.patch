 #define OSM_LUT_ROWS    40
 #define OSM_PERF_STATE  0x920
 
+/*
+ * 0323: boot-arg sweetcpufreq=2, a small governor. Every ~20 ms a kernel thread takes each cluster's
+ * busiest CPU's non-idle share of the window (recount idle time, sweet_cpu_idle_abs() in
+ * osfmk/kern/processor.c) and asks for the slowest full-core state at or above cur * util / 0.8
+ * (schedutil without frequency invariance), or the fastest one when util > 0.8. It steps down at
+ * most 2 states, and only after 3 windows in a row wanted less. L3 follows the faster cluster (as
+ * a share of that cluster's fastest state). sweet_cpufreq_boost() (touch reports, sweet_touch.c)
+ * holds all three domains at their fastest for 250 ms after the last call. The boost rows with
+ * fewer cores are never asked for. Every 10 s one line gives each domain's time share per MHz.
+ * Without the accounting, or with a domain disabled, it stays at the fastest state as =1 does.
+ */
+#define GOV_TICK_MS     20
+#define GOV_UP          800     /* permille busy: fastest state; also schedutil's 1.25 headroom */
+#define GOV_DOWN_WIN    3       /* windows in a row wanting less before a step down */
+#define GOV_DOWN_STEPS  2
+#define GOV_BOOST_MS    250
+#define GOV_LOG_S       10
+#define GOV_CPUS        8       /* cpus=8: cpu0-3 little, cpu4-7 big */
+
+extern "C" uint64_t sweet_cpu_idle_abs(int cpu);        /* osfmk/kern/processor.c, 0323 */
+
+static struct {
+	volatile uint32_t *r;           /* mapped once, by the first sweet_cpu_clocks() */
+	uint32_t enable, nlvl;
+	uint32_t mhz[OSM_LUT_ROWS];     /* per table row */
+	uint32_t lvl[OSM_LUT_ROWS];     /* the full-core rows, slowest first */
+} sweet_osm[3];                         /* l3, little, big */
+static bool sweet_gov_on;
+static uint64_t sweet_boost_until, sweet_boost_abs;    /* mach absolute time */
+static uint32_t sweet_boosts;
+
+extern "C" void sweet_cpufreq_boost(void);
+extern "C" void
+sweet_cpufreq_boost(void)
+{
+	uint64_t now;
+
+	if (!__atomic_load_n(&sweet_gov_on, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	now = mach_absolute_time();
+	if (__atomic_exchange_n(&sweet_boost_until, now + sweet_boost_abs, __ATOMIC_RELAXED) < now) {
+		__atomic_add_fetch(&sweet_boosts, 1, __ATOMIC_RELAXED);
+		thread_wakeup((event_t)&sweet_boost_until);     /* now, not at the next tick */
+	}
+}
+
+/* the slowest full-core state of domain d at or above mhz */
+static uint32_t
+sweet_cpufreq_level(unsigned d, uint32_t mhz)
+{
+	uint32_t k = 0;
+
+	while (k + 1 < sweet_osm[d].nlvl && sweet_osm[d].mhz[sweet_osm[d].lvl[k]] < mhz) {
+		k++;
+	}
+	return k;
+}
+
+static void
+sweet_cpufreq_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static const char *const name[3] = { "l3", "little", "big" };
+	static uint64_t idle_abs[GOV_CPUS], spent[3][OSM_LUT_ROWS];
+	uint32_t cur[3], below[3] = { 0, 0, 0 };
+	uint64_t last = mach_absolute_time(), log_at = last, log_abs;
+
+	nanoseconds_to_absolutetime((uint64_t)GOV_LOG_S * NSEC_PER_SEC, &log_abs);
+	for (int c = 0; c < GOV_CPUS; c++) {
+		idle_abs[c] = sweet_cpu_idle_abs(c);
+	}
+	for (unsigned d = 0; d < 3; d++) {
+		cur[d] = sweet_osm[d].nlvl - 1;         /* sweet_cpu_clocks() just asked for the fastest */
+	}
+	for (;;) {
+		(void)assert_wait_timeout((event_t)&sweet_boost_until, THREAD_UNINT, GOV_TICK_MS, NSEC_PER_MSEC);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+
+		uint64_t now = mach_absolute_time(), win = now - last;
+		uint32_t util[2] = { 0, 0 }, want[3], share = 0;
+		bool boost = now < __atomic_load_n(&sweet_boost_until, __ATOMIC_RELAXED);
+
+		if (win == 0) {
+			continue;
+		}
+		last = now;
+		for (int c = 0; c < GOV_CPUS; c++) {
+			uint64_t t = sweet_cpu_idle_abs(c), di = 0;
+			uint32_t u;
+
+			if (t > idle_abs[c] && t != UINT64_MAX) {
+				di = t - idle_abs[c];
+				idle_abs[c] = t;
+			}
+			u = di >= win ? 0 : (uint32_t)((win - di) * 1000 / win);
+			if (u > util[c >= 4]) {
+				util[c >= 4] = u;
+			}
+		}
+		for (unsigned d = 1; d < 3; d++) {
+			uint32_t top = sweet_osm[d].nlvl - 1, w = top, u = util[d - 1];
+
+			if (!boost && u <= GOV_UP) {
+				w = sweet_cpufreq_level(d, sweet_osm[d].mhz[sweet_osm[d].lvl[cur[d]]] * u / GOV_UP);
+			}
+			want[d] = cur[d];
+			if (w >= cur[d]) {
+				below[d] = 0;
+				want[d] = w;
+			} else if (++below[d] >= GOV_DOWN_WIN) {
+				below[d] = 0;
+				want[d] = cur[d] - (cur[d] - w < GOV_DOWN_STEPS ? cur[d] - w : GOV_DOWN_STEPS);
+			}
+			uint32_t s = sweet_osm[d].mhz[sweet_osm[d].lvl[want[d]]] * 1000 / sweet_osm[d].mhz[sweet_osm[d].lvl[top]];
+			share = s > share ? s : share;
+		}
+		want[0] = sweet_cpufreq_level(0, sweet_osm[0].mhz[sweet_osm[0].lvl[sweet_osm[0].nlvl - 1]] * share / 1000);
+		for (unsigned d = 0; d < 3; d++) {
+			spent[d][cur[d]] += win;
+			if (want[d] != cur[d]) {        /* the register only on a change */
+				cur[d] = want[d];
+				sweet_osm[d].r[OSM_PERF_STATE / 4] = sweet_osm[d].lvl[cur[d]];
+				__asm__ volatile("dsb sy" ::: "memory");
+			}
+		}
+		if (now - log_at >= log_abs) {
+			char line[400];
+			size_t used = 0;
+
+			for (unsigned d = 3; d-- > 0;) {
+				used += (size_t)snprintf(line + used, sizeof(line) - used, " %s", name[d]);
+				for (uint32_t k = 0; k < sweet_osm[d].nlvl; k++) {
+					uint32_t pct = (uint32_t)(spent[d][k] * 100 / (now - log_at));
+
+					if (pct > 0 && used < sizeof(line) - 16) {
+						used += (size_t)snprintf(line + used, sizeof(line) - used, " %u:%u%%",
+						    sweet_osm[d].mhz[sweet_osm[d].lvl[k]], pct);
+					}
+					spent[d][k] = 0;
+				}
+			}
+			IOLog("SWEET CPUFREQ: last %d s%s boosts %u\n", GOV_LOG_S, line,
+			    __atomic_exchange_n(&sweet_boosts, 0, __ATOMIC_RELAXED));
+			log_at = now;
+		}
+	}
+}
+
+/* sweetcpufreq=2: once all three domains are enabled (after SMP, 0311), start the governor */
+static void
+sweet_cpufreq_start(void)
+{
+	thread_t thread;
+	int c;
+
+	if (sweet_gov_on) {
+		return;
+	}
+	for (unsigned d = 0; d < 3; d++) {
+		if (sweet_osm[d].r == NULL || !(sweet_osm[d].enable & 1) || sweet_osm[d].nlvl == 0) {
+			IOLog("SWEET CPUFREQ: governor not started (domain %u enable %#x, %u states), fastest state kept\n",
+			    d, sweet_osm[d].enable, sweet_osm[d].nlvl);
+			return;
+		}
+	}
+	for (c = 0; c < GOV_CPUS && sweet_cpu_idle_abs(c) != UINT64_MAX; c++) {
+	}
+	if (c < GOV_CPUS) {
+		IOLog("SWEET CPUFREQ: governor not started (no idle accounting for cpu%d), fastest state kept\n", c);
+		return;
+	}
+	nanoseconds_to_absolutetime((uint64_t)GOV_BOOST_MS * NSEC_PER_MSEC, &sweet_boost_abs);
+	if (kernel_thread_start(sweet_cpufreq_thread, NULL, &thread) != KERN_SUCCESS) {
+		IOLog("SWEET CPUFREQ: governor thread not created, fastest state kept\n");
+		return;
+	}
+	thread_deallocate(thread);
+	__atomic_store_n(&sweet_gov_on, true, __ATOMIC_RELEASE);
+	IOLog("SWEET CPUFREQ: governor on: %d ms windows, max above %d%% busy, touch boost %d ms\n",
+	    GOV_TICK_MS, GOV_UP / 10, GOV_BOOST_MS);
+}
