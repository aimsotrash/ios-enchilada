+int
+sweet_rpmh_addr(const char *res, uint32_t *addr)
+{
+	int error = EIO;
+
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (!rh_poisoned) {
