+/* clk_rcg2_shared_ops set_rate on a running RCG (force enable, M/N/D, CFG, update, clear) */
+static bool
+bq_rcg_set(const struct bq_clk *c)
+{
+	uint32_t d = c->n, nm2 = 2u * (uint32_t)(c->n - c->m);
+	uint32_t cfg;
+
+	if (d < c->m) {
+		d = c->m;
+	}
+	if (d > nm2) {
+		d = nm2;
+	}
+	bq_wr(bq.gcc, RCG, bq_rd(bq.gcc, RCG) | RCG_ROOT_EN);
+	if (!bq_poll(bq.gcc, RCG, RCG_ROOT_OFF, 0, 500)) {
+		return BQ_STOP("s6 RCG stays off after force enable (cmd %#x)", bq_rd(bq.gcc, RCG));
+	}
+	bq_wr(bq.gcc, RCG_M, (bq_rd(bq.gcc, RCG_M) & ~0xffffu) | c->m);
+	bq_wr(bq.gcc, RCG_N, (bq_rd(bq.gcc, RCG_N) & ~0xffffu) | (~(uint32_t)(c->n - c->m) & 0xffffu));
+	bq_wr(bq.gcc, RCG_D, (bq_rd(bq.gcc, RCG_D) & ~0xffffu) | (~d & 0xffffu));
+	cfg = bq_rd(bq.gcc, RCG_CFG) & ~(0x1fu | (7u << 8) | (3u << 12) | (1u << 20));
+	bq_wr(bq.gcc, RCG_CFG, cfg | 1u | (6u << 8) | (2u << 12));     /* pre_div 1, GPLL0_OUT_EVEN, dual edge */
+	bq_wr(bq.gcc, RCG, bq_rd(bq.gcc, RCG) | RCG_UPDATE);
+	bool ok = bq_poll(bq.gcc, RCG, RCG_UPDATE, 0, 500);
+	bq_wr(bq.gcc, RCG, bq_rd(bq.gcc, RCG) & ~RCG_ROOT_EN);
+	if (!ok) {
+		return BQ_STOP("s6 RCG update not taken (cmd %#x cfg %#x)", bq_rd(bq.gcc, RCG), bq_rd(bq.gcc, RCG_CFG));
+	}
+	return true;
+}
+
+/* ------------------------------------------------------------------------ UART (SE6) */
+
+static void
+bq_rx_poll(void)
+{
+	uint32_t st = bq_rd(bq.se, SE_GENI_RX_FIFO_STATUS), wc = st & RX_WC;
+	uint32_t s = bq_rd(bq.se, SE_GENI_S_IRQ_STATUS);
+
+	bq.s_seen |= s;
+	/* qcom_geni_serial_handle_rx_fifo(): the last word holds RX_LAST_BYTE_VALID bytes */
+	for (uint32_t i = 0; i < wc && i < bq.rx_depth; i++) {
+		uint32_t w = bq_rd(bq.se, SE_GENI_RX_FIFOn), k = 4;
+		if (i + 1 == wc && (st & RX_LAST) && ((st >> 28) & 7u)) {
+			k = (st >> 28) & 7u;
+		}
+		for (uint32_t j = 0; j < k && j < 4; j++) {
+			if (bq.rx_have < sizeof(bq.rx)) {
+				bq.rx[bq.rx_have++] = (uint8_t)(w >> (8 * j));
+			} else {
+				bq.rx_drop++;
+			}
+		}
+	}
+	bq_wr(bq.se, SE_GENI_S_IRQ_CLEAR, s);
+	bq_wr(bq.se, SE_GENI_M_IRQ_CLEAR, bq_rd(bq.se, SE_GENI_M_IRQ_STATUS) & (M_RX_WM | M_RX_LAST));
+}
+
+/* qcom_geni_serial_start_rx_fifo() */
+static void
+bq_rx_start(void)
+{
+	bq_wr(bq.se, SE_GENI_S_CMD0, UART_START << 27);
+	bq_wr(bq.se, SE_GENI_S_IRQ_EN, bq_rd(bq.se, SE_GENI_S_IRQ_EN) | S_RX_WM | S_RX_LAST);
+	bq_wr(bq.se, SE_GENI_M_IRQ_EN, bq_rd(bq.se, SE_GENI_M_IRQ_EN) | M_RX_WM | M_RX_LAST);
+}
+
+/* qcom_geni_serial_stop_rx_fifo() + abort_rx(); what is still in the FIFO is dropped */
+static void
+bq_rx_stop(void)
+{
+	bq_wr(bq.se, SE_GENI_S_IRQ_EN, bq_rd(bq.se, SE_GENI_S_IRQ_EN) & ~(S_RX_WM | S_RX_LAST));
+	bq_wr(bq.se, SE_GENI_M_IRQ_EN, bq_rd(bq.se, SE_GENI_M_IRQ_EN) & ~(M_RX_WM | M_RX_LAST));
+	if (!(bq_rd(bq.se, SE_GENI_STATUS) & S_CMD_ACTIVE)) {
+		return;
+	}
+	bq_wr(bq.se, SE_GENI_S_CMD_CTRL, CMD_CANCEL);
+	(void)bq_poll(bq.se, SE_GENI_S_IRQ_STATUS, S_CMD_CANCEL, S_CMD_CANCEL, 20000);
+	bq_rx_poll();
+	if (bq_rd(bq.se, SE_GENI_STATUS) & S_CMD_ACTIVE) {
+		bq_wr(bq.se, SE_GENI_S_CMD_CTRL, CMD_ABORT);
+		(void)bq_poll(bq.se, SE_GENI_S_CMD_CTRL, CMD_ABORT, 0, 20000);
+		bq_wr(bq.se, SE_GENI_S_IRQ_CLEAR, S_CMD_DONE | S_CMD_ABORT);
+		bq_wr(bq.se, GENI_FORCE_DEFAULT, 1);
+	}
+}
+
+/* __qcom_geni_serial_cancel_tx_cmd() */
+static void
+bq_tx_cancel(void)
+{
+	bq_wr(bq.se, SE_GENI_M_CMD_CTRL, CMD_CANCEL);
+	if (!bq_poll(bq.se, SE_GENI_M_IRQ_STATUS, M_CMD_CANCEL, M_CMD_CANCEL, 20000)) {
+		bq_wr(bq.se, SE_GENI_M_CMD_CTRL, CMD_ABORT);
+		(void)bq_poll(bq.se, SE_GENI_M_IRQ_STATUS, M_CMD_ABORT, M_CMD_ABORT, 20000);
+		bq_wr(bq.se, SE_GENI_M_IRQ_CLEAR, M_CMD_ABORT);
+	}
+	bq_wr(bq.se, SE_GENI_M_IRQ_CLEAR, M_CMD_CANCEL);
+}
+
+/*
+ * hci_uart_set_flow_control(hu, !on) on serdev: flow control and RTS together. Off = CTS ignored
+ * (UART_CTS_MASK) and RFR held not ready; on = CTS honoured, RFR by the RX FIFO watermark.
+ */
+static void
+bq_flow(bool on)
+{
+	uint32_t tx = bq_rd(bq.se, SE_UART_TX_TRANS_CFG);
+
+	bq_wr(bq.se, SE_UART_TX_TRANS_CFG, on ? tx & ~UART_CTS_MASK : tx | UART_CTS_MASK);
+	bq_wr(bq.se, SE_UART_MANUAL_RFR, on ? 0 : UART_MANUAL_RFR_EN | UART_RFR_NOT_READY);
+}
+
+/* the clock half of qcom_geni_serial_set_termios() */
+static bool
+bq_baud(uint32_t baud)
+{
+	uint32_t rate = 0, div = 0;
+	int level;
+
+	if (!bq_clk_pick(baud, &rate, &div, &level)) {
+		return BQ_STOP("no %s gives %u baud x %u", bq.dfs ? "DFS level" : "s6 clock", baud, bq.sampling);
+	}
+	if (bq.dfs) {
+		bq_wr(bq.se, SE_GENI_CLK_SEL, (uint32_t)level);
+	} else if (rate != bq.rate && !bq_rcg_set(&bq_ftbl[level])) {
+		return false;
+	}
+	bq.rate = rate;
+	bq.baud = baud;
+	bq_wr(bq.se, GENI_SER_M_CLK_CFG, 1u | div << 4);        /* SER_CLK_EN | clk_div << CLK_DIV_SHFT */
+	bq_wr(bq.se, GENI_SER_S_CLK_CFG, 1u | div << 4);
+	printf("SWEET BTQ: stage %u: uart %u baud = %u Hz / %u / %u%s\n", bq.stage, baud, rate, div,
+	    bq.sampling, bq.dfs ? " (DFS level)" : "");
+	return true;
+}
+
+/* serdev_device_write_buf + wait_until_sent: one UART_START_TX command for n bytes */
+static bool
+bq_tx(const uint8_t *p, uint32_t n)
+{
+	uint32_t i = 0, us = 0, irq;
+	uint32_t limit = 20000u + (uint32_t)((uint64_t)n * 20000000u / bq.baud);     /* 20 ms + 2x wire time */
+
+	if (bq_rd(bq.se, SE_GENI_STATUS) & M_CMD_ACTIVE) {
+		return BQ_STOP("TX engine busy before a write (status %#x)", bq_rd(bq.se, SE_GENI_STATUS));
+	}
+	bq_wr(bq.se, SE_GENI_M_IRQ_CLEAR, M_CMD_DONE | M_ERRORS);
+	bq_wr(bq.se, SE_UART_TX_TRANS_LEN, n);
+	bq_wr(bq.se, SE_GENI_M_CMD0, UART_START << 27);
+	while (i < n || !(bq_rd(bq.se, SE_GENI_M_IRQ_STATUS) & M_CMD_DONE)) {
+		if (i < n && (bq_rd(bq.se, SE_GENI_TX_FIFO_STATUS) & 0x0fffffffu) < bq.tx_depth) {
+			uint32_t w = 0;
+			for (unsigned k = 0; k < 4 && i < n; k++, i++) {
+				w |= (uint32_t)p[i] << (8 * k);
+			}
+			bq_wr(bq.se, SE_GENI_TX_FIFOn, w);
+			continue;
+		}
+		bq_rx_poll();
+		if (us >= limit) {
+			irq = bq_rd(bq.se, SE_GENI_M_IRQ_STATUS);
+			bq_tx_cancel();
+			return BQ_STOP("TX of %u bytes not done in %u us (%u in FIFO, m_irq %#x, CTS %s)", n, us, i,
+			           irq, (bq_rd(bq.se, SE_GENI_IOS) & IO2_DATA_IN) ? "deasserted" : "asserted");
+		}
+		delay(10);
+		us += 10;
+	}
+	irq = bq_rd(bq.se, SE_GENI_M_IRQ_STATUS);
+	bq_wr(bq.se, SE_GENI_M_IRQ_CLEAR, irq & (M_CMD_DONE | M_ERRORS));
+	if (irq & M_ERRORS) {
+		return BQ_STOP("TX error m_irq %#x", irq);
+	}
+	return true;
+}
+
+static bool
+bq_cmd(uint16_t op, const uint8_t *par, uint8_t plen)
+{
+	uint8_t pkt[4 + 255] = { 0x01, (uint8_t)op, (uint8_t)(op >> 8), plen };
+
+	memcpy(pkt + 4, par, plen);
+	return bq_tx(pkt, 4u + plen);
+}
+
+static void
+bq_consume(uint32_t n)
+{
+	memmove(bq.rx, bq.rx + n, bq.rx_have - n);
+	bq.rx_have -= n;
+}
+
+/*
+ * One complete H4 event from bq.rx[] into ev (code, length, parameters), or 0. In-band sleep
+ * bytes (hci_qca.c HCI_IBS_WAKE_ACK 0xfc, WAKE_IND 0xfd, SLEEP_IND 0xfe) and stray bytes are
+ * counted and dropped, as qca_recv does while QCA_IBS_DISABLED.
+ */
+static uint32_t
+bq_take_event(uint8_t *ev)
+{
+	while (bq.rx_have > 0 && bq.rx[0] != 0x04) {
+		if (bq.rx[0] >= 0xfc && bq.rx[0] <= 0xfe) {
+			bq.ibs[bq.rx[0] - 0xfc]++;
+		} else {
+			bq.stray++;
+		}
+		bq_consume(1);
+	}
+	if (bq.rx_have < 3 || bq.rx_have < 3u + bq.rx[2]) {
+		return 0;
+	}
+	uint32_t n = 2u + bq.rx[2];
+	memcpy(ev, bq.rx + 1, n);
+	bq_consume(n + 1);
+	return n;
+}
+
+static void
+bq_log_event(const char *what, const uint8_t *ev, uint32_t n)
+{
+	char s[2 * 16 + 1];
+	static const char hex[] = "0123456789abcdef";
+	uint32_t k = MIN(n, 16u);
+
+	for (uint32_t i = 0; i < k; i++) {
+		s[2 * i] = hex[ev[i] >> 4];
+		s[2 * i + 1] = hex[ev[i] & 15];
+	}
+	s[2 * k] = '\0';
+	printf("SWEET BTQ: stage %u: %s event %s%s (%u bytes)\n", bq.stage, what, s, n > k ? "..." : "", n);
+}
+
+/*
+ * Events until the one asked for: Command Complete (0x0e) for op, or a vendor event (0xff) with
+ * EDL header cresp 0 and rtype (btqca.c), or any vendor event (ANY_VENDOR_EVENT). Others are
+ * logged and dropped; a failed Command Status for op, a lost RX byte, a parity error or a
+ * timeout end the wait with 0.
+ */
+static uint32_t
+bq_wait(uint8_t code, uint16_t op, int rtype, uint8_t *ev, unsigned ms)
+{
+	for (unsigned us = 0;; us += 10) {
+		uint32_t n;
+
+		bq_rx_poll();
+		while ((n = bq_take_event(ev)) > 0) {
+			if (code == 0x0e && ev[0] == 0x0e && n >= 6 && bq_le16(ev + 3) == op) {
+				return n;
+			}
+			if (code == 0xff && ev[0] == 0xff &&
+			    (rtype == ANY_VENDOR_EVENT || (n >= 4 && ev[2] == 0 && ev[3] == rtype))) {
+				return n;
+			}
+			if (ev[0] == 0x0f && n >= 6 && bq_le16(ev + 4) == op && ev[2] != 0) {
+				bq_log_event("failed Command Status", ev, n);
+				return 0;
+			}
+			bq_log_event("ignored", ev, n);
+		}
+		if (bq.rx_drop || (bq.s_seen & (S_RX_OVERFLOW | S_PARITY))) {
+			printf("SWEET BTQ: stage %u: RX lost bytes (dropped %u, s_irq %#x)\n", bq.stage, bq.rx_drop, bq.s_seen);
+			return 0;
+		}
+		if (us >= ms * 1000u) {
+			printf("SWEET BTQ: stage %u: no event %#x for %#x within %u ms (%u bytes pending, ibs %u/%u/%u, "
+			    "stray %u, CTS %s)\n", bq.stage, code, op, ms, bq.rx_have, bq.ibs[0], bq.ibs[1], bq.ibs[2],
+			    bq.stray, (bq_rd(bq.se, SE_GENI_IOS) & IO2_DATA_IN) ? "deasserted" : "asserted");
+			return 0;
+		}
+		delay(10);
+	}
+}
+
+/* qca_port_reopen(): serdev close + open, i.e. stop RX, drop what came in, start RX, flow on */
+static void
+bq_reopen(void)
+{
+	bq_rx_stop();
+	bq.rx_have = 0;
+	bq.s_seen = 0;
+	bq.stray = 0;
+	bq_rx_start();
+	bq_flow(true);
+}
+
+/* qca_send_power_pulse(): one byte with flow control off, then the controller's settle time */
+static bool
+bq_pulse(uint8_t b)
+{
+	bq_flow(false);
+	if (!bq_tx(&b, 1)) {
+		return false;
+	}
+	delay(20000000u / bq.baud);     /* two character times: the byte has left the shifter */
+	bq_flow(true);
+	bq_sleep(b == 0xfc ? 100 : 10); /* msleep(100) on, usleep_range(1000, 10000) off */
+	return true;
+}
+
+/* -------------------------------------------------------------------------- stage 1 */
+
+static void
+bq_pin_log(unsigned pin)
+{
+	uint32_t cfg = bq_rd(bq.tlmm, TLMM_CFG(pin));
+
+	printf("SWEET BTQ: stage 1: gpio%u cfg %#x (func %u, pull %u, %u mA, oe %u) in %u\n", pin, cfg,
+	    (cfg >> 2) & 0xfu, cfg & 3u, 2u * (((cfg >> 6) & 7u) + 1u), (cfg >> 9) & 1u,
+	    bq_rd(bq.tlmm, TLMM_IO(pin)) & 1u);
+}
+
+static bool
+bq_clocks_running(void)
+{
+	return !(bq_rd(bq.gcc, GCC_M_AHB_CBCR) & CBCR_OFF) && !(bq_rd(bq.gcc, GCC_S_AHB_CBCR) & CBCR_OFF) &&
+	       !(bq_rd(bq.gcc, GCC_S6_CBCR) & CBCR_OFF);
+}
+
+/* The SE's identity; stage 1 calls it only with the clocks already running. */
+static bool
+bq_se_identity(void)
+{
+	uint32_t fw = bq_rd(bq.se, GENI_FW_REVISION_RO), hw0 = bq_rd(bq.se, SE_HW_PARAM_0);
+	uint32_t hw1 = bq_rd(bq.se, SE_HW_PARAM_1), ios = bq_rd(bq.se, SE_GENI_IOS);
+	uint32_t ver = bq_rd(bq.qup, 4);
+
+	bq.tx_depth = (hw0 >> 16) & 0x3fu;
+	bq.rx_depth = (hw1 >> 16) & 0x3fu;
+	bq.sampling = ver >= 0x20050000u ? 16 : 32;     /* qcom_geni_serial: halved from QUP 2.5 */
+	printf("SWEET BTQ: stage %u: se6 fw %#x (protocol %u) if-disable %#x status %#x ios %#x (CTS %s, RX %u) "
+	    "hw0 %#x hw1 %#x (tx %u x %u bit, rx %u) clk m %#x s %#x sel %#x dma %#x qup %#x (%ux)\n", bq.stage,
+	    fw, (fw >> 8) & 0xffu, bq_rd(bq.se, GENI_IF_DISABLE_RO), bq_rd(bq.se, SE_GENI_STATUS), ios,
+	    (ios & IO2_DATA_IN) ? "deasserted" : "asserted", ios & 1u, hw0, hw1, bq.tx_depth, (hw0 >> 24) & 0x3fu,
+	    bq.rx_depth, bq_rd(bq.se, GENI_SER_M_CLK_CFG), bq_rd(bq.se, GENI_SER_S_CLK_CFG),
+	    bq_rd(bq.se, SE_GENI_CLK_SEL), bq_rd(bq.se, SE_GENI_DMA_MODE_EN), ver, bq.sampling);
+	if (((fw >> 8) & 0xffu) != GENI_SE_UART) {
+		return BQ_STOP("SE6 runs protocol %u, not UART: no UART firmware was loaded into it", (fw >> 8) & 0xffu);
+	}
+	if (bq_rd(bq.se, GENI_IF_DISABLE_RO) & 1u) {
+		return BQ_STOP("SE6 FIFO interface disabled (DMA/GSI only)");
+	}
+	if (((hw0 >> 24) & 0x3fu) != 32 || bq.tx_depth < 4 || bq.rx_depth < 4) {
+		return BQ_STOP("SE6 FIFO geometry not 32-bit x >= 4 words");
+	}
+	return true;
+}
+
+static bool
+bq_probe(void)
+{
+	static const char *const res[] = { "ldoa5", "ldoa7", "ldoa17", "ldoa25", "ldoa23", "rfclka2" };
+	uint32_t vote, cmd, dfsr;
+	uint64_t even, pll;
+	bool ok = true;
+
+	printf("SWEET BTQ: stage 1: mapping gcc %#x tlmm %#x se6 %#x qup0 %#x\n", GCC_PA, TLMM_PA, SE_PA, QUP_PA);
+	bq.gcc = ml_io_map(GCC_PA, 0x60000);
+	bq.tlmm = ml_io_map(TLMM_PA, TLMM_CFG(49));
+	bq.se = ml_io_map(SE_PA, 0x4000);
+	bq.qup = ml_io_map(QUP_PA, 0x1000);
+	if (!bq.gcc || !bq.tlmm || !bq.se || !bq.qup) {
+		return BQ_STOP("MMIO mapping failed");
+	}
+	vote = bq_rd(bq.gcc, GCC_VOTE);
+	printf("SWEET BTQ: stage 1: gcc vote %#x (m_ahb %u s_ahb %u s6 %u) cbcr m_ahb %#x s_ahb %#x s6 %#x\n", vote,
+	    (vote >> 6) & 1u, (vote >> 7) & 1u, (vote >> 16) & 1u, bq_rd(bq.gcc, GCC_M_AHB_CBCR),
+	    bq_rd(bq.gcc, GCC_S_AHB_CBCR), bq_rd(bq.gcc, GCC_S6_CBCR));
+	cmd = bq_rd(bq.gcc, RCG);
+	dfsr = bq_rd(bq.gcc, RCG_DFSR);
+	bq.dfs = dfsr & 1u;
+	printf("SWEET BTQ: stage 1: s6 rcg cmd %#x cfg %#x m %#x n %#x d %#x dfsr %#x (DFS %s)\n", cmd,
+	    bq_rd(bq.gcc, RCG_CFG), bq_rd(bq.gcc, RCG_M), bq_rd(bq.gcc, RCG_N), bq_rd(bq.gcc, RCG_D), dfsr,
+	    bq.dfs ? "on" : "off");
+	pll = bq_gpll0(&even);
+	bq.gpll0_ok = (bq_rd(bq.gcc, GPLL0_MODE) & (1u << 31)) && pll == 600000000ull && even == 300000000ull;
+	printf("SWEET BTQ: stage 1: gpll0 mode %#x l %#x frac %#x user %#x = %llu Hz, out_even %llu Hz (%s)\n",
+	    bq_rd(bq.gcc, GPLL0_MODE), bq_rd(bq.gcc, GPLL0_L), bq_rd(bq.gcc, GPLL0_FRAC), bq_rd(bq.gcc, GPLL0_USER),
+	    (unsigned long long)pll, (unsigned long long)even, bq.gpll0_ok ? "locked, as gcc-sdm845 expects" : "NOT usable");
+	for (unsigned l = 0; bq.dfs && l < 8; l++) {
+		printf("SWEET BTQ: stage 1: dfs level %u cfg %#x m %#x n %#x = %llu Hz\n", l, bq_rd(bq.gcc, RCG_PERF(l)),
+		    bq_rd(bq.gcc, RCG_PERF_M(l)), bq_rd(bq.gcc, RCG_PERF_N(l)), (unsigned long long)bq_dfs_rate(l));
+	}
+	for (unsigned pin = 45; pin <= 48; pin++) {
+		bq_pin_log(pin);
+	}
+	for (unsigned i = 0; i < sizeof(res) / sizeof(res[0]); i++) {
+		uint32_t a = 0;
+		int e = sweet_rpmh_addr(res[i], &a);
+		printf("SWEET BTQ: stage 1: cmd-db %s = %#x (errno %d)\n", res[i], a, e);
+		ok &= e == 0;
+	}
+	if (!ok) {
+		return BQ_STOP("a rail or rfclka2 is missing from cmd-db");
+	}
+	if (!bq.dfs && !bq.gpll0_ok) {
+		return BQ_STOP("no DFS and GPLL0_OUT_EVEN is not 300 MHz: the M/N table does not apply");
+	}
+	if (bq_clocks_running()) {
+		printf("SWEET BTQ: stage 1: reading se6 (its clocks run)\n");
+		if (!bq_se_identity()) {
+			return false;
+		}
+	} else {
+		printf("SWEET BTQ: stage 1: se6 not read: a clock is off (stage 2 votes them first)\n");
+	}
+	printf("SWEET BTQ: stage 1: ok (DFS %s, GPLL0 %s)\n", bq.dfs ? "on" : "off", bq.gpll0_ok ? "ok" : "unproven");
+	return true;
+}
+
+/* -------------------------------------------------------------------------- stage 2 */
+
+/* sdm845.dtsi qup_uart6_4pin: function qup6 (1); cts pull-down, rts/tx 2 mA no bias, rx pull-up */
+static void
+bq_pin(unsigned pin, unsigned pull)
+{
+	uint32_t cfg = bq_rd(bq.tlmm, TLMM_CFG(pin)) & ~0x1ffu;   /* msm_pinmux_set_mux + config: bits 8:0 */
+
+	bq_wr(bq.tlmm, TLMM_CFG(pin), cfg | (1u << 2) | pull);   /* drive 0 = 2 mA (default for cts/rx) */
+}
+
+/* qcom_geni_serial_port_setup() + geni_se_init(se, UART_RX_WM, depth - 2) + FIFO mode */
+static bool
+bq_se_setup(void)
+{
+	uint32_t st = bq_rd(bq.se, SE_GENI_STATUS);
+
+	if (st & M_CMD_ACTIVE) {
+		return BQ_STOP("SE6 TX engine already active (status %#x): someone else owns it", st);
+	}
+	bq_rx_stop();
+	bq_wr(bq.se, SE_UART_RX_STALE_CNT, 10u * 16u);  /* DEFAULT_BITS_PER_CHAR * STALE_TIMEOUT */
+	bq_wr(bq.se, SE_GENI_TX_PACKING_CFG0, PACK0);
+	bq_wr(bq.se, SE_GENI_TX_PACKING_CFG1, PACK1);
+	bq_wr(bq.se, SE_GENI_RX_PACKING_CFG0, PACK0);
+	bq_wr(bq.se, SE_GENI_RX_PACKING_CFG1, PACK1);
+	bq_wr(bq.se, SE_GENI_BYTE_GRAN, 0);
+	/* geni_se_irq_clear(); SE_IRQ_EN stays 0 (Linux: all on): no GIC line, status is polled */
+	bq_wr(bq.se, SE_GSI_EVENT_EN, 0);
+	bq_wr(bq.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	bq_wr(bq.se, SE_GENI_S_IRQ_CLEAR, 0xffffffffu);
+	bq_wr(bq.se, SE_DMA_TX_IRQ_CLR, 0xffffffffu);
+	bq_wr(bq.se, SE_DMA_RX_IRQ_CLR, 0xffffffffu);
+	bq_wr(bq.se, SE_IRQ_EN, 0);
+	/* geni_se_io_init(), geni_se_io_set_mode() */
+	bq_wr(bq.se, GENI_CGC_CTRL, bq_rd(bq.se, GENI_CGC_CTRL) | 0x7fu);
+	bq_wr(bq.se, SE_DMA_GENERAL_CFG, bq_rd(bq.se, SE_DMA_GENERAL_CFG) | 0xfu);
+	bq_wr(bq.se, GENI_OUTPUT_CTRL, 0x7fu);
+	bq_wr(bq.se, GENI_FORCE_DEFAULT, 1);
+	bq_wr(bq.se, SE_GENI_DMA_MODE_EN, bq_rd(bq.se, SE_GENI_DMA_MODE_EN) & ~1u);
+	bq_wr(bq.se, SE_GENI_RX_WATERMARK, 2);
+	bq_wr(bq.se, SE_GENI_RX_RFR_WATERMARK, bq.rx_depth - 2);
+	bq_wr(bq.se, SE_GENI_M_IRQ_EN, bq_rd(bq.se, SE_GENI_M_IRQ_EN) | M_COMMON | M_CMD_DONE);
+	bq_wr(bq.se, SE_GENI_S_IRQ_EN, bq_rd(bq.se, SE_GENI_S_IRQ_EN) | S_COMMON);
+	bq_wr(bq.se, SE_GENI_TX_WATERMARK, 0);
+	/* qcom_geni_serial_set_termios(): 8N1, CRTSCTS, no loopback */
+	bq_wr(bq.se, SE_UART_LOOPBACK_CFG, 0);
+	bq_wr(bq.se, SE_UART_TX_TRANS_CFG, bq_rd(bq.se, SE_UART_TX_TRANS_CFG) & ~(1u | UART_CTS_MASK));
+	bq_wr(bq.se, SE_UART_TX_PARITY_CFG, bq_rd(bq.se, SE_UART_TX_PARITY_CFG) & ~1u);
+	bq_wr(bq.se, SE_UART_RX_TRANS_CFG, bq_rd(bq.se, SE_UART_RX_TRANS_CFG) & ~(1u << 3));
+	bq_wr(bq.se, SE_UART_RX_PARITY_CFG, bq_rd(bq.se, SE_UART_RX_PARITY_CFG) & ~1u);
+	bq_wr(bq.se, SE_UART_TX_WORD_LEN, 8);
+	bq_wr(bq.se, SE_UART_RX_WORD_LEN, 8);
+	bq_wr(bq.se, SE_UART_TX_STOP_BIT_LEN, 0);
+	bq_wr(bq.se, SE_UART_MANUAL_RFR, 0);
+	bq.se_up = true;
+	if (bq_rd(bq.se, SE_GENI_TX_PACKING_CFG0) != PACK0 || bq_rd(bq.se, SE_GENI_RX_PACKING_CFG1) != PACK1) {
+		return BQ_STOP("SE6 packing readback %#x/%#x", bq_rd(bq.se, SE_GENI_TX_PACKING_CFG0),
+		           bq_rd(bq.se, SE_GENI_RX_PACKING_CFG1));
+	}
+	return bq_baud(115200);
+}
+
+static bool
+bq_power(void)
+{
+	int e;
+
+	printf("SWEET BTQ: stage 2: gpio45-48 -> qup6 (cts pull-down, rts/tx no bias, rx pull-up, 2 mA)\n");
+	bq_pin(45, 1);
+	bq_pin(46, 0);
+	bq_pin(47, 0);
+	bq_pin(48, 3);
+	for (unsigned pin = 45; pin <= 48; pin++) {
+		bq_pin_log(pin);
+	}
+	/*
+	 * ponytail: read-modify-write of the shared vote register without touch's lock (0277 keeps
+	 * sweet_gcc_lock static in sweet_touch.c); one write per boot, 10 s after touch's. Exporting
+	 * its gcc_vote() and calling it here closes the window.
+	 */
+	bq_wr(bq.gcc, GCC_VOTE, bq_rd(bq.gcc, GCC_VOTE) | GCC_VOTE_BITS);
+	if (!bq_poll(bq.gcc, GCC_M_AHB_CBCR, CBCR_OFF, 0, 1000) || !bq_poll(bq.gcc, GCC_S_AHB_CBCR, CBCR_OFF, 0, 1000) ||
+	    !bq_poll(bq.gcc, GCC_S6_CBCR, CBCR_OFF, 0, 1000)) {
+		return BQ_STOP("a branch stays halted: cbcr m_ahb %#x s_ahb %#x s6 %#x (vote %#x)",
+		           bq_rd(bq.gcc, GCC_M_AHB_CBCR), bq_rd(bq.gcc, GCC_S_AHB_CBCR), bq_rd(bq.gcc, GCC_S6_CBCR),
+		           bq_rd(bq.gcc, GCC_VOTE));
+	}
+	printf("SWEET BTQ: stage 2: clocks voted (vote %#x)\n", bq_rd(bq.gcc, GCC_VOTE));
+	if (!bq_se_identity() || !bq_se_setup()) {
+		return false;
+	}
+	/* qca_regulator_init(): port closed while the regulators come up */
+	printf("SWEET BTQ: stage 2: vddio = vreg_s4a_1p8 (always on, nothing sent)\n");
+	/* ldoa5 800, ldoa7 1800, ldoa17 1304, ldoa25 3300, ldoa23 3300 mV HPM, then rfclka2 */
+	e = EBUSY;
+	for (unsigned i = 0; i < 20 && e == EBUSY; i++) {
+		if ((e = sweet_rpmh_wlan_power()) == EBUSY) {
+			bq_sleep(50);   /* touch or the modem holds the RPMh helper */
+		}
+	}
+	printf("SWEET BTQ: stage 2: WCN3990 rails + rfclka2 (sweet_rpmh_wlan_power) -> %d\n", e);
+	if (e) {
+		return BQ_STOP("rail/rfclka2 vote failed (%d); see the SWEET RPMH lines", e);
+	}
+	bq_rx_start();
+	bq_flow(true);
+	/* force the wcn399x into boot mode: power-off pulse at 2400, power-on pulse at 115200 */
+	if (!bq_baud(2400) || !bq_pulse(0xc0) || !bq_baud(115200) || !bq_pulse(0xfc)) {
+		return false;
+	}
+	bq_reopen();
+	printf("SWEET BTQ: stage 2: pulses 0xc0 @2400, 0xfc @115200 sent; ios %#x (CTS %s)\n",
+	    bq_rd(bq.se, SE_GENI_IOS), (bq_rd(bq.se, SE_GENI_IOS) & IO2_DATA_IN) ? "deasserted" : "asserted");
+	return true;
+}
+
+/* qca_read_soc_version() for WCN3990 (< WCN3991): the answer is a VSE of 2 + 12 bytes */
+static bool
+bq_version(void)
+{
+	uint8_t c = EDL_PATCH_VER_REQ_CMD, ev[2 + 255];
+	uint32_t n;
+
+	if (!bq_cmd(EDL_PATCH_OP, &c, 1)) {
+		return false;
+	}
+	n = bq_wait(0xff, EDL_PATCH_OP, EDL_APP_VER_RES_EVT, ev, 2000);
+	if (n == 0 || ev[1] != 14) {
+		return BQ_STOP("no version VSE (got %u bytes, length %u)", n, n ? ev[1] : 0);
+	}
+	uint32_t product = bq_le32(ev + 4), soc = bq_le32(ev + 12);
+	uint16_t patch = bq_le16(ev + 8), rom = bq_le16(ev + 10);
+	uint32_t soc_ver = soc << 16 | rom;
+	bq.rom = (uint8_t)(((soc_ver & 0xf00u) >> 4) | (soc_ver & 0xfu));
+	printf("SWEET BTQ: stage 2: QCA product %#010x SoC %#010x ROM %#06x patch %#06x: controller version %#010x, "
+	    "firmware crbtfw%02x.tlv / crnv%02x.bin\n", product, soc, rom, patch, soc_ver, bq.rom, bq.rom);
+	if (soc == 0 || rom == 0) {
+		return BQ_STOP("SoC or ROM version 0 (btqca.c: -EILSEQ)");
+	}
+	return true;
+}
+
+/* -------------------------------------------------------------------------- stage 3 */
+
+/*
+ * btqca.c qca_tlv_check_data(), TLV_TYPE_NVM for a WCN3990: skip an enclosing type-4 header, walk
+ * the first type-2 tag set; HCI tag 17: in-band sleep bit (data[0] |= 0x80) and UART baud
+ * (data[2]); deep-sleep tag 27: data[0] |= 1. Returns the bytes changed, -1 if malformed. The BD
+ * address tag (2) is only length-checked and never printed.
+ */
+static int
+bq_nvm_patch(uint8_t *d, uint32_t size, uint8_t baud)
+{
+	uint32_t off = 0, tl, len;
+	int changed = 0;
+
+	if (size < 4) {
+		return -1;
+	}
+	tl = bq_le32(d);
+	if ((tl & 0xffu) == 4) {
+		if (size < 8) {
+			return -1;
+		}
+		off = 4;
+		tl = bq_le32(d + 4);
+	}
+	if ((tl & 0xffu) != 2) {
+		return 0;               /* Linux sends other types unparsed */
+	}
+	len = tl >> 8;
+	if (len < 12 || size < off + 4 + len) {
+		return -1;
+	}
+	uint8_t *t = d + off + 4;
+	for (uint32_t i = 0; i < len - 12;) {
+		uint16_t id = bq_le16(t + i), tlen = bq_le16(t + i + 2);
+		uint8_t *v = t + i + 12;
+		if (len < i + 12 + tlen) {
+			return -1;
+		}
+		if ((id == 2 && tlen != 6) || (id == 17 && tlen < 3) || (id == 27 && tlen < 1)) {
+			return -1;
+		}
+		if (id == 17) {
+			changed += !(v[0] & 0x80) + (v[2] != baud);
+			v[0] |= 0x80;
+			v[2] = baud;
+		} else if (id == 27) {
+			changed += !(v[0] & 1);
+			v[0] |= 1;
+		}
+		i += 12 + tlen;
+	}
+	return changed;
+}
+
+/* TLV_TYPE_PATCH header (struct tlv_type_patch after the type word): download_mode, or -1 */
+static int
+bq_patch_mode(const uint8_t *d, uint32_t size)
+{
+	if (size < 4 + 24 || (bq_le32(d) & 0xffu) != 1) {
+		return -1;
+	}
+	return d[4 + 10];
+}
+
+/*
+ * qca_download_firmware() / qca_tlv_send_segment(): 243-byte segments as EDL_PATCH_TLV_REQ_CMD
+ * on 0xfc00. With download mode 1 or 3 (QCA_SKIP_EVT_VSE[_CC]) only the last (or a short) segment
+ * waits for its VSE; otherwise every one does. A VSE must report result 0 (Linux only logs it).
+ */
+static bool
+bq_download(const char *name, const uint8_t *d, uint32_t size, int mode)
+{
+	uint8_t seg[2 + MAX_TLV_SEGMENT], ev[2 + 255];
+	uint32_t segs = 0, acks = 0, n;
+
+	for (uint32_t done = 0; done < size; segs++) {
+		uint32_t k = MIN(size - done, MAX_TLV_SEGMENT);
+		bool ack = done + k == size || k < MAX_TLV_SEGMENT || (mode != 1 && mode != 3);
+		seg[0] = EDL_PATCH_TLV_REQ_CMD;
+		seg[1] = (uint8_t)k;
+		memcpy(seg + 2, d + done, k);
+		if (!bq_cmd(EDL_PATCH_OP, seg, (uint8_t)(k + 2))) {
+			return false;
+		}
+		done += k;
+		if (ack) {
+			n = bq_wait(0xff, EDL_PATCH_OP, EDL_TVL_DNLD_RES_EVT, ev, 2000);
+			if (n != 5 || ev[4] != 0) {
+				return BQ_STOP("%s segment %u: no clean VSE (%u bytes, result %#x)", name, segs, n, n == 5 ? ev[4] : 0);
+			}
+			acks++;
+		} else if ((n = bq_take_event(ev)) > 0) {
+			bq_log_event("unexpected", ev, n);
+			return BQ_STOP("%s segment %u: event while none is due", name, segs);
+		}
+	}
+	printf("SWEET BTQ: stage 3: %s: %u segments sent, %u acknowledged (download mode %d)\n", name, segs, acks, mode);
+	return true;
+}
+
+static uint8_t *
+bq_fw_read(const struct bq_fw *f)
+{
+	uint8_t *p = kalloc_data(f->size, Z_WAITOK);
+	int e = EAGAIN;
+
+	for (unsigned i = 0; p && i < 60 && e == EAGAIN; i++) {
+		if ((e = sweet_ufs_read_part(BQ_LUN, BQ_PART, f->off, p, f->size)) == EAGAIN) {
+			bq_sleep(1000); /* UFS not up yet */
+		}
+	}
+	uint32_t crc = p && !e ? crc32(0, p, f->size) : 0;
+	printf("SWEET BTQ: stage 3: %s: %u bytes at %#x of %s (LUN %u): errno %d crc32 %#010x%s\n", f->name, f->size,
+	    f->off, BQ_PART, BQ_LUN, p ? e : ENOMEM, crc, crc == f->crc ? "" : " MISMATCH");
+	if (p && (e || crc != f->crc)) {
+		kfree_data(p, f->size);
+		p = NULL;
+	}
+	return p;
+}
+
+static bool
+bq_firmware(void)
+{
+	uint8_t *tlv = NULL, *nvm = NULL, c = QCA_BAUDRATE_3200000, ev[2 + 255];
+	int mode, changed;
+	bool ok = false;
+
+	if (bq.rom != 0x21) {
+		return BQ_STOP("ROM %#x: only the rom 0x21 files (crbtfw21.tlv, crnv21.bin) are in the table", bq.rom);
+	}
+	tlv = bq_fw_read(&bq_fw[0]);
+	nvm = tlv ? bq_fw_read(&bq_fw[1]) : NULL;
+	if (!tlv || !nvm) {
+		(void)BQ_STOP("firmware not read");
+		goto out;
+	}
+	mode = bq_patch_mode(tlv, bq_fw[0].size);
+	changed = bq_nvm_patch(nvm, bq_fw[1].size, QCA_BAUDRATE_3200000);
+	printf("SWEET BTQ: stage 3: rampatch download mode %d; NVM tags: %d bytes set as btqca.c does\n", mode, changed);
+	if (mode < 0 || changed < 0) {
+		(void)BQ_STOP("malformed TLV (rampatch mode %d, NVM %d)", mode, changed);
+		goto out;
+	}
+	/* qca_set_speed(QCA_OPER_SPEED): flow off, 0xfc48, host baud, flow on, wait for the VSE */
+	bq_flow(false);
+	if (!bq_cmd(QCA_BAUD_OP, &c, 1)) {
+		goto out;
+	}
+	bq_sleep(10);                   /* usleep_range(1000, 10000) */
+	if (!bq_baud(BQ_OPER_BAUD)) {
+		goto out;
+	}
+	bq_rx_poll();                   /* whatever came in at the old rate is noise: a stray 0x04 */
+	bq.rx_have = 0;                 /* would swallow the VSE as the body of a bogus event */
+	bq.s_seen = 0;
+	bq_flow(true);
+	if (bq_wait(0xff, QCA_BAUD_OP, ANY_VENDOR_EVENT, ev, 100) == 0) {
+		(void)BQ_STOP("controller did not confirm 3.2 Mbaud (hci_qca: Failed to change controller baudrate)");
+		goto out;
+	}
+	if (!bq_download(bq_fw[0].name, tlv, bq_fw[0].size, mode)) {
+		goto out;
+	}
+	bq_sleep(10);                   /* "Give the controller some time to get ready to receive the NVM" */
+	if (!bq_download(bq_fw[1].name, nvm, bq_fw[1].size, 0)) {
+		goto out;
+	}
+	if (!bq_cmd(0x0c03, NULL, 0)) {
+		goto out;
+	}
+	uint32_t n = bq_wait(0x0e, 0x0c03, 0, ev, 5000);
+	if (n < 6 || ev[5] != 0) {
+		(void)BQ_STOP("HCI_Reset: %s (status %#x)", n ? "failed" : "no Command Complete", n >= 6 ? ev[5] : 0);
+		goto out;
+	}
+	printf("SWEET BTQ: stage 3: HCI_Reset status 0\n");
+	if (!bq_cmd(0x1001, NULL, 0)) {
+		goto out;
+	}
+	n = bq_wait(0x0e, 0x1001, 0, ev, 2000);
+	if (n < 14 || ev[5] != 0) {
+		(void)BQ_STOP("Read_Local_Version: %u bytes, status %#x", n, n >= 6 ? ev[5] : 0);
+		goto out;
+	}
+	uint16_t manufacturer = bq_le16(ev + 10);
+	printf("SWEET BTQ: stage 3: Read_Local_Version: HCI %u rev %#x, LMP %u subversion %#x, manufacturer %u%s "
+	    "(ibs %u/%u/%u, stray %u)\n", ev[6], bq_le16(ev + 7), ev[9], bq_le16(ev + 12), manufacturer,
+	    manufacturer == 29 ? " (Qualcomm)" : "", bq.ibs[0], bq.ibs[1], bq.ibs[2], bq.stray);
+	ok = manufacturer == 29 || BQ_STOP("manufacturer %u, not 29", manufacturer);
+out:
+	if (tlv) {
+		kfree_data(tlv, bq_fw[0].size);
+	}
+	if (nvm) {
+		kfree_data(nvm, bq_fw[1].size);
+	}
+	return ok;
+}
+
+/* ------------------------------------------------------------------------------- run */
+
+static void
+bq_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	bool ok;
+
+	bq_sleep(BQ_DELAY_S * 1000u);
+	bq.stage = 1;
+	ok = bq_probe();
+	if (ok && bq.want >= 2) {
+		bq.stage = 2;
+		ok = bq_power() && bq_version();
+		if (ok) {
+			printf("SWEET BTQ: stage 2: ok\n");
+		}
+	}
+	if (ok && bq.want >= 3) {
+		bq.stage = 3;
+		ok = bq_firmware();
+		if (ok) {
+			printf("SWEET BTQ: stage 3: ok\n");
+		}
+	}
+	if (bq.se_up) {
+		/* leave the line quiet: no reader from here on, RFR not ready, TX idle */
+		bq_rx_stop();
+		bq_wr(bq.se, SE_UART_MANUAL_RFR, UART_MANUAL_RFR_EN | UART_RFR_NOT_READY);
+	}
+	printf("SWEET BTQ: finished at stage %u of %u (%s); rails and clocks stay voted\n", bq.stage, bq.want,
+	    ok ? "ok" : "stopped");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_btq_init(void)
+{
+	uint32_t rsc = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("btreal", &bq.want, sizeof(bq.want)) || bq.want == 0) {
+		return;
+	}
+	if (!PE_parse_boot_argn("rpmhrsc", &rsc, sizeof(rsc)) || rsc != 0x179e0000u) {
+		printf("SWEET BTQ: btreal=%u needs SDM845 (rpmhrsc=0x179e0000); not started\n", bq.want);
+		return;
+	}
+	if (bq.want > 3) {
+		bq.want = 3;
+	}
+	bq.sampling = 32;
+	bq.baud = 115200;
+	if (kernel_thread_start(bq_thread, NULL, &thread) != KERN_SUCCESS) {
+		printf("SWEET BTQ: kernel_thread_start failed\n");
+		return;
+	}
+	thread_deallocate(thread);
+	printf("SWEET BTQ: btreal=%u: WCN3990 bring-up starts in %u s\n", bq.want, BQ_DELAY_S);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
