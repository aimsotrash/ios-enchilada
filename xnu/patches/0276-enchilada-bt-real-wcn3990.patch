+static uint32_t
+bq_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+bq_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static bool
+bq_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned us)
+{
+	for (unsigned t = 0;; t += 10) {
+		if ((bq_rd(base, off) & mask) == want) {
+			return true;
+		}
+		if (t >= us) {
+			return false;
+		}
+		delay(10);
+	}
+}
+
+static void
+bq_sleep(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&bq_chan, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
