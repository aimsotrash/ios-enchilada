+/* --------------------------------------------------------------------------- clocks */
+
+/* GPLL0 (fabia, fixed): XO * (L + FRAC / 2^16); GPLL0_OUT_EVEN divides by post_div_table_fabia_even. */
+static uint64_t
+bq_gpll0(uint64_t *even)
+{
+	uint32_t l = bq_rd(bq.gcc, GPLL0_L) & 0xffffu, frac = bq_rd(bq.gcc, GPLL0_FRAC) & 0xffffu;
+	uint32_t user = bq_rd(bq.gcc, GPLL0_USER), pd = (user >> 8) & 0xfu;
+	uint64_t pll = XO_HZ * l + ((XO_HZ * frac) >> 16);
+
+	*even = (pd == 0 || pd == 1 || pd == 3 || pd == 7) ? pll / (pd + 1) : 0;
+	return pll;
+}
+
+/* gcc_parent_map_0: 0 = bi_tcxo, 1 = GPLL0, 6 = GPLL0_OUT_EVEN; 0 = unknown or not proven */
+static uint64_t
+bq_parent(unsigned src)
+{
+	uint64_t even, pll = bq_gpll0(&even);
+
+	if (src == 0) {
+		return XO_HZ;
+	}
+	if (!bq.gpll0_ok) {
+		return 0;
+	}
+	return src == 1 ? pll : src == 6 ? even : 0;
+}
+
+/* clk_rcg2_dfs_populate_freq() and calc_rate(): the rate of one DFS performance level */
+static uint64_t
+bq_dfs_rate(unsigned l)
+{
+	uint32_t cfg = bq_rd(bq.gcc, RCG_PERF(l)), hid = cfg & 0x1fu;
+	uint64_t r = bq_parent((cfg >> 8) & 7u);
+
+	if (hid) {
+		r = r * 2 / (hid + 1);
+	}
+	if ((cfg >> 12) & 3u) {
+		uint32_t m = bq_rd(bq.gcc, RCG_PERF_M(l)) & 0xffffu;
+		uint32_t n = ((~bq_rd(bq.gcc, RCG_PERF_N(l))) & 0xffffu) + m;
+		r = n ? r * m / n : 0;
+	}
+	return r;
+}
+
+/*
+ * The source rate and SE divider for a baud: Linux's get_clk_div_rate() picks, for the bauds
+ * used here, the first table rate that is an exact multiple of baud x oversampling (verified for
+ * 2400, 115200, 3200000 at 32x and 16x). With DFS the levels are the table (the SE's CLK_SEL
+ * picks one, as spi-geni-qcom does).
+ */
+static bool
+bq_clk_pick(uint32_t baud, uint32_t *rate, uint32_t *div, int *level)
+{
+	uint64_t want = (uint64_t)baud * bq.sampling;
+
+	*level = -1;
+	for (unsigned i = 0; i < (bq.dfs ? 8u : sizeof(bq_ftbl) / sizeof(bq_ftbl[0])); i++) {
+		uint64_t r = bq.dfs ? bq_dfs_rate(i) : bq_ftbl[i].rate;
+		if (r && r % want == 0 && r / want <= 0xfffu) {
+			*rate = (uint32_t)r;
+			*div = (uint32_t)(r / want);
+			*level = (int)i;
+			return true;
+		}
+	}
+	return false;
+}
