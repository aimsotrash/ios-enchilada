+/*
+ * 0325: SLPI read-only probe (slpi=1), after stage 1 mapped the SMEM header, ptable and global
+ * partition. Reads SMEM and modem_a only: no SCM call, no store, the SLPI region is not touched
+ * (it may be a scanout slot). ponytail: the SLPI boot (plan step 3) should turn ad_stage2/3's
+ * constants into a per-remote table instead of copying them.
+ */
+static const char *
+sl_probe(char *sum, size_t n)
+{
+	uint64_t lo = gPhysBase, hi = (uint64_t)gPhysBase + gPhysSize, min = ~0ull, max = 0;
+	bool in_ram = SL_PA < hi && SL_PA + SL_SIZE > lo, reloc = false;
+	uint32_t phoff = 0, nseg = 0, bytes = 0, meta = 0, size;
+	uint16_t phnum = 0;
+	int slots = 2;
+	struct ad_phdr p;
+
+	(void)PE_parse_boot_argn("sweetzc_slots", &slots, sizeof(slots));
+	printf("SWEET SLPI: region slpi %#011llx-%#011llx %s (kernel RAM %#llx-%#llx); %s\n", SL_PA,
+	    SL_PA + SL_SIZE, in_ram ? "OVERLAPS kernel RAM" : "outside kernel RAM", lo, hi, slots >= 3 ?
+	    "CONFLICT: display scanout slot 3 lives there (sweetzc_slots=3, SweetFramebuffer.cpp SWEET_SLPI_PA)" :
+	    "no scanout slot there (sweetzc_slots < 3)");
+	if (in_ram) {
+		return "region overlaps kernel RAM";
+	}
+	if (!sl_part_off || !sm_map(M_SPART, sl_part_off, sl_part_size, false)) {
+		return "no apps<->slpi partition (hosts 0/3) in the ptable";
+	}
+	uint32_t magic = sm32(sl_part_off), hosts = sm32(sl_part_off + 4);
+	printf("SWEET SLPI: apps-slpi partition +%#x size %#x: magic %#x hosts %#x/%#x free_uncached %#x "
+	    "free_cached %#x\n", sl_part_off, sl_part_size, magic, hosts & 0xffff, hosts >> 16,
+	    sm32(sl_part_off + 12), sm32(sl_part_off + 16));
+	if (magic != 0x54525024u || sm32(sl_part_off + 8) != sl_part_size) {
+		return "partition header invalid";
+	}
+	static const struct { unsigned map; uint16_t id; const char *name; } items[] = {
+		{ M_GLOB, 424, "slpi crash reason" }, { M_SPART, 430, "smp2p apps->slpi" },
+		{ M_SPART, 481, "smp2p slpi->apps" }, { M_SPART, IT_DESC, "glink desc" },
+		{ M_SPART, IT_TX, "glink apps fifo" }, { M_SPART, IT_RX, "glink slpi fifo" },
+	};
+	snprintf(sum, n, "partition 0/3 at +%#x, items", sl_part_off);
+	for (unsigned i = 0; i < sizeof(items) / sizeof(items[0]); i++) {
+		uint32_t off = sm_find(items[i].map, items[i].id, &size);
+		if (size == ~0u) {
+			return "partition list broken";
+		}
+		printf("SWEET SLPI: item %u (%s): %s +%#x, %u bytes\n", items[i].id, items[i].name,
+		    off ? "present" : "absent", off, size);
+		strlcat(sum, off ? " +" : " -", n);
+	}
+	strlcat(sum, " (424 430 481 478 479 480)", n);
+	if (ad_bad) {
+		return "a refused smem read";
+	}
+
+	/* the image: what ad_stage2's check_mdt checks, on slpi_fw[] (stage 2 reloads ad_mdt) */
+	if (!load(&slpi_fw[0], 0, ad_mdt, sizeof(ad_mdt))) {
+		return "slpi.mdt";
+	}
+	memcpy(&phoff, ad_mdt + 28, 4);
+	memcpy(&phnum, ad_mdt + 44, 2);
+	if (memcmp(ad_mdt, "\177ELF\001", 5) != 0 || phoff != 52 || phnum < 2 || phnum > 32 ||
+	    52 + 32u * phnum > slpi_fw[0].size) {
+		return "slpi.mdt: not an ELF32 header with phdrs right after it";
+	}
+	for (unsigned i = 0; i < phnum; i++) {
+		ph(i, &p);
+		if (i == 0 || (p.flags & (7u << 24)) == (2u << 24)) {
+			meta += p.filesz;               /* ELF header + hash segment = the whole mdt */
+		}
+		if (!ph_load(&p)) {
+			continue;
+		}
+		reloc |= !!(p.flags & (1u << 27));
+		min = MIN(min, (uint64_t)p.paddr);
+		max = MAX(max, ((uint64_t)p.paddr + p.memsz + 0xfff) & ~0xfffull);
+		if (p.filesz == 0) {
+			continue;
+		}
+		char name[16];
+		const struct ad_fw *f = NULL;
+		snprintf(name, sizeof(name), "slpi.b%02u", i);
+		for (unsigned k = 1; k < sizeof(slpi_fw) / sizeof(slpi_fw[0]) && !f; k++) {
+			f = strcmp(slpi_fw[k].name, name) == 0 ? &slpi_fw[k] : NULL;
+		}
+		if (f == NULL || f->size != p.filesz || p.filesz > p.memsz) {
+			printf("SWEET SLPI: segment %u (%u bytes): no matching %s in slpi_fw[]\n", i, p.filesz, name);
+			return "a segment is not an slpi.bNN file of the table";
+		}
+		if (!load(f, 0, NULL, 0)) {
+			return f->name;
+		}
+		nseg++;
+		bytes += p.filesz;
+	}
+	printf("SWEET SLPI: image: %u phdrs, metadata %#x, %u segments (%u bytes) crc ok, linked %#llx-%#llx "
+	    "(%#llx bytes)%s, region %#x\n", phnum, meta, nseg, bytes, min, max, max - min,
+	    reloc ? " relocatable" : " NOT relocatable", SL_SIZE);
+	if (meta != slpi_fw[0].size || !reloc || max <= min || max - min > SL_SIZE) {
+		return "image: metadata is not header + hash, not relocatable, or larger than the region";
+	}
+	snprintf(sum + strlen(sum), n - strlen(sum), ", %u segments crc ok, %#llx of %#x", nseg, max - min, SL_SIZE);
+	return slots >= 3 ? "region taken by scanout slot 3 (sweetzc_slots=3)" : NULL;
+}
