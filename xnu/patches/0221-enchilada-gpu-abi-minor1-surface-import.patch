enchilada: GPU: SweetAdreno ABI minor 1, so the GL library imports display surfaces in place

0220 maps cacheable single-plane IOSurfaces for the GPU, but SURFACE_BO was never called
(gl-run-22: "copied, not shared: (the library refused)", every frame still ~72 ms copied out and
~20 ms refilled). The library (Mesa with Bergamota's OSMesa/freedreno patch, reached through
sweetca_gl.c's OSMesaSweetWrapTexture) gives up before asking the kernel: its sampling import
(sweet_hw_wrapped_resource) returns nothing unless INFO.abi_minor >= 1, and this kernel left that
word (our `reserved`) 0. INFO now reports abi_minor 1, and SURFACE_BO dispatches on the input
length: 48 bytes is the minor-0 struct and is answered exactly as before; 112 bytes is the minor-1
struct, which adds flags (in: only IN_SYNC, anything else unsupported; out: CPU_CACHEABLE for a
cacheable surface), tiling and ubwc (always 0: linear, uncompressed) and three plane descriptions
(plane[0] is the whole surface when it has no planes). What is mapped is unchanged from 0220: only
cacheable single-plane IOBufferMemoryDescriptor surfaces in place, client memory and planar ones
still refused (so the read-only and client-memory out bits are never set, and no writable alias:
minor 2 is not offered), and SUBMIT still cleans such a surface, which is what IN_SYNC asks for.
SURFACE_BO is not idempotent here (each call is a new handle; the library does not look for the
"existing" bit). Mesa keeps an imported BO until OSMesaSweetForgetSurface, which this port's
glue never calls, and CoreAnimation makes a new display surface every frame, so one client may
hold at most 256 MB of surfaces in place; past that it is refused once with a log line and the
client copies, as before. glzc0=1 makes INFO report minor 0 again (and SURFACE_BO keeps refusing
cacheable surfaces), so the library is back on the copy path exactly as with 0198.

--- a/iokit/Kernel/arm/SweetAdrenoABI.h
+++ b/iokit/Kernel/arm/SweetAdrenoABI.h
@@ -24,6 +24,7 @@
 /* IOServiceMatching() name of the service; IOServiceOpen(type 0) gives the connection. */
 #define SWEET_GPU_SERVICE_NAME          "SweetAdreno630"
 #define SWEET_GPU_ABI_VERSION           1
+#define SWEET_GPU_ABI_MINOR             1       /* 0221: INFO.abi_minor (0 with glzc0=1) */
 
 /* Selectors of IOConnectCallStructMethod. */
 enum sweet_gpu_selector {
@@ -165,12 +166,18 @@
 	uint64_t va_start;      /* GPU address range the kernel places BOs in */
 	uint64_t va_size;
 	uint32_t last_fence;    /* last submitted sequence number */
-	uint32_t reserved;
+	uint32_t abi_minor;     /* 0221: 1 = SURFACE_BO takes the longer struct below (flags, tiling, planes) */
 };
 
 /* IOSurface memory as a BO: the pages of the surface (pixels from byte 0 of its memory) are entered into the
  * GPU address space. On input handle = SWEET_GPU_DESCRIBE_ONLY asks only for the geometry (no BO is made). */
 #define SWEET_GPU_DESCRIBE_ONLY         0xffffffffu
+struct sweet_gpu_surface_plane {        /* 0221 */
+	uint32_t offset;        /* in the BO */
+	uint32_t stride;        /* bytes a row */
+	uint32_t width;
+	uint32_t height;
+};
 struct sweet_gpu_surface_bo {
 	uint32_t surface_id;    /* in: IOSurfaceGetID() */
 	uint32_t handle;        /* in: DESCRIBE_ONLY or 0; out: BO handle (0 when describing) */
@@ -182,7 +189,21 @@
 	uint32_t height;
 	uint32_t pixel_format;
 	uint32_t planes;
+	/*
+	 * 0221, minor 1. A caller that sends SWEET_GPU_SURFACE_BO_SIZE_MINOR1 bytes gets them all back; one
+	 * that sends SWEET_GPU_SURFACE_BO_SIZE_MINOR0 (the fields above) is answered as before. Client-memory
+	 * surfaces are still refused here, so the read-only (0x1) and client-memory (0x4) out bits never appear.
+	 */
+	uint32_t flags;         /* in: SWEET_GPU_SBO_IN_SYNC only (others: unsupported); out: SWEET_GPU_SBO_CPU_CACHEABLE */
+	uint32_t tiling;        /* out: 0, linear */
+	uint32_t ubwc;          /* out: 0, not compressed */
+	uint32_t reserved;
+	struct sweet_gpu_surface_plane plane[3];        /* out: the first three; planes == 0: plane[0] is the whole surface */
 };
+#define SWEET_GPU_SURFACE_BO_SIZE_MINOR0 48
+#define SWEET_GPU_SURFACE_BO_SIZE_MINOR1 112
+#define SWEET_GPU_SBO_IN_SYNC           0x1     /* in: CPU writes cleaned before the GPU reads (here: at every SUBMIT anyway) */
+#define SWEET_GPU_SBO_CPU_CACHEABLE     0x2     /* out: CPU mappings are cacheable, BO_SYNC around CPU access */
 
 struct sweet_gpu_bo_sync {
 	uint32_t handle;
