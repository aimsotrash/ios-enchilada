 #define DEPCMD_SETTRANSFRESOURCE 2
 #define DEPCMD_SETSTALL         4
 #define DEPCMD_STARTTRANSFER    6
+#define DEPCMD_ENDTRANSFER      8
 #define DEPCMD_DEPSTARTCFG      9
 #define DEPCMD_CMDACT           (1u << 10)
+#define DEPCMD_FORCERM          (1u << 11)
 
 #define TRB_HWO         (1u << 0)
 #define TRB_LST         (1u << 1)
@@ -341,6 +343,9 @@
 	unsigned    txq_head, txq_count;
 	bool        tx_busy;
 	uint64_t    rx_frames, tx_frames;
+	/* started transfers (cleared on XferComplete) and their resource index */
+	bool        xfer[6];
+	uint8_t     rsc[6];
 } ud;
 
 static inline void
@@ -418,7 +423,22 @@
 		ud_sync(buf, len);
 	}
 	uint64_t tpa = ud.dma_pa + trb;
-	ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+	if (ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0) == 0) {
+		ud.rsc[ep] = (uint8_t)((dwc_rd(DEPCMD(ep)) >> 16) & 0x7f);
+		ud.xfer[ep] = true;
+	}
+}
+
+/* END TRANSFER, forced, no completion event (Linux __dwc3_stop_active_transfer). */
+static void
+ud_end_xfer(unsigned ep)
+{
+	if (!ud.xfer[ep]) {
+		return;
+	}
+	ud_epcmd(ep, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | ((uint32_t)ud.rsc[ep] << 16), 0, 0, 0);
+	ud.xfer[ep] = false;
+	delay(1000);    /* Linux waits 1 ms after an End Transfer without CMDIOC */
 }
 
