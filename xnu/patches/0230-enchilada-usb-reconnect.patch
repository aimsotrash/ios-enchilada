 }
 
+/*
+ * The host dropped the configuration (disconnect, bus reset, a new
+ * SET_CONFIGURATION): like Linux dwc3_stop_active_transfers + f_ecm
+ * ecm_disable. A bus reset does not end the data endpoints' transfers (the
+ * databook leaves that to software); a bulk IN frame the old host never
+ * fetched left tx_busy set forever, and ud_configure() skipped the new
+ * SET_CONFIGURATION, so after a replug nothing was sent or re-armed.
+ * Returns whether it was configured.
+ */
+static bool
+ud_data_stop(void)
+{
+	lck_mtx_lock(ud.lock);
+	bool was = ud.configured;
+	ud.configured = false;
+	ud_end_xfer(EP_RX);
+	ud_end_xfer(EP_TX);
+	ud_end_xfer(EP_INT);
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) & ~((1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT)));
+	ud.tx_busy = false;
+	for (; ud.txq_count > 0; ud.txq_count--) {
+		mbuf_freem(ud.txq[ud.txq_head]);
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+	}
+	lck_mtx_unlock(ud.lock);
+	ud.data_alt = 0;
+	if (was) {
+		ud_link_event(false);
+	}
+	return was;
+}
+
 /* SET_CONFIGURATION(1): bulk IN/OUT and the interrupt endpoint. */
 static void
 ud_configure(void)
