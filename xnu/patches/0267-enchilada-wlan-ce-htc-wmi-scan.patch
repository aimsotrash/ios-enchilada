+extern int sweet_rpmh_wlan_power(void);
+
+static bool
+wlfw_power(void)
+{
+	int err = EBUSY;
+
+	for (unsigned i = 0; i < 50 && err == EBUSY; i++) {
+		if ((err = sweet_rpmh_wlan_power()) == EBUSY) {
+			delay(20000);           /* the touch thread holds the apps RSC */
+		}
+	}
+	printf("SWEET WLFW: WCN3990 power (ldoa5 800, ldoa7 1800, ldoa17 1304, ldoa25/23 3300 mV, rfclka2) -> %s (%d)\n",
+	    err ? "FAILED" : "on", err);
+	return err == 0;
+}
