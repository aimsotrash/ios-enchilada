+/*
+ * 0267: the WCN3990 supplies of mainline sdm845-oneplus-common.dtsi &wifi (v6.12) at their fixed
+ * DT voltages, HPM, enabled, then RPMH_RF_CLK2 ("rfclka2", VRM enable at +4), as ath10k_hw_power_on
+ * does before wlan_enable. ACTIVE votes only; never turned off again: the apps DRV's earlier vote
+ * on a shared rail is unknown (as the cx/mx votes of 0261/0262). SDM845 and these names only.
+ */
+int
+sweet_rpmh_wlan_power(void)
+{
+	static const struct { const char *res; uint32_t mv; } rails[] = {
+		{ "ldoa5", 800 }, { "ldoa7", 1800 }, { "ldoa17", 1304 }, { "ldoa25", 3300 }, { "ldoa23", 3300 },
+	};
+	int error = 0;
+
+	rh_bases();
+	if (rh_rsc_pa != 0x179e0000u || rh_tcs_pa != 0x179e0d00u) {
+		printf("SWEET RPMH: WLAN power is SDM845-only; not sent\n");
+		return ENODEV;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		error = EIO;
+		goto out;
+	}
+	error = rh_map();
+	for (unsigned i = 0; !error && i < sizeof(rails) / sizeof(rails[0]); i++) {
+		uint32_t address = 0;
+		if ((error = rh_lookup(rails[i].res, RH_VRM, &address, NULL, NULL)) == 0) {
+			const uint32_t addr[3] = {address, address + 8, address + 4};
+			const uint32_t values[3] = {rails[i].mv, 7, 1};
+			const uint32_t msgid[3] = {RH_WRITE_ACK, RH_WRITE_ACK, RH_WRITE_ACK};
+			char what[40];
+			snprintf(what, sizeof(what), "%s %u mV mode=7 enable=1", rails[i].res, rails[i].mv);
+			error = rh_send(3, addr, values, msgid, 7, what);
+		}
+	}
+	if (!error) {
+		uint32_t address = 0;
+		if ((error = rh_lookup("rfclka2", RH_VRM, &address, NULL, NULL)) == 0) {
+			const uint32_t addr = address + 4, value = 1, msgid = RH_WRITE_ACK;
+			error = rh_send(1, &addr, &value, &msgid, 1, "rfclka2 enable=1");
+		}
+	}
+	printf("SWEET RPMH: WLAN power votes %s (errno %d)\n", error ? "FAILED" : "complete", error);
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
